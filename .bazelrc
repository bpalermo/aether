# Use prebuilt protoc binary instead of compiling from source
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# aspect_rules_lint >= 2.9.0 depends on @aspect_tools_telemetry, whose repository
# rule curls a usage report to telemetry.aspect.build on the first evaluation
# after the notice is acknowledged. Opt out: the report is an un-hermetic
# outbound request from a repo rule, and it is off for everyone (local and CI)
# rather than per-developer. `-all` is the ruleset's documented set-semantics
# opt-out; DO_NOT_TRACK=1 is equivalent.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# Keep the name of the output directory out of what is built (#1500). Bazel
# builds each configuration under bazel-out/<name>/, and the name is made from
# the flags: a flag added here, a transition a rule gains or a Bazel upgrade
# renames it with no change to any source. rules_go trims the sandbox off every
# path it hands the Go compiler, which leaves a path relative to the execution
# root: `agent/...` for a source file, `external/...` for a dependency, and
# `bazel-out/<name>/bin/...pb.go` for generated source, name and all. The
# compiler records that path in the binary (the table a stack trace is printed
# from), so every binary that links generated protobuf code changed, GNU build
# ID and image digest with it, whenever the directory was renamed.
#
# With `strip`, an action that declares it supports path mapping (rules_go's
# compile actions do, cgo ones excepted, and no released binary uses cgo) is
# run with every bazel-out/<name>/ rewritten to bazel-out/cfg/. A stack trace
# names `bazel-out/cfg/bin/...pb.go`, whichever configuration built it. The same
# rewrite takes the name out of the action's cache key, so the two
# configurations an image index builds share their compiles with a plain
# `bazel build`.
#
# Such an action cannot run unsandboxed: the rewritten paths exist only inside
# a sandbox or on a remote executor, and Bazel refuses the `local` strategy for
# it instead of building something else. `--config=remote` below sends its
# fallback to the sandbox for that reason.
# scripts/check-image-digest-stability.sh is the guard: it builds every image
# under a second directory name and compares the digests.
build --experimental_output_paths=strip
# A tag on a target reaches every action of that target, so a `go_test` tagged
# `no-sandbox` for the sake of its test run (the Envoy harnesses under
# agent/test) has compiles that may not be sandboxed and, being path-mapped,
# cannot run any other way: "requires sandboxing due to path mapping, cannot be
# executed with any of the available strategies". Take the tag back off the Go
# build actions; the test run (TestRunner) keeps it. rules_go leaves path
# mapping off for a target tagged `local` and has no such case for
# `no-sandbox`; with one, these three entries can go.
build --modify_execution_info=Go.*=-no-sandbox,RunNogo=-no-sandbox,ValidateNogo=-no-sandbox

# Configure workspace status script
build --workspace_status_command=./bazel/workspace_status.sh

run --workspace_status_command=./bazel/workspace_status.sh

# Pass HOME for testcontainers config resolution
test --test_env=HOME

# Colima Docker socket config for macOS integration tests.
# Run ./bazel/configure_colima.sh to generate colima.bazelrc with your socket path.
# Auto-enabled on macOS via the :macos platform config below.
try-import %workspace%/colima.bazelrc
test:macos --config=colima

# Lint (usage: --config=lint or: bazel build --config=lint //...)
# Starlark is not linted here: buildifier's linter runs inside `make
# format-check` (bazel/format/BUILD.bazel, #1245).
build:lint --aspects=//bazel/lint:linters.bzl%buf,//bazel/lint:linters.bzl%shellcheck,//bazel/lint:linters.bzl%gocognit

# CI lint (usage: --config=ci — fails build on lint violations)
build:ci --config=lint
build:ci --@aspect_rules_lint//lint:fail_on_violation

build:ci --config=remote
build:ci --build_metadata=ROLE=CI
build:ci --build_metadata=VISIBILITY=PUBLIC
build:ci --color=yes
common:ci --noshow_progress
common:ci --noshow_loading_progress
common:ci --test_output=errors
# A MODULE.bazel.lock that does not match MODULE.bazel fails CI instead of being
# silently rewritten on the runner (#1284): the drift used to go unnoticed, and
# every later local build "fixed" it into an unrelated diff. Bazel names the
# stale entry and the fix: `bazel mod deps --lockfile_mode=update`, then commit
# MODULE.bazel.lock. Local builds keep the default (update) mode.
common:ci --lockfile_mode=error

# BuildBuddy Remote Build Execution (opt-in: --config=remote, pulled in by
# --config=ci). Compile + hermetic test actions run on BuildBuddy's hosted x64
# executor pool (platform + CC toolchain from @buildbuddy_toolchain, see
# MODULE.bazel). aether is pure-Go, so a single x64 pool cross-compiles every
# target. Docker-bound tests stay local (integration tests tagged no-remote-exec,
# e2e tagged local). Pass the org key on the CLI:
#   --remote_header=x-buildbuddy-api-key=YOUR_ORG_API_KEY
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --remote_cache=grpcs://remote.buildbuddy.io
build:remote --bes_backend=grpcs://remote.buildbuddy.io
build:remote --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote --platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:remote --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:remote --extra_toolchains=@buildbuddy_toolchain//:ubuntu_cc_toolchain
build:remote --remote_cache_compression
build:remote --experimental_remote_cache_compression_threshold=100
build:remote --remote_timeout=3600s
build:remote --grpc_keepalive_time=30s
build:remote --jobs=200
# Fetch only top-level outputs locally (build-without-the-bytes) — keeps the
# e2e image_load tars retrievable while skipping intermediate downloads.
build:remote --remote_download_toplevel
# Run actions remotely, but fall back to local execution if the executor is
# unreachable or the key is absent (e.g. fork PRs) so CI degrades gracefully.
build:remote --spawn_strategy=remote,local
build:remote --remote_local_fallback
# The fallback of an action the executor was handed runs in the sandbox, not
# unsandboxed (the default): a path-mapped action (--experimental_output_paths
# above) writes its outputs to paths that exist only there. Measured with an
# unreachable executor: without this line the first Go action fails with "not
# all outputs were created or valid". The flag is marked deprecated upstream
# (bazelbuild/bazel#7480) and still decides this in Bazel 9; if a later Bazel
# drops it, it says so at startup.
build:remote --remote_local_fallback_strategy=sandboxed
# Test EXECUTION stays on the runner: the BuildBuddy executor sandbox runs as
# root with no privileged capabilities, so permission- and netns-sensitive tests
# (CNI netns bind-mounts need CAP_SYS_ADMIN; read-only-dir checks are bypassed by
# root) fail remotely. Compiles still run on the executor; only the test action
# runs local. This also covers the Docker-bound integration/e2e tests.
build:remote --strategy=TestRunner=local
# Base-image layer fetches (rules_img DownloadBlob) need registry egress, which
# the executor sandbox (dockerNetwork=off) lacks — pin them to the runner so
# image builds (incl. publish) work on a cold cache.
build:remote --modify_execution_info=DownloadBlob=+no-remote-exec

# Race detector (usage: --config=race)
test:race --@rules_go//go/config:race

# Coverage report (usage: `make coverage`, i.e. scripts/coverage.sh, which adds
# the two things that cannot be written here because they are derived by query:
# --instrumentation_filter over every first-party component, and the target
# list — the unit go_tests plus every component go_library, whose rules_go
# baseline tracefile is what puts a file no test links into the report at zero).
# docs/runbook.md, "Code coverage".
coverage:coverage --combined_report=lcov
# One failing test must not hide what the others would have reported; the
# invocation still exits non-zero and the script then writes no report.
coverage:coverage --keep_going
coverage:coverage --test_output=errors
# With --config=remote (CI) outputs stay remote unless they are top-level
# (--remote_download_toplevel). The script reads the combined report and every
# test's own tracefile, and a test whose result is a remote cache hit never ran
# on the runner, so both must be fetched explicitly. No effect on a local build.
coverage:coverage --experimental_fetch_all_coverage_outputs
coverage:coverage --remote_download_regex=.*/(coverage\.dat|_coverage_report\.dat|_baseline_report\.dat)$

# LLM-friendly output (usage: --config=llm)
common:llm --color=no
common:llm --curses=no
build:llm --verbose_failures
build:llm --show_result=10
test:llm --test_output=errors
test:llm --test_summary=detailed

# User-specific overrides (gitignored, not checked in)
try-import %workspace%/user.bazelrc
