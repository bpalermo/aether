load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/img:go_multi_arch_image.bzl", "go_multi_arch_image")

go_library(
    name = "udsecho_lib",
    srcs = ["main.go"],
    importpath = "aethermesh.dev/e2e/udsecho",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "udsecho",
    embed = [":udsecho_lib"],
    visibility = ["//visibility:public"],
)

# Test-only image: the UDS-serving workload the proposal 034 e2e harness
# (e2e/uds.sh) deploys. It rides the same multi-arch/distroless macro as the
# shipped binaries so the nightly `build` job can produce it alongside them and
# ship it in the one aether-images artifact; it is never pushed to a registry
# (no release wiring references :image_push).
go_multi_arch_image(
    name = "udsecho_image",
    binary = ":udsecho",
    repository = "bpalermo/aether/udsecho",
)
