load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The collector back-pressure harness, in range of the shellcheck aspect (#853).
# Its own package because a glob in //e2e cannot reach into a subdirectory and
# claim to be complete; see //e2e:e2e_shell.
sh_library(
    name = "pressure_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

# The soak guard of run.sh (#1555): a real run needs the operator's
# acknowledgement, the best-effort refusals fail closed, and the guard neither
# asks for an object by a name this repository does not define nor looks at
# local processes. And every other kubectl and curl call of run.sh (#1578): a
# call that failed is neither an absent object nor a verdict. Hermetic: a fake
# kubectl and a fake curl, the Bazel-pinned jq, no cluster.
sh_test(
    name = "preflight_test",
    size = "small",
    srcs = ["preflight_test.sh"],
    data = [
        "collector-pressure-job.yaml",
        "run.sh",
        "@jq_toolchains//:resolved_toolchain",
    ],
    env = {"JQ_RLOCATIONPATH": "$(rlocationpath @jq_toolchains//:resolved_toolchain)"},
)
