load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_img//img:push.bzl", "image_push")
load("//bazel/img:go_multi_arch_image.bzl", "go_multi_arch_image")
load("//bazel/img:registry.bzl", "image_repository")

go_library(
    name = "l4echo_lib",
    srcs = ["main.go"],
    importpath = "aethermesh.dev/e2e/l4echo",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "l4echo",
    embed = [":l4echo_lib"],
    visibility = ["//visibility:public"],
)

# Test-only image: the L4 backend the proposal 018 Phase 3b e2e harness
# (e2e/l4routes.sh) deploys as the TCPRoute, TLSRoute and UDPRoute parents and
# their backends. Same
# multi-arch/distroless macro as the shipped binaries so the nightly `build` job
# can produce it alongside them and ship it in the one aether-images artifact;
# it is never pushed to a registry (no release wiring references :image_push).
go_multi_arch_image(
    name = "l4echo_image",
    binary = ":l4echo",
    repository = image_repository("l4echo"),
)

# A throwaway push of the same multi-arch index to a destination the CALLER
# names, for the Quay smoke (.github/workflows/quay-smoke.yaml via
# scripts/quay-smoke.sh; proposal 040 phase 2). It proves rules_img push +
# keyless sign + verify on the target registry with an index shaped exactly like
# the released ones (rules_img, amd64 + arm64 children) before any real artifact
# moves there.
#
# The destination is three flags with EMPTY defaults, so nothing here spells a
# registry (scripts/check-registry-config.sh) and the target is `manual`, so
# `bazel build //...` never builds a push for it:
#
#   bazel run //e2e/l4echo:smoke_push \
#     --//e2e/l4echo:smoke_registry=<host> \
#     --//e2e/l4echo:smoke_repository=<org>/smoke \
#     --//e2e/l4echo:smoke_tag=<tag>
#
# Still not a release artifact: no chart, publish step or verifier references it.
# Placeholder defaults, never a real registry: rules_img renders the push
# metadata at BUILD time and rejects an empty registry, and CI's impacted-target
# build (bazel-diff) builds labels explicitly, so `manual` does not keep this
# target out of it. `invalid.` is reserved (RFC 2606) and resolves nowhere; the
# workflow overrides all three flags on `bazel run`.
string_flag(
    name = "smoke_registry",
    build_setting_default = "unset.invalid",
)

string_flag(
    name = "smoke_repository",
    build_setting_default = "unset/smoke",
)

string_flag(
    name = "smoke_tag",
    build_setting_default = "unset",
)

image_push(
    name = "smoke_push",
    build_settings = {
        "registry": ":smoke_registry",
        "repository": ":smoke_repository",
        "tag": ":smoke_tag",
    },
    image = ":image_index",
    registry = "{{.registry}}",
    repository = "{{.repository}}",
    tag = "{{.tag}}",
    tags = ["manual"],
)
