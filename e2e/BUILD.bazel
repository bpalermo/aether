load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The e2e harnesses, in range of the shellcheck aspect (#853). See
# //scripts:scripts_shell for why these targets exist at all.
#
# These are the longest and least-exercised shell in the repository — each one
# stands up two kind clusters and is run by hand, so a latent quoting bug
# surfaces as a red suite at 2am rather than as a compile error. All three
# SC2155/SC2034 findings that #853 had to clear before the gate could be turned
# on were here.
#
# A per-directory target (a subdirectory that gains shell gets its own) rather
# than one recursive target, for two reasons. A glob cannot cross a package
# boundary, so `glob(["**/*.sh"])` here would stop dead at //e2e/udsecho's
# BUILD.bazel and quietly cover less than it appears to; and a per-directory target keeps the
# lint failure label pointing at the directory the script lives in.
sh_library(
    name = "e2e_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

# One Kubernetes for every kind e2e surface (#1251): e2e/kind-version.sh pins
# the kind binary, the node image (with digest) and kubectl; this test fails when
# the //test/e2e kind config, a workflow, a composite action or an e2e harness
# carries a different value or bypasses the pin. Hermetic: it only reads files.
sh_test(
    name = "kind_pin_test",
    size = "small",
    srcs = ["kind_pin_test.sh"],
    data = glob([
        "*.sh",
        "*.yaml",
    ]) + [
        "//:ci_definitions",
        "//test/e2e:testdata/kind-config.yaml",
    ],
)

# One Go for CI (#1283): every workflow job or composite action that runs a bare
# `go` sets it up with actions/setup-go from go.mod, and go.mod names exactly
# MODULE.bazel's go_sdk.download version, so nothing builds with the runner
# image's preinstalled Go. Hermetic: it only reads files.
sh_test(
    name = "go_pin_test",
    size = "small",
    srcs = ["go_pin_test.sh"],
    data = [
        "//:MODULE.bazel",
        "//:ci_definitions",
        "//:go.mod",
    ],
)

# One Helm for CI (#1580): e2e/helm-version.sh pins a Helm 3 and a Helm 4
# release and which of the two is the default; .github/actions/setup-helm is the
# only installer, so no job runs the runner image's Helm or azure/setup-helm's
# `latest`. Also holds the Helm 4 pin to the rules_helm toolchain's helm (the
# one the chart template tests render with), `helm list` to flags both majors
# accept (#1581), and the nightly first-install job to a matrix over both
# majors (#1543). Reads files, and runs the toolchain's helm for `version` and
# `list --help`.
sh_test(
    name = "helm_pin_test",
    size = "small",
    srcs = ["helm_pin_test.sh"],
    args = ["$(rootpath @helm//:helm)"],
    data = glob(["*.sh"]) + [
        "//:ci_definitions",
        "@helm",
    ],
)

# One Gateway API release for every e2e surface (#1583):
# e2e/gateway-api-version.sh, which every harness sources. Fails on a harness
# that assigns its own, on a literal release in a download URL, and when go.mod
# or e2e.yaml's one copy disagrees. Hermetic: it only reads files.
sh_test(
    name = "gateway_api_pin_test",
    size = "small",
    srcs = ["gateway_api_pin_test.sh"],
    data = glob(["*.sh"]) + [
        "//:ci_definitions",
        "//:go.mod",
    ],
)
