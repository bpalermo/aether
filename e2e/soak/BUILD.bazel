load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The soak driver's shell (churn.sh, sample-proxy-rss.sh, restart-watch.sh,
# lib-wait.sh, prober-grade.sh, harness_test.sh, and newsa-client.sh -- POSIX
# sh, run by busybox inside the new-SA step's pod), in range of the shellcheck
# aspect (#853). Its own package
# for the same reason as //e2e/pressure; see //e2e:e2e_shell.
#
# k6-mesh-soak.js is JavaScript and no linter here covers it.
sh_library(
    name = "soak_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

# The harness's offline parsing tests (#1265): restart-watch.sh against canned
# `kubectl get pods -o json` through a fake kubectl, udscsi-window.awk against
# canned watch lines, and the sortie load driver's offline half (proposal 042,
# #1323): sortie-gate.sh against canned and real (kind) sortie JSON reports and
# a results stream, sortie-save.sh against a fake kubectl, sortie-plan.sh's
# share arithmetic and plan template, the pins and the PriorityClass in
# sortie-values.yaml and run.sh (read, not run), pods-not-ready.awk against canned
# `kubectl get pods` listings. No cluster, no network. It used to be run by hand only,
# for want of jq; jq is now the Bazel-pinned one (jq.bzl), so it runs in
# `bazel test //...` like any other test. awk and coreutils come from the host,
# as for every sh_test in this repository.
#
# It also runs four of the scripts for real, against fakes: restart-watch.sh, once
# per command it executes up to its first wait, with a TERM before that command
# (#1386: about 150 short runs); churn.sh, the whole schedule on a clock of its
# own, and then once per command with a TERM before it and once per kubectl
# call with a TERM during it (#1419: about 500 short runs, several at a time);
# sample-proxy-rss.sh, a TERM during each of its calls; and run.sh up to a Job
# that has already ended (#1387). Those need setsid, timeout, ps and nproc from
# the host. The stop sweeps are most of this test's time (about a minute on
# eight cores, three CPU-minutes), hence the timeout. prober-grade.sh (#1390)
# runs against canned Prometheus query responses.
sh_test(
    name = "harness_test",
    size = "small",
    timeout = "long",
    srcs = ["harness_test.sh"],
    data = [
        "churn.sh",
        "lib-wait.sh",
        "newsa-client.sh",
        "pods-not-ready.awk",
        "prober-grade.sh",
        "restart-watch.sh",
        "run.sh",
        "sample-proxy-rss.sh",
        "sortie-gate.sh",
        "sortie-plan.sh",
        "sortie-save.sh",
        "sortie-targets.txt",
        "sortie-values.yaml",
        "udscsi-window.awk",
        "@jq_toolchains//:resolved_toolchain",
    ] + glob(["testdata/**"]),
    env = {"JQ_RLOCATIONPATH": "$(rlocationpath @jq_toolchains//:resolved_toolchain)"},
)
