load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The soak driver's shell (churn.sh, sample-proxy-rss.sh, restart-watch.sh,
# harness_test.sh, and newsa-client.sh -- POSIX sh, run by busybox inside the
# new-SA step's pod), in range of the shellcheck aspect (#853). Its own package
# for the same reason as //e2e/pressure; see //e2e:e2e_shell.
#
# k6-mesh-soak.js is JavaScript and no linter here covers it.
sh_library(
    name = "soak_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

# The harness's offline parsing tests (#1265): restart-watch.sh against canned
# `kubectl get pods -o json` through a fake kubectl, udscsi-window.awk against
# canned watch lines, and the sortie load driver's offline half (proposal 042,
# #1323): sortie-gate.sh against canned and real (kind) sortie JSON reports and
# a results stream, sortie-save.sh's offline `--times`, sortie-plan.sh's
# share arithmetic and plan template, the pins and the PriorityClass in
# sortie-values.yaml and run.sh (read, not run), pods-not-ready.awk against canned
# `kubectl get pods` listings. No cluster, no network. It used to be run by hand only,
# for want of jq; jq is now the Bazel-pinned one (jq.bzl), so it runs in
# `bazel test //...` like any other test. awk and coreutils come from the host,
# as for every sh_test in this repository.
sh_test(
    name = "harness_test",
    size = "small",
    srcs = ["harness_test.sh"],
    data = [
        "pods-not-ready.awk",
        "restart-watch.sh",
        "run.sh",
        "sortie-gate.sh",
        "sortie-plan.sh",
        "sortie-save.sh",
        "sortie-targets.txt",
        "sortie-values.yaml",
        "udscsi-window.awk",
        "@jq_toolchains//:resolved_toolchain",
    ] + glob(["testdata/**"]),
    env = {"JQ_RLOCATIONPATH": "$(rlocationpath @jq_toolchains//:resolved_toolchain)"},
)
