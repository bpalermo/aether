load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")
load("//bazel/promtool:defs.bzl", "promtool_rules_test")

# README.md is an input to //website:site — the architecture page is generated
# from it at build time so the site can never carry a stale copy.
exports_files([
    ".shellcheckrc",
    "README.md",
])

# Every repository document aethermesh.dev renders. website/hooks.py reads these
# at build time and stages them as generated pages; the site holds no copy of any
# of them, so this filegroup is what makes the staged pages an actual dependency
# of //website:site and //website:site_test rather than an ambient read.
#
# proxy/README.md is absent on purpose: //.bazelignore hides `proxy` (a sibling
# Bazel workspace pinned to its own Bazel version), and a file under an ignored
# directory cannot be an action input at all — a label to it resolves, but the
# sandbox never stages it. //website:staged/proxy-README.md is a symlink that
# reaches it; see the comment there.
#
# .github/workflows/e2e.yaml is not a document — it is the nightly conformance
# suite. The /conformance/ headline states what CI *enforces* on the workflow's
# own authority ("Hard gate (...)"), parsed from it at build time, so the
# workflow is a real input: change the gate and the page changes with it.
filegroup(
    name = "website_docs",
    srcs = [
        ".github/workflows/e2e.yaml",
        "AGENTS.md",
        "README.md",
        "charts/README.md",
    ] + glob(
        ["docs/**/*.md"],
        allow_empty = False,
    ),
    visibility = ["//website:__pkg__"],
)

# The CI definitions, as data for the tests that police what they pin:
# //e2e:kind_pin_test holds every kind / kubectl / node-image value in them to
# e2e/kind-version.sh (#1251), and //e2e:go_pin_test holds every Go toolchain
# they set up to MODULE.bazel's go_sdk.download (#1283). //e2e:helm_pin_test
# holds every Helm they install to e2e/helm-version.sh (#1580), and
# //e2e:gateway_api_pin_test their Gateway API release to
# e2e/gateway-api-version.sh (#1583).
# //scripts:publish_verify_close_issue_test holds publish-verify.yaml's rolling
# issue title to the script that closes it (#1316).
# //bazel/buildid:release_build_ids_test holds the roots of the released
# build-ID check to the charts publish.yaml pushes (#1427).
filegroup(
    name = "ci_definitions",
    srcs = glob(
        [
            ".github/workflows/*.yaml",
            ".github/workflows/*.yml",
        ],
        allow_empty = False,
    ) + glob(
        [
            ".github/actions/**/*.yaml",
            ".github/actions/**/*.yml",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//bazel/actionlint:__pkg__",
        "//bazel/buildid:__pkg__",
        "//e2e:__pkg__",
        "//scripts:__pkg__",
    ],
)

# The two files that pin Go: go_sdk.download (the SDK) and go.mod (what
# actions/setup-go reads). //e2e:go_pin_test keeps them equal (#1283).
exports_files(
    [
        "MODULE.bazel",
        "go.mod",
    ],
    visibility = ["//e2e:__pkg__"],
)

# actionlint's configuration, for //bazel/actionlint.
exports_files(
    [".github/actionlint.yaml"],
    visibility = ["//bazel/actionlint:__pkg__"],
)

# gazelle:prefix aethermesh.dev
# gazelle:resolve proto buf/validate/validate.proto @protovalidate//proto/protovalidate/buf/validate:validate_proto
# gazelle:resolve proto go buf/validate/validate.proto @build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate
# gazelle:go_grpc_compilers @rules_go//proto:go_grpc_v2,@rules_go//proto:go_proto
# gazelle:go_proto_compilers @rules_go//proto:go_proto
gazelle(name = "gazelle")

# nogo — vet-class static analysis run as a validation action on every Go
# compile in this repository (wired in via `go_sdk.nogo` in MODULE.bazel, which
# is the only place a nogo target can be registered under bzlmod).
#
# TOOLS_NOGO is rules_go's re-export of the upstream
# golang.org/x/tools/go/analysis/passes set — the same analyzers `go vet` runs,
# minus the ones rules_go disables upstream (cgocall, pkgfact, and the
# too-noisy shadow pass). We deliberately take the list as-is rather than
# enumerating passes: new analyzers arriving with an x/tools bump should be
# seen, not silently skipped. staticcheck is a separate, later step.
#
# Findings are scoped by :nogo.json; every exclusion there is justified inline.
# Must be publicly visible — rules_go references it from the generated
# @io_bazel_rules_nogo repository.
nogo(
    name = "nogo",
    config = ":nogo.json",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO,
)

# The Prometheus rule files shipped beside the docs, held to the pinned
# promtool (#1492): `promtool check rules` on every one, and `promtool test
# rules` on every `<name>_test.yml` next to them. A rule file added there is
# checked, and a rule test added there is run, with no edit here.
#
# Here and not in a package of its own: a BUILD file in docs/observability
# would take that directory's .md files out of :website_docs above.
promtool_rules_test(
    name = "observability_rules_test",
    rules = glob(
        ["docs/observability/*.yml"],
        allow_empty = False,
        exclude = ["docs/observability/*_test.yml"],
    ),
    tests = glob(
        ["docs/observability/*_test.yml"],
        allow_empty = True,
    ),
)

alias(
    name = "format",
    actual = "//bazel/format",
)

# format_multirun also generates a `.check` sibling (no-write, fails on diff)
# used by `make format-check`; alias it so it is reachable as //:format.check.
alias(
    name = "format.check",
    actual = "//bazel/format:format.check",
)
