load("@aether_registry//:registry.bzl", "image_reference")
load("@rules_go//go:def.bzl", "go_test")

# //e2e:kind_pin_test holds this config's node image to e2e/kind-version.sh.
exports_files(
    ["testdata/kind-config.yaml"],
    visibility = ["//e2e:__pkg__"],
)

go_test(
    name = "e2e_test",
    size = "large",
    srcs = [
        "agent_test.go",
        "cni_test.go",
        "main_test.go",
    ],
    data = glob(["testdata/**"]),
    env_inherit = [
        "PATH",
        "HOME",
        "DOCKER_HOST",
        "KUBECONFIG",
        "AETHER_AGENT_IMAGE",
        "AETHER_CNI_INSTALL_IMAGE",
        "AETHER_REGISTRAR_IMAGE",
    ],
    local = True,
    tags = [
        "e2e",
        "manual",
    ],
    # The default image references (main_test.go), from the single registry
    # setting (proposal 040). AETHER_*_IMAGE still overrides them at run time.
    x_defs = {
        "defaultAgentImage": image_reference("agent") + ":latest",
        "defaultCNIInstallImage": image_reference("cni-install") + ":latest",
        "defaultRegistrarImage": image_reference("registrar") + ":latest",
    },
    deps = [
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_api//rbac/v1:rbac",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/util/intstr",
        "@io_k8s_sigs_e2e_framework//klient",
        "@io_k8s_sigs_e2e_framework//klient/conf",
        "@io_k8s_sigs_e2e_framework//klient/decoder",
        "@io_k8s_sigs_e2e_framework//klient/k8s/resources",
        "@io_k8s_sigs_e2e_framework//klient/wait",
        "@io_k8s_sigs_e2e_framework//klient/wait/conditions",
        "@io_k8s_sigs_e2e_framework//pkg/env",
        "@io_k8s_sigs_e2e_framework//pkg/envconf",
        "@io_k8s_sigs_e2e_framework//pkg/envfuncs",
        "@io_k8s_sigs_e2e_framework//pkg/features",
        "@io_k8s_sigs_e2e_framework//support/kind",
    ],
)
