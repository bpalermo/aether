load("@rules_go//go:def.bzl", "go_library", "go_test")
load(":defs.bzl", "helm_contract_test")

# The external-harness contract: what a harness outside this repository may
# read from a deployed mesh (external-harness.yaml), and the loader the tests
# that hold the code to it share. README.md says how each kind of entry is
# tied to the code.
#
# The checks themselves live with the code that owns each name, in the tests
# an entry's `checked_by` names. `bazel test //test/harnesscontract:all` runs
# the ones that live here; :checks runs them all.
go_library(
    name = "harnesscontract",
    testonly = True,
    srcs = [
        "chart.go",
        "contract.go",
        "testing.go",
    ],
    embedsrcs = ["external-harness.yaml"],
    importpath = "aethermesh.dev/test/harnesscontract",
    visibility = ["//visibility:public"],
    deps = ["@io_k8s_sigs_yaml//:yaml"],
)

go_test(
    name = "harnesscontract_test",
    size = "small",
    srcs = [
        "chart_test.go",
        "contract_test.go",
    ],
    data = ["BUILD.bazel"],
    embed = [":harnesscontract"],
    deps = [
        "//common/constants/annotations",
        "//common/constants/labels",
        "//common/constants/mesh",
        "//common/udspath",
    ],
)

# The chart objects a harness addresses, one test per chart. The render options
# and the expectations are in the contract, not here. `ids` names the renders
# and objects each test holds: the test fails when the contract has one this
# list lacks or lacks one this list has, so an entry cannot leave the contract
# while the chart still renders the object unless this list changes with it.
helm_contract_test(
    name = "aether_chart_test",
    chart = "//charts/aether",
    chart_name = "aether",
    ids = [
        "chart.aether",
        "chart.aether.agent",
        "chart.aether.agent_surge",
        "chart.aether.agent_surge.agent",
        "chart.aether.csidriver",
        "chart.aether.edge",
        "chart.aether.mesh_dns",
        "chart.aether.proxy",
        "chart.aether.uds_csi",
    ],
)

helm_contract_test(
    name = "prober_chart_test",
    chart = "//charts/prober",
    chart_name = "prober",
    ids = [
        "chart.prober",
        "chart.prober.daemonset",
    ],
)

helm_contract_test(
    name = "udsecho_chart_test",
    chart = "//charts/udsecho",
    chart_name = "udsecho",
    ids = [
        "chart.udsecho",
        "chart.udsecho.annotation_path",
        "chart.udsecho.policy_path",
    ],
)

# Every test a contract entry names in `checked_by`. harnesscontract_test fails
# when this list and the contract disagree.
test_suite(
    name = "checks",
    tests = [
        ":aether_chart_test",
        ":harnesscontract_test",
        ":prober_chart_test",
        ":udsecho_chart_test",
        "//agent/internal/xds/cache/cachemetrics:cachemetrics_test",
        "//agent/internal/xds/proxy:proxy_test",
        "//agent/internal/xds/xdsconst:xdsconst_test",
        "//prober/internal/prober:prober_test",
    ],
)
