load("@rules_shell//shell:sh_library.bzl", "sh_library")

# //bazel's own shell, in range of the shellcheck aspect (#853). See
# //scripts:scripts_shell for why these targets exist at all.
#
# `workspace_status.sh` is the stamping script every `bazel build` runs
# (`--workspace_status_command` in .bazelrc), so a syntax or quoting error in it
# breaks every build in the repository; it had never been linted. This is a
# plain sh_library over source files and is NOT the workspace-status wiring —
# nothing in the build graph depends on it, the flag names the path directly.
#
# The glob is deliberately non-recursive. //bazel/lint, //bazel/format,
# //bazel/img, //bazel/helm, //bazel/protodoc and //bazel/proxy_pin are their own
# packages, and a glob cannot cross a package boundary — `glob(["**/*.sh"])`
# would silently stop at each BUILD.bazel rather than reaching into them. If one
# of them ever gains a script it needs its own target, which is what
# scripts/check-shell-lint.sh is there to notice.
# The status script as a file, for //bazel/img:digest_stability_test, which runs
# it in a scratch git repository to hold it to the one property the release
# depends on (#1378): it emits a commit-derived STABLE_ key.
exports_files(
    ["workspace_status.sh"],
    visibility = ["//bazel/img:__pkg__"],
)

sh_library(
    name = "bazel_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)
