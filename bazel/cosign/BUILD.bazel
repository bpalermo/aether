load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# cosign from the rules_img_signer_cosign module (MODULE.bazel), the ONLY cosign
# this repository signs or verifies with -- in CI (publish.yaml, proxy-release.yml,
# publish-verify.yaml) and by hand. The version and its sha256 live in that
# module's lock; bumping cosign is bumping the bazel_dep. See docs/runbook.md,
# "Verifying image signatures".
#
# Hand-written: Gazelle manages Go only. The module's `sign-oci-artifact` signer
# plugin (rules_img signing_config) is deliberately NOT wired: publish.yaml and
# proxy-release.yml sign with this CLI after the pushes, by digest -- the path
# the quay-smoke gate measured on quay.io (a referrer, no tag; proposal 040).

_COSIGN = "@rules_img_signer_cosign//cosign"

# The registry setting. A module of its own (MODULE.bazel), so in runfiles it is
# NOT at bazel/registry/registry.bzl, where scripts/image-registry.sh looks by
# default: verify_image_signatures.sh hands it over as IMAGE_REGISTRY_BZL.
_REGISTRY_BZL = "@aether_registry//:registry.bzl"

# What verify_image_signatures.sh runs, directly or not. registry-lib.sh is
# sourced by the script, and runs image-registry.sh (which parses registry.bzl)
# while it is being sourced: all three are runfiles, or every run begins with
# "image-registry.sh: No such file or directory" and the library has no host
# and no repository list (#1338).
_VERIFY_DATA = [
    _COSIGN,
    _REGISTRY_BZL,
    "//scripts:image-registry.sh",
    "//scripts:registry-lib.sh",
    "//scripts:verify-image-signatures.sh",
]

# What verify_image_signatures.sh reads to find its runfiles. `bazel run` sets
# it from the target; :verify_image_signatures_test runs that target as data,
# where nothing does, so it sets the same values.
_VERIFY_ENV = {
    "COSIGN_RLOCATIONPATH": "$(rlocationpath %s)" % _COSIGN,
    "REGISTRY_BZL_RLOCATIONPATH": "$(rlocationpath %s)" % _REGISTRY_BZL,
    "VERIFY_SCRIPT_RLOCATIONPATH": "$(rlocationpath //scripts:verify-image-signatures.sh)",
}

# bazel run //bazel/cosign -- <args>
sh_binary(
    name = "cosign",
    srcs = ["cosign.sh"],
    data = [_COSIGN],
    env = {"COSIGN_RLOCATIONPATH": "$(rlocationpath %s)" % _COSIGN},
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# bazel run //bazel/cosign:verify_image_signatures -- <registry/repo@digest>... | --file <refs>
sh_binary(
    name = "verify_image_signatures",
    srcs = ["verify_image_signatures.sh"],
    data = _VERIFY_DATA,
    env = _VERIFY_ENV,
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The target above, run from its own runfiles the way `bazel run` runs it, with
# a fake cosign and a fake curl: nothing on stderr when the library is sourced,
# and the registry setting really is readable there (#1338). Network-free.
sh_test(
    name = "verify_image_signatures_test",
    size = "small",
    srcs = ["verify_image_signatures_test.sh"],
    data = [":verify_image_signatures"] + _VERIFY_DATA,
    env = _VERIFY_ENV | {
        "IMAGE_REGISTRY_SH_RLOCATIONPATH": "$(rlocationpath //scripts:image-registry.sh)",
        "TARGET_RLOCATIONPATH": "$(rlocationpath :verify_image_signatures)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Network-free: `cosign version` must print the version the docs name.
sh_test(
    name = "version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = [_COSIGN],
    env = {"COSIGN_RLOCATIONPATH": "$(rlocationpath %s)" % _COSIGN},
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
