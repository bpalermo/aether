load("@aether_registry//:registry.bzl", "chart_registry_url")

# A throwaway chart for //bazel/helm:chart_push_test. Never published: nothing in
# publish.yaml runs these targets, and the test replaces oras with a recorder.
load("@rules_helm//helm:defs.bzl", "helm_chart")
load("//bazel/helm:defs.bzl", "chart_push")

helm_chart(
    name = "pushtest",
    chart = "Chart.yaml",
    values = "values.yaml",
    visibility = ["//bazel/helm:__pkg__"],
)

chart_push(
    name = "pushtest.chart_push",
    chart_name = "pushtest",
    package = ":pushtest",
    repository = chart_registry_url("pushtest"),
    visibility = ["//bazel/helm:__pkg__"],
)

# The same package, pushed by a target that believes it is another chart: the
# runner must refuse rather than publish chart A under chart B's repository.
chart_push(
    name = "wrong_name.chart_push",
    chart_name = "not-pushtest",
    package = ":pushtest",
    repository = chart_registry_url("not-pushtest"),
    visibility = ["//bazel/helm:__pkg__"],
)
