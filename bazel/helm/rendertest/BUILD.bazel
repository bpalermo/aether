load("@rules_go//go:def.bzl", "go_library", "go_test")

# Renders a packaged chart inside a Go test and returns its objects, for chart
# tests that compare a render with a Go constant or a file (the package comment
# of rendertest.go gives the go_test attributes). The pattern rules in
# //bazel/helm:defs.bzl stay the tool for everything a pattern can say.
go_library(
    name = "rendertest",
    testonly = True,
    srcs = ["rendertest.go"],
    importpath = "aethermesh.dev/bazel/helm/rendertest",
    visibility = ["//charts:__subpackages__"],
    deps = ["@io_k8s_sigs_yaml//:yaml"],
)

go_test(
    name = "rendertest_test",
    size = "small",
    srcs = ["rendertest_test.go"],
    embed = [":rendertest"],
)
