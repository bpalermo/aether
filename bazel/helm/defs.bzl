  count="$(grep -c . <<<"$lines")"
  [[ "$count" -eq 1 ]] || fail "expected exactly one rendered, non-comment line holding '@@KEY@@' ($label), found $count (the lines are not shown)"
  printf '%s\\n' "$lines"
