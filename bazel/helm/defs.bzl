export HELM_REGISTRY_CONFIG="$scratch/registry.json"
export HELM_PLUGINS="@@HELM_PLUGINS@@"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

value() { # <label> <helm args...>: the one rendered line that holds the key
  local label="$1" out lines count
  shift
  out="$(@@HELM@@ template release @@CHART@@ "$@" 2>"$scratch/helm.err")" || {
    show_helm_failure "$(cat "$scratch/helm.err")"
    fail "'helm template' did not render ($label)"
