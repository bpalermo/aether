a="$(value "opts" @@OPTS@@)" || exit 1
b="$(value "opts + changed_opts" @@OPTS@@ @@CHANGED_OPTS@@)" || exit 1
c="$(value "opts, again" @@OPTS@@)" || exit 1
[[ "$a" == "$c" ]] || fail "'@@KEY@@' differs between two renders of the same values: it is not a function of them"
[[ "$a" != "$b" ]] || fail "the line holding '@@KEY@@' is the same with and without the changed values (the line is not shown)"
echo "PASS: '@@KEY@@' follows the changed values and is stable for unchanged ones."
