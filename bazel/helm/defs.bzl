_REPRODUCIBLE_RUNNER = """\
#!/usr/bin/env bash
# Generated by //bazel/helm:defs.bzl helm_template_reproducible_test. Do not edit.
set -uo pipefail
# shellcheck source=/dev/null
source @@LIB@@ || exit 1

scratch="${TEST_TMPDIR:-$(mktemp -d)}/helm"
mkdir -p "$scratch"
export HELM_CACHE_HOME="$scratch/cache"
export HELM_CONFIG_HOME="$scratch/config"
export HELM_DATA_HOME="$scratch/data"
export HELM_REPOSITORY_CACHE="$scratch/repository_cache"
export HELM_REPOSITORY_CONFIG="$scratch/repositories.yaml"
export HELM_REGISTRY_CONFIG="$scratch/registry.json"
export HELM_PLUGINS="@@HELM_PLUGINS@@"

for r in 1 2; do
  if ! @@HELM@@ template release @@CHART@@ @@OPTS@@ >"$scratch/render.$r" 2>"$scratch/render.$r.err"; then
    show_helm_failure "$(cat "$scratch/render.$r.err")"
    echo "FAIL: 'helm template' did not render." >&2
    exit 1
  fi
  [[ -s "$scratch/render.$r" ]] || { echo "FAIL: the render is empty." >&2; exit 1; }
  # The documented recipe: everything after the key of a masked line is dropped.
  sed -E @@MASK@@ "$scratch/render.$r" >"$scratch/masked.$r"
done

rc=0
masked="$(grep -c '<masked>$' "$scratch/masked.1")"
if [[ "$masked" -ne @@MASKED_LINES@@ ]]; then
  echo "FAIL: the mask hid $masked lines, want @@MASKED_LINES@@: the set of values generated at render time changed." >&2
  grep -n '<masked>$' "$scratch/masked.1" >&2
  rc=1
fi
if cmp -s "$scratch/masked.1" "$scratch/masked.2"; then
  echo "PASS: two renders are byte-identical ($masked masked lines)."
else
  echo "FAIL: two renders of the same chart and values differ outside the masked lines:" >&2
  # Never the differing text: a value generated at render time may be a private
  # key, and a test log is not the place for one, however short-lived. A line
  # that starts with a plain YAML key is reported by that key; any other line
  # (a list item, a line of a block scalar) only as a line number.
  diff "$scratch/masked.1" "$scratch/masked.2" | awk '
    /^[0-9]+(,[0-9]+)?[acd][0-9]+(,[0-9]+)?$/ { where = $0; next }
    /^< / {
      line = substr($0, 3)
      if (match(line, /^[[:space:]]*[A-Za-z0-9_.-]+:/)) {
        key = substr(line, RSTART, RLENGTH)
        gsub(/^[[:space:]]+/, "", key)
        print "  first render, at " where ": the value of " key
      } else {
        print "  first render, at " where ": a line with no key (not shown)"
      }
    }' | sort | uniq -c | head -n 20 >&2
  rc=1
fi
exit "$rc"
"""

def _helm_template_reproducible_test_impl(ctx):
    toolchain = ctx.toolchains[Label("@rules_helm//helm:toolchain_type")]
    chart = ctx.attr.chart[HelmPackageInfo].chart
    for key in ctx.attr.masked_keys:
        if not key.replace(".", "").replace("-", "").replace("_", "").isalnum():
            fail("helm_template_reproducible_test masked_keys must be plain YAML keys, got %r" % key)

    # `    ca.crt: LS0t...` -> `    ca.crt: <masked>`. With no key the
    # expression matches nothing, so the render is compared as it is.
    keys = "|".join([key.replace(".", "\\.") for key in ctx.attr.masked_keys]) or "$^"
    mask = "s/^([[:space:]]*(" + keys + "):).*$/\\1 <masked>/"

    script = _REPRODUCIBLE_RUNNER
    for placeholder, value in [
        ("@@HELM_PLUGINS@@", toolchain.helm_plugins.short_path),
        ("@@HELM@@", _shell_quote(toolchain.helm.short_path)),
        ("@@CHART@@", _shell_quote(chart.short_path)),
        ("@@LIB@@", _shell_quote(ctx.file._render_lib.short_path)),
        ("@@OPTS@@", " ".join([_shell_quote(opt) for opt in ctx.attr.opts])),
        ("@@MASKED_LINES@@", str(ctx.attr.masked_lines)),
        ("@@MASK@@", _shell_quote(mask)),
    ]:
        script = script.replace(placeholder, value)

    runner = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(output = runner, content = script, is_executable = True)

    return [DefaultInfo(
        executable = runner,
        runfiles = ctx.runfiles(files = [
            chart,
            ctx.file._render_lib,
            toolchain.helm,
            toolchain.helm_plugins,
        ]),
    )]

