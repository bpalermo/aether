load("@aether_registry//:registry.bzl", "IMAGE_NAMESPACE", "IMAGE_REGISTRY", "SIGNATURE_LAYOUT", "chart_registry_url", "chart_repository", "image_reference", "image_repository")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The registry is ONE setting, registry.bzl (proposal 040), read two ways: Bazel
# loads it, and scripts/image-registry.sh parses it for everything that is not
# Bazel (workflows, verifiers, e2e scripts). Two readers of one file can still
# disagree — a parse that drops an override, a helper that formats differently —
# so this pins them against each other: the Starlark helpers' answers are
# written out at LOADING time, and the test asks the shell script the same
# questions against the same file.
#
# The components are every image the build knows how to push (plus `proxy`,
# which the //proxy workspace pushes); the charts are the four published.
_COMPONENTS = [
    "agent",
    "mesh-dns",
    "proxy-supervisor",
    "uds-csi",
    "cni-install",
    "registrar",
    "controller",
    "prober",
    "udsecho",
    "l4echo",
    "proxy",
]

_CHARTS = [
    "aether",
    "crds",
    "prober",
    "udsecho",
]

# `<subcommand> [<arg>] <answer>` per line: what the Starlark helpers say.
_EXPECTED = [
    "host " + IMAGE_REGISTRY,
    "prefix " + IMAGE_REGISTRY + "/" + IMAGE_NAMESPACE,
    "signature-layout " + SIGNATURE_LAYOUT,
]

_EXPECTED += ["repo {} {}".format(
    c,
    image_repository(c),
) for c in _COMPONENTS]

_EXPECTED += ["ref {} {}".format(
    c,
    image_reference(c),
) for c in _COMPONENTS]

_EXPECTED += ["chart-repo {} {}".format(
    c,
    chart_repository(c),
) for c in _CHARTS]

_EXPECTED += ["chart-ref {} {}".format(
    c,
    chart_registry_url(c),
) for c in _CHARTS]

write_file(
    name = "registry_expected",
    out = "registry_expected.txt",
    content = _EXPECTED + [""],
)

sh_test(
    name = "registry_test",
    srcs = ["registry_test.sh"],
    args = [
        "$(rootpath :registry_expected)",
        "$(rootpath //scripts:image-registry.sh)",
        "$(rootpath @aether_registry//:registry.bzl)",
    ],
    data = [
        ":registry_expected",
        "//scripts:image-registry.sh",
        "@aether_registry//:registry.bzl",
    ],
)

# Every image this repository builds. //bazel/img:digest_stability_test reads
# each one's index.
_IMAGE_PACKAGES = [
    "//agent/cmd/agent",
    "//agent/cmd/mesh-dns",
    "//agent/cmd/proxy-supervisor",
    "//agent/cmd/uds-csi",
    "//cni/cmd/cni-install",
    "//controller/cmd/controller",
    "//e2e/l4echo",
    "//e2e/udsecho",
    "//prober/cmd/prober",
    "//registrar/cmd/registrar",
]

exports_files(
    ["go_multi_arch_image.bzl"],
    visibility = ["//visibility:private"],
)

# An image's digest must not depend on the commit, and the per-commit tag must
# still follow it (#1378). See the script's header for what each check holds.
sh_test(
    name = "digest_stability_test",
    size = "small",
    srcs = ["digest_stability_test.sh"],
    args = [
        "$(rootpath //bazel:workspace_status.sh)",
        "$(rootpath go_multi_arch_image.bzl)",
    ] + ["$(rootpath {}:image_index)".format(p) for p in _IMAGE_PACKAGES],
    data = [
        "go_multi_arch_image.bzl",
        "//bazel:workspace_status.sh",
        "@jq_toolchains//:resolved_toolchain",
    ] + [p + ":image_index" for p in _IMAGE_PACKAGES],
    env = {"JQ_RLOCATIONPATH": "$(rlocationpath @jq_toolchains//:resolved_toolchain)"},
)
