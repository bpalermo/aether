# Website (//website) — aethermesh.dev.
#
# Pinned mermaid bundle. Material for MkDocs lazy-loads mermaid from unpkg.com;
# //website:build_site rewrites that URL to this self-hosted copy and fails the
# build if the reference it expects to rewrite is gone. aethermesh.dev is a .dev
# domain (HSTS-preloaded) and issues zero third-party requests.
#
# The MAJOR is not ours to choose: Material asks for `mermaid@11`, so this must
# stay on the newest 11.x. mermaid 12 is a breaking release (ELK as the default
# layout engine, a new default theme, ES2024/Safari 17.4 floor) and serving it
# behind Material's `@11` URL would silently re-lay out and recolour every
# diagram. Bump the major only when a Material release changes that URL — and
# change CDN_REWRITES in website/build_site.py in the same commit.
#
# MERMAID_VERSION = "11.17.2"
# ---------------------------------------------------------------------------
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "mermaid_js",
