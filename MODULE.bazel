# Envoy binary for //agent/test/envoy_validate ("envoy --mode validate" over
# aether-generated bootstrap configs).
#
# NOT a stock Envoy release asset: the deployed proxy is a custom build (see the
# //proxy workspace) that compiles a large set of upstream extensions out and the
# C++ aether_stats extension in, so stock Envoy is strictly more permissive than
# what we ship and the gate would pass configs the real proxy NACKs (#709).
#
# Instead the extension below lifts /usr/local/bin/envoy out of the aether-proxy
# image at the digest //charts/aether:values.yaml pins, so the chart pin is the
# single source of truth: whatever proxy-release's bump-chart job writes into the
# chart is what this gate validates against, with no second pin to keep in sync.
# ---------------------------------------------------------------------------
pinned_proxy = use_extension("//bazel/proxy_pin:extensions.bzl", "pinned_proxy")
use_repo(
    pinned_proxy,
    "pinned_envoy_linux_amd64",
    "pinned_envoy_linux_arm64",
)

