load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Every script in //scripts, declared so the shellcheck aspect in
# //bazel/lint:linters.bzl has something to visit here (#853).
#
# The aspect's `rule_kinds` is sh_binary/sh_library/sh_test and nothing else, so
# before #848 — which declared the first sh_* target in this repository, for the
# //proxy bridge — `--config=lint` ran shellcheck over precisely zero files.
# `make lint` was green because it had no input, which is indistinguishable from
# green because the shell is clean.
#
# `glob(["*.sh"])` rather than an explicit list: the failure mode this target
# exists to prevent is a script that nobody remembered to cover, so the srcs
# must not be a list anyone has to remember to append to. scripts/ has no
# subdirectories and no non-shell files; if it grows either, the glob still only
# claims `*.sh` here and the sibling directory needs its own target (see
# //e2e/pressure and //e2e/soak for why the targets are per-directory).
#
# `scripts/check-shell-lint.sh` asserts that the union of these targets' srcs
# covers every shell script in the repository, so adding one in a directory with
# no target fails rather than silently falling outside the gate.
sh_library(
    name = "scripts_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

