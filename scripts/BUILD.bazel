# test can hold the script's issue title, and the step that runs it, to the
# YAML.
sh_test(
    name = "publish_verify_close_issue_test",
    size = "small",
    srcs = ["publish_verify_close_issue_test.sh"],
    data = [
        "publish-verify-close-issue.sh",
        "publish-verify-control-issue.sh",
        "//:ci_definitions",
    ],
)

# The signature verifier against answers that are not answers (#1316): a 5xx,
# an empty or HTML 200, a truncated index, no connection, a `cosign verify`
# that fails once. Fake `curl`, `cosign` and `sleep`; no network, no waiting.
# Also the tag listing and the sign step's lookup around it (#1337), and that
# sourcing registry-lib.sh is silent (#1338). `moderate`: every case sources
# the library, which runs image-registry.sh ten times (~0.5 s), and there are
# about sixty cases -- half of `small`'s 60 s on an idle machine.
sh_test(
    name = "verify_image_signatures_test",
    size = "small",
    timeout = "moderate",
    srcs = ["verify_image_signatures_test.sh"],
    data = [
        "image-registry.sh",
        "registry-lib.sh",
        "verify-image-signatures.sh",
    ],
)

# Which chart references one commit's publish is signed and attested under
