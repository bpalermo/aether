load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Every script in //scripts, declared so the shellcheck aspect in
# //bazel/lint:linters.bzl has something to visit here (#853).
#
# The aspect's `rule_kinds` is sh_binary/sh_library/sh_test and nothing else, so
# before #848 — which declared the first sh_* target in this repository, for the
# //proxy bridge — `--config=lint` ran shellcheck over precisely zero files.
# `make lint` was green because it had no input, which is indistinguishable from
# green because the shell is clean.
#
# `glob(["*.sh"])` rather than an explicit list: the failure mode this target
# exists to prevent is a script that nobody remembered to cover, so the srcs
# must not be a list anyone has to remember to append to. scripts/ has no
# subdirectories and no non-shell files; if it grows either, the glob still only
# claims `*.sh` here and the sibling directory needs its own target (see
# //e2e/pressure and //e2e/soak for why the targets are per-directory).
#
# `scripts/check-shell-lint.sh` asserts that the union of these targets' srcs
# covers every shell script in the repository, so adding one in a directory with
# no target fails rather than silently falling outside the gate.
sh_library(
    name = "scripts_shell",
    srcs = glob(["*.sh"]),
    visibility = ["//visibility:private"],
)

# The stuck-runs watchdog (.github/workflows/stuck-runs.yaml): its decide logic
# over canned GitHub API JSON, and its run mode end to end through a fake `gh`.
# Hermetic: the Bazel-pinned jq, no network.
sh_test(
    name = "stuck_runs_test",
    size = "small",
    srcs = ["stuck_runs_test.sh"],
    data = [
        "stuck-runs.sh",
        "@jq_toolchains//:resolved_toolchain",
    ] + glob(["testdata/stuck-runs/*"]),
    env = {"JQ_RLOCATIONPATH": "$(rlocationpath @jq_toolchains//:resolved_toolchain)"},
)

# The verifier and the helper it sources, for //bazel/cosign:verify_image_signatures,
# which runs it with COSIGN set to the Bazel-pinned cosign binary.
exports_files(
    [
        "registry-lib.sh",
        "verify-image-signatures.sh",
    ],
    visibility = ["//bazel/cosign:__pkg__"],
)

# The registry setting reader (proposal 040), for //bazel/img:registry_test,
# which pins it against the Starlark helpers in bazel/registry/registry.bzl.
exports_files(
    ["image-registry.sh"],
    visibility = ["//bazel/img:__pkg__"],
)

# publish-verify's superseded-commit decision (workflow_run path): which
# finished publish runs it skips, and which it must keep verifying.
sh_test(
    name = "publish_verify_superseded_test",
    size = "small",
    srcs = ["publish_verify_superseded_test.sh"],
    data = ["publish-verify-superseded.sh"],
)
