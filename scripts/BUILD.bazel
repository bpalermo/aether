# publish.yaml's sign steps (#1378): an artifact is signed only when it is not
# signed already, and "signed" means the manifest and every child of an index,
# under this workflow's identity. A fake `curl` is the registry, a fake `bazel`
# runs the REAL verify-image-signatures.sh against a fake `cosign`. `moderate`:
# a signed image costs a full child walk, each one sourcing registry-lib.sh
# (~0.5 s); about 75 s on an idle machine.
sh_test(
    name = "publish_sign_test",
    size = "small",
    timeout = "moderate",
    srcs = ["publish_sign_test.sh"],
    data = [
        "image-registry.sh",
        "publish-sign.sh",
        "published-chart-refs.sh",
        "registry-lib.sh",
        "verify-image-signatures.sh",
    ],
)

