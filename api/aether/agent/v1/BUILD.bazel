load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//bazel/lint:linters.bzl", "buf_test")

# Agent-local persisted state: no gRPC service and no protoc-gen-dynamo
# annotations, so it rides Protobuf Editions 2024 through the standard Go
# compiler only (protoc-gen-dynamo is capped at edition 2023). Keep gazelle
# from re-adding //bazel/go:go_dynamo.
# gazelle:go_proto_compilers @rules_go//proto:go_proto

proto_library(
    name = "agentv1_proto",
    srcs = ["observed_upstreams.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:timestamp_proto"],
)

go_proto_library(
    name = "agentv1_go_proto",
    compilers = ["@rules_go//proto:go_proto"],
    importpath = "aethermesh.dev/api/aether/agent/v1",
    proto = ":agentv1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "agent",
    embed = [":agentv1_go_proto"],
    importpath = "aethermesh.dev/api/aether/agent/v1",
    visibility = ["//visibility:public"],
)

buf_test(
    name = "agentv1_buf_lint_test",
    srcs = [":agentv1_proto"],
)
