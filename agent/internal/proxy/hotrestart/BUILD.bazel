load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hotrestart",
    srcs = [
        "adminprobe.go",
        "coordination.go",
        "crash.go",
        "metrics.go",
        "supervisor.go",
        "telemetry.go",
    ],
    importpath = "aethermesh.dev/agent/internal/proxy/hotrestart",
    visibility = ["//agent:__subpackages__"],
    deps = [
        "//common/log",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//semconv/v1.30.0:v1_30_0",
        "@io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc//:otlpmetricgrpc",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
    ],
)

go_test(
    name = "hotrestart_test",
    srcs = [
        "adminprobe_test.go",
        "adminreverify_test.go",
        "coordination_test.go",
        "crash_test.go",
        "metrics_test.go",
        "supervisor_test.go",
    ],
    # The chart's proxy.hotRestart values are an input to the admin re-verify
    # derivation; TestAdminReverifyMarginHoldsAgainstDeployedChartValues pins
    # them (#666). Gazelle does not manage `data` — keep this by hand.
    data = ["//charts/aether:values.yaml"],
    embed = [":hotrestart"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_sigs_yaml//:yaml",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
