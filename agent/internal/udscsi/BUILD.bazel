load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "udscsi",
    srcs = [
        "driver.go",
        "mounter.go",
        "mounter_linux.go",
        "mounter_other.go",
        "registration.go",
        "serve.go",
        "size.go",
    ],
    importpath = "aethermesh.dev/agent/internal/udscsi",
    visibility = ["//agent:__subpackages__"],
    deps = [
        "//api/aether/kubelet/pluginregistration/v1:pluginregistration",
        "@com_github_container_storage_interface_spec//lib/go/csi",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/wrapperspb",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "udscsi_test",
    size = "small",
    srcs = [
        "carrier_contract_test.go",
        "driver_test.go",
        "serve_test.go",
    ],
    embed = [":udscsi"],
    deps = [
        "//api/aether/kubelet/pluginregistration/v1:pluginregistration",
        "//common/udspath",
        "@com_github_container_storage_interface_spec//lib/go/csi",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
    ],
)
