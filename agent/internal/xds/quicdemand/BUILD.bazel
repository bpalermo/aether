load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "quicdemand",
    srcs = ["requests.go"],
    importpath = "aethermesh.dev/agent/internal/xds/quicdemand",
    visibility = [
        "//agent:__subpackages__",
        "//test:__subpackages__",  # mtlspool: the live #1033 gate runs the agent's classifier
