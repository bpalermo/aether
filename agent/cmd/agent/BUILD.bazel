load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/img:go_multi_arch_image.bzl", "go_multi_arch_image")
load("//bazel/img:registry.bzl", "image_repository")

go_library(
    name = "agent_lib",
    srcs = ["main.go"],
    importpath = "aethermesh.dev/agent/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//agent/internal/cmd",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    visibility = ["//visibility:public"],
    x_defs = {
        "aethermesh.dev/agent/internal/cmd.Version": "{STABLE_GIT_VERSION}",
    },
)

go_multi_arch_image(
    name = "agent_image",
    binary = ":agent",
    repository = image_repository("agent"),
    # /identity-ready is the egress identity gate (#1053): the controller's
    # pod-mutating webhook injects it as the first init container of every
    # mesh-managed pod, running THIS image — the one the agent DaemonSet already
    # keeps on every node, so the gate costs no extra pull and cannot skew from
    # the agent it fronts. See //agent/cmd/identity-ready:deps_test for what it
    # may link.
    # /agent-ready is this pod's own exec liveness/readiness probe (proposal
    # 041): it asks the agent over its pod-local health socket, so a surge
    # standby's probes are never answered by the other agent on the node. See
    # //agent/cmd/agent-ready:deps_test for what it may link (nothing).
    tars_layer = {
        "/agent-ready": "//agent/cmd/agent-ready:agent-ready",
        "/identity-ready": "//agent/cmd/identity-ready:identity-ready",
    },
)
