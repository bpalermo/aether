load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/img:go_multi_arch_image.bzl", "go_multi_arch_image")

go_library(
    name = "agent_lib",
    srcs = ["main.go"],
    importpath = "aethermesh.dev/agent/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//agent/internal/cmd",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    visibility = ["//visibility:public"],
    x_defs = {
        "aethermesh.dev/agent/internal/cmd.Version": "{STABLE_GIT_VERSION}",
    },
)

go_multi_arch_image(
    name = "agent_image",
    binary = ":agent",
    repository = "bpalermo/aether/agent",
    # The aether-proxy pod's exec readiness probe (#673).
    #
    # Since #772 the supported path stages it out of
    # //agent/cmd/proxy-supervisor:image, not this one — the chart's
    # install-supervisor initContainer runs that image now. This layer is kept
    # for the DEPRECATED `agent proxy-supervisor` alias, whose
    # --install-readiness-path reads /proxy-ready out of whatever image it is
    # running in: a chart predating #772 runs it from THIS image, and without the
    # layer that initContainer hard-fails. Drop it together with the alias, once
    # no supported chart version still passes `proxy-supervisor` to this binary.
    #
    # The whole point of the binary is what it does NOT link — see
    # //agent/cmd/proxy-ready:deps_test.
    tars_layer = {
        "/proxy-ready": "//agent/cmd/proxy-ready:proxy-ready",
    },
)
