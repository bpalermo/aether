load("@aether_registry//:registry.bzl", "image_repository")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# gazelle:exclude race_test.go
# gazelle:exclude norace_test.go
load("//bazel/img:go_multi_arch_image.bzl", "go_multi_arch_image")

# deps_test.go is hand-wired below into its own :deps_test target (it needs the
# linked binary as data and has to be nameable on its own), so keep gazelle from
# folding it into :mesh-dns_test.
# gazelle:exclude deps_test.go

go_library(
    name = "mesh-dns_lib",
    srcs = ["main.go"],
    importpath = "aethermesh.dev/agent/cmd/mesh-dns",
    visibility = ["//visibility:private"],
    deps = [
        "//agent/constants",
        "//agent/internal/meshdns",
        "//common/buildinfo",
        "//common/constants/mesh",
        "//common/log",
        "//common/signals",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "mesh-dns",
    embed = [":mesh-dns_lib"],
    visibility = ["//visibility:public"],
)

# Dedicated image for the aether-mesh-dns DaemonSet (#583, option B). The daemon
# used to ship inside the agent image (one extra /mesh-dns layer) purely to avoid
# standing up a second publish pipeline; that made every node pull
# controller-runtime, xDS/go-control-plane, the CNI server and SPIRE for a process
# that binds a host port and answers every managed pod's :53 DNAT and executes none
# of it. This image carries the slim binary alone.
go_multi_arch_image(
    name = "mesh-dns_image",
    binary = ":mesh-dns",
    repository = image_repository("mesh-dns"),
    # The DaemonSet's exec readiness probe (#683). It ships as an extra layer in
    # THIS image — the one the DaemonSet already runs on every node — so there is
    # no second pull, and no chart/image skew is possible: the probe binary and
    # the daemon that writes the marker are the same artifact. The whole point of
    # the binary is what it does NOT link (the probe used to re-exec this 16.9MB
    # daemon every 15s per pod) — see //agent/cmd/mesh-dns-ready:deps_test.
    tars_layer = {
        "/mesh-dns-ready": "//agent/cmd/mesh-dns-ready:mesh-dns-ready",
    },
)

go_test(
    name = "mesh-dns_test",
    size = "small",
    srcs = [
        "main_test.go",
        "version_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":mesh-dns_lib"],
    deps = [
        "//agent/internal/meshdns",
        "//common/buildinfo",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Linkage guard. mesh-dns was carved out of the agent (#583) so the node's
# resolver survives agent rolls without pulling controller-runtime,
# go-control-plane, the CNI server and SPIRE onto every node. The test pins its
# module set as an explicit allow-list (and a module budget) against the linked
# ELF that ships in the mesh-dns image, and forbids the agent's heavyweights
# outright. scripts/check-mesh-dns-deps.sh is the build-graph half.
go_test(
    name = "deps_test",
    size = "small",
    srcs = [
        "deps_test.go",
        "norace_test.go",
        "race_test.go",
    ],
    data = [":mesh-dns"],
    embed = [":mesh-dns_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
