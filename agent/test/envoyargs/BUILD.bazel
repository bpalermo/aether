load("@rules_go//go:def.bzl", "go_test")

# Runs the supervisor's --envoy-arg startup check (hotrestart.CheckExtraArgs)
# and the pinned Envoy's own command-line parser over the same arguments
# (#1407, #1408, #1409). The rules in the check were measured on this binary;
# this is what notices when a pin bump changes the parser. It also holds the
# flag table the check parses with against `envoy --help` of this binary
# (#1443): the check refuses a flag that is not in the table, so a pin bump
# that adds a flag fails here until the table has it.
#
# It also holds the supervisor's prediction of Envoy's default worker count
# (hotrestart.EnvoyDefaultConcurrency, #1442) against the count the pinned
# Envoy really runs, under a narrowed CPU affinity and, where an unprivileged
# test can get a cgroup with a CPU quota (a systemd user session), under a CPU
# limit. That last test skips where it cannot, CI included.
#
# About 120 `envoy --mode validate` runs and a dozen short serving ones, ~11 s
# wall time.
#
# Tagged "envoy-validate" (not "integration"): no Docker daemon required.
go_test(
    name = "envoyargs_test",
    size = "small",
    srcs = [
        "cpucount_linux_test.go",
        "envoyargs_test.go",
    ],
    # Gazelle does not manage `data` -- keep this by hand.
    data = ["//agent/test/envoybin:envoy_bin"],
    tags = [
        "envoy-validate",
        # The Envoy binary reads /proc on startup; run outside strict sandbox.
        "no-sandbox",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        "//agent/internal/proxy/hotrestart",
        "//agent/test/envoybin",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
