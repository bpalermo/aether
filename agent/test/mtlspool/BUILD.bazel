load("@rules_go//go:def.bzl", "go_test")

# Runs a REAL aether-proxy Envoy with two source identities on one node and
# checks that the destination verifies the right client certificate on every
# request (issue #831).
#
# Run with:
#   bazel test //agent/test/mtlspool:mtlspool_test
#   bazel test //agent/test/mtlspool:mtlspool_test --test_output=all
#
# Tagged "envoy-validate" alongside //agent/test/envoy_validate — both gates need the
# pinned proxy binary and neither needs Docker.
# size=medium: two Envoy processes and ~40 round trips, ~10 s wall time.
go_test(
    name = "mtlspool_test",
    size = "medium",
    # Over 300 s on a quiet workstation since the one-HCM live probes and
    # controls (each runs its own proxy).
    timeout = "long",
    srcs = [
        "accesslog_timing_test.go",
        "ads_sds_test.go",
        "alias_floor_eds_test.go",
        "begun_request_1641_test.go",
        "cds_partial_reject_test.go",
        "cds_reconnect_test.go",
        "harness_test.go",
        "iprange_live_test.go",
        "lds_reconnect_test.go",
        "onehcm_filterstate_route_test.go",
        "onehcm_levels_live_test.go",
        "onehcm_probe_test.go",
        "onehcm_review_extauthz_override_test.go",
        "onehcm_review_hm_order_test.go",
        "onehcm_rules_live_test.go",
        "outcome_1641_cases_test.go",
        "perport_accept_test.go",
        "perport_callerns_test.go",
        "perport_filterlevels_test.go",
        "perport_fourth_live_test.go",
        "perport_invalidshare_test.go",
        "perport_live_test.go",
        "perport_proxyport_test.go",
        "perport_second_test.go",
        "perport_third_live_test.go",
        "perport_tlsroute_test.go",
