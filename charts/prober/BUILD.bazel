load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/img:registry.bzl", "IMAGE_REGISTRY", "chart_registry_url")

# prober Helm chart (published as chart_repository("prober") under IMAGE_REGISTRY; see //bazel/img:registry.bzl).
#
# Publish targets (OCI; registry from //bazel/img:registry.bzl):
#   bazel run //charts/prober:prober.push           # chart + image
#   bazel run //charts/prober:prober.push_registry  # chart only
# Authenticate first via HELM_REGISTRY_USERNAME / HELM_REGISTRY_PASSWORD.
helm_chart(
    name = "prober",
    chart = "Chart.yaml",
    images = [
        "//prober/cmd/prober:image_push",
    ],
    login_url = IMAGE_REGISTRY,
    registry_url = chart_registry_url(),
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

helm_lint_test(
    name = "prober_lint_test",
    chart = ":prober",
)

helm_template_test(
    name = "prober_template_test",
    chart = ":prober",
)
