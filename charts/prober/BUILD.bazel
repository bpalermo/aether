load("@aether_registry//:registry.bzl", "chart_registry_url")
load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/helm:defs.bzl", "chart_push", "helm_mesh_names_test", "helm_pod_template_version_test", "helm_template_absent_test", "helm_template_fail_test", "helm_template_match_test")

# prober Helm chart (published to chart_registry_url("prober"); see @aether_registry//:registry.bzl).
#
# Publish targets (OCI; registry from @aether_registry//:registry.bzl), images first:
#   bazel run --stamp //charts/prober:prober.push_images   # the image, by digest
#   bazel run --stamp //charts/prober:prober.chart_push    # the chart
# Credentials: `docker login <registry>` (image_push and oras both read the
# Docker config).
helm_chart(
    name = "prober",
    chart = "Chart.yaml",
    images = [
        "//prober/cmd/prober:image_push",
    ],
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

# `helm push` cannot name the flat `chart-prober` repository (proposal 040), so
# the chart is pushed by chart_push, under its packaged `X.Y.Z-<full sha>`.
chart_push(
    name = "prober.chart_push",
    chart_name = "prober",
    package = ":prober",
    repository = chart_registry_url("prober"),
)

helm_lint_test(
    name = "prober_lint_test",
    chart = ":prober",
)

helm_template_test(
    name = "prober_template_test",
    chart = ":prober",
)

# --- Who creates the namespace (#1405) ----------------------------------------
#
# The same rule as //charts/aether (#1403): Helm stores the release record in
# the release namespace before it creates anything the chart renders, so
# namespace.create=true can only create a namespace the release is NOT stored
# in. These renders have no cluster (`lookup` finds nothing), so they cover a
# first install; a live Namespace the release already owns keeps being rendered.

# The default: no Namespace.
helm_template_absent_test(
    name = "prober_namespace_default_not_rendered_test",
    absent = ["kind: Namespace"],
    chart = ":prober",
    control = "kind: DaemonSet",
    opts = [
        "--namespace",
        "aether-test",
    ],
)

# The combination no helm command can install fails the render, naming the ways
# out.
[
    helm_template_fail_test(
        name = "prober_namespace_create_release_namespace_fails_%s_test" % part,
        chart = ":prober",
        expected_message = message,
        opts = [
            "--namespace",
            "aether-test",
            "--set",
            "namespace.create=true",
        ],
    )
    for part, message in [
        ("reason", "namespace.create=true cannot create \"aether-test\": it is the namespace this release is stored in"),
        ("way_out_default", "leave namespace.create at its default (false) and pass --create-namespace"),
        ("way_out_elsewhere", "store the release in another namespace"),
    ]
]

# The one case it works: the release is stored somewhere else. The Namespace
# carries helm.sh/resource-policy: keep, so turning namespace.create off again
# cannot make Helm delete the namespace and the pods in it.
helm_template_match_test(
    name = "prober_namespace_create_other_release_namespace_test",
    chart = ":prober",
    document_patterns = {
        "Namespace/aether-test": [
            "\\nkind: Namespace\\nmetadata:\\n  name: aether-test\\n  annotations:\\n    helm\\.sh/resource-policy: keep\\n  labels:\\n",
            "\\n    app\\.kubernetes\\.io/managed-by: Helm\\n",
        ],
        "DaemonSet/release-name-prober": ["\\nmetadata:\\n  name: release-name-prober\\n  namespace: aether-test\\n"],
    },
    opts = [
        "--namespace",
        "releases",
        "--set",
        "namespace.create=true",
        "--set",
        "namespace.name=aether-test",
    ],
)

# The ServiceAccount records whether the render included the Namespace, for the
# next upgrade to read back (prober.namespace.assertUpgradeKeeps; the reasoning
# is with //charts/aether:aether_namespace_rendered_marker_default_test).
[
    helm_template_match_test(
        name = "prober_namespace_rendered_marker_%s_test" % name,
        chart = ":prober",
        document_patterns = {
            "ServiceAccount/release-name-prober": [
                "\\n    aether\\.io/release-namespace-rendered: \"%s\"" % rendered,
            ],
        },
        opts = opts,
    )
    for name, rendered, opts in [
        (
            "default",
            "false",
            [
                "--namespace",
                "aether-test",
            ],
        ),
        (
            "created",
            "true",
            [
                "--namespace",
                "releases",
                "--set",
                "namespace.create=true",
                "--set",
                "namespace.name=aether-test",
            ],
        ),
    ]
]

# 2026-10-04 (aether agent OOMKills): GOMEMLIMIT must sit BELOW the cgroup
# limit, never equal to it (`resourceFieldRef: limits.memory` was the whole
# limit). prober.goMemLimit renders 90% as an integer byte count, pinned
# exactly: 64Mi = 67108864 -> 60397977; 128Mi = 134217728 -> 120795955.
helm_template_test(
    name = "prober_gomemlimit_test",
    chart = ":prober",
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            "limits:\\n\\s+memory: 64Mi\\n",
            "- name: GOMEMLIMIT\\n\\s+value: \"60397977\"\\n",
        ],
    },
)

helm_template_test(
    name = "prober_gomemlimit_override_test",
    chart = ":prober",
    opts = [
        "--set",
        "resources.limits.memory=128Mi",
    ],
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            "- name: GOMEMLIMIT\\n\\s+value: \"120795955\"\\n",
        ],
    },
)

helm_template_absent_test(
    name = "prober_gomemlimit_no_limit_test",
    absent = [
        "name: GOMEMLIMIT",
        "resource: limits.memory",
    ],
    chart = ":prober",
    control = "name: OTEL_RESOURCE_ATTRIBUTES",
    opts = [
        "--set",
        "resources.limits.memory=null",
    ],
)

# #1361: the prober container's resources render through prober.resources, not
# plain `toYaml`, which rendered `cpu: ""` for `--set resources.limits.cpu=`
# (the apiserver rejects that as a quantity). The block is the last thing in the
# DaemonSet, so each pattern is anchored on the securityContext line before it.
PROBER_PRE = "drop:\\n\\s+- ALL\\n\\s+resources:\\n"

PROBER_NO_CPU_LIMIT = PROBER_PRE + "\\s+limits:\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\s*$"

# Guard: the default is a memory limit and no CPU limit (#735).
helm_template_test(
    name = "prober_default_resources_test",
    chart = ":prober",
    template_patterns = {
        "prober/templates/daemonset.yaml": [PROBER_NO_CPU_LIMIT],
    },
)

# An EMPTY limits.cpu is "no CPU limit": the key is dropped.
helm_template_test(
    name = "prober_empty_cpu_limit_test",
    chart = ":prober",
    opts = [
        "--set",
        "resources.limits.cpu=",
    ],
    template_patterns = {
        "prober/templates/daemonset.yaml": [PROBER_NO_CPU_LIMIT],
    },
)

# An emptied request is dropped the same way.
helm_template_test(
    name = "prober_empty_cpu_request_test",
    chart = ":prober",
    opts = [
        "--set",
        "resources.requests.cpu=",
    ],
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            PROBER_PRE + "\\s+limits:\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+memory: 32Mi\\s*$",
        ],
    },
)

# Guard: a CPU limit the operator sets still renders.
helm_template_test(
    name = "prober_cpu_limit_override_test",
    chart = ":prober",
    opts = [
        "--set",
        "resources.limits.cpu=1",
    ],
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            PROBER_PRE + "\\s+limits:\\n\\s+cpu: 1\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\s*$",
        ],
    },
)

# #1362: the two authz-canary containers take their resources from values
# (authzCanary.echo.resources, authzCanary.resources) through prober.resources;
# they were literals. Both blocks are followed by the same securityContext, so
# each pattern is anchored on the line BEFORE its block: the echo container's
# preStop `seconds: 5`, the curl container's script ending in `done`.
#
# These are helm_template_match_test, not helm_template_test: authz-canary.yaml
# renders five documents, and rules_helm's `template_patterns` only ever search
# the one helm prints last for a template (the HTTPFilter), never the two
# Deployments. helm_template_match_test searches the whole render.
AUTHZ_CANARY_OPTS = [
    "--set",
    "authzCanary.enabled=true",
]

AUTHZ_ECHO_PRE = "seconds: 5\\n\\s+resources:\\n"

AUTHZ_CURL_PRE = "done\\n\\s+resources:\\n"

AUTHZ_CANARY_POST = "\\s+securityContext:\\n\\s+allowPrivilegeEscalation: false\\n"

AUTHZ_ECHO_DEFAULT = AUTHZ_ECHO_PRE + "\\s+limits:\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+cpu: 10m\\n\\s+memory: 32Mi\\n" + AUTHZ_CANARY_POST

AUTHZ_CURL_DEFAULT = AUTHZ_CURL_PRE + "\\s+limits:\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+cpu: 10m\\n\\s+memory: 16Mi\\n" + AUTHZ_CANARY_POST

# The defaults are the former literals.
helm_template_match_test(
    name = "prober_authz_canary_default_resources_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    patterns = [
        AUTHZ_ECHO_DEFAULT,
        AUTHZ_CURL_DEFAULT,
    ],
)

# An emptied CPU limit renders no `cpu` key, per container. The other
# container's block must stay at its default.
helm_template_match_test(
    name = "prober_authz_echo_empty_cpu_limit_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.echo.resources.limits.cpu=",
    ],
    patterns = [
        AUTHZ_ECHO_DEFAULT,
        AUTHZ_CURL_DEFAULT,
    ],
)

helm_template_match_test(
    name = "prober_authz_curl_empty_cpu_limit_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.resources.limits.cpu=",
    ],
    patterns = [
        AUTHZ_ECHO_DEFAULT,
        AUTHZ_CURL_DEFAULT,
    ],
)

# An emptied request is dropped too (on the literals it could not be removed).
helm_template_match_test(
    name = "prober_authz_echo_empty_cpu_request_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.echo.resources.requests.cpu=",
    ],
    patterns = [
        AUTHZ_ECHO_PRE + "\\s+limits:\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+memory: 32Mi\\n" + AUTHZ_CANARY_POST,
        AUTHZ_CURL_DEFAULT,
    ],
)

helm_template_match_test(
    name = "prober_authz_curl_empty_cpu_request_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.resources.requests.cpu=",
    ],
    patterns = [
        AUTHZ_ECHO_DEFAULT,
        AUTHZ_CURL_PRE + "\\s+limits:\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+memory: 16Mi\\n" + AUTHZ_CANARY_POST,
    ],
)

# A value the operator sets renders, on the container it was set for only.
helm_template_match_test(
    name = "prober_authz_echo_resources_override_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.echo.resources.limits.cpu=200m",
        "--set",
        "authzCanary.echo.resources.requests.memory=48Mi",
    ],
    patterns = [
        AUTHZ_ECHO_PRE + "\\s+limits:\\n\\s+cpu: 200m\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+cpu: 10m\\n\\s+memory: 48Mi\\n" + AUTHZ_CANARY_POST,
        AUTHZ_CURL_DEFAULT,
    ],
)

helm_template_match_test(
    name = "prober_authz_curl_resources_override_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.resources.limits.cpu=100m",
        "--set",
        "authzCanary.resources.requests.memory=24Mi",
    ],
    patterns = [
        AUTHZ_ECHO_DEFAULT,
        AUTHZ_CURL_PRE + "\\s+limits:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+cpu: 10m\\n\\s+memory: 24Mi\\n" + AUTHZ_CANARY_POST,
    ],
)

# #1372: no pod template depends on the chart version or the appVersion. The
# prober DaemonSet's pod template carried `helm.sh/chart: prober-<version>` and
# `app.kubernetes.io/version` (prober.labels), and this chart's version carries
# the commit, so every release rolled every prober pod. The same test asserts
# each workload OBJECT still carries `helm.sh/chart: prober-<version>`.
helm_pod_template_version_test(
    name = "prober_pod_template_version_test",
    chart = ":prober",
    workloads = 1,
)

# ...with the authz canary's two Deployments rendered too.
helm_pod_template_version_test(
    name = "prober_pod_template_version_authz_canary_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    workloads = 3,
)

# #1372: what the pod template carries instead, exactly: the three selector
# labels, part-of, managed-by and the mesh-injection label. Positional: the
# pattern starts at `template:` -> `metadata:` -> `labels:` and ends at the key
# that follows the labels.
helm_template_test(
    name = "prober_pod_labels_test",
    chart = ":prober",
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            "\\n  template:\\n    metadata:\\n      labels:" +
            "\\n        app.kubernetes.io/name: prober" +
            "\\n        app.kubernetes.io/instance: \\S+" +
            "\\n        app.kubernetes.io/component: prober" +
            "\\n        app.kubernetes.io/part-of: aether" +
            "\\n        app.kubernetes.io/managed-by: Helm" +
            "\\n(\\s+#[^\\n]*\\n)+        aether.io/managed: \"true\"\\n      annotations:",
        ],
    },
)

# #1372 guard: a selector is immutable on upgrade, so the DaemonSet's stays
# exactly the three labels it was and never gains a version-carrying one.
# Positional: `matchLabels:` is followed by the three labels and then by a key
# one level up. The prober's own objects keep `component: prober` on their
# metadata (#1373 moves only the canary objects off it).
helm_template_test(
    name = "prober_selector_labels_test",
    chart = ":prober",
    template_patterns = {
        "prober/templates/daemonset.yaml": [
            "\\n  selector:\\n    matchLabels:\\n      app.kubernetes.io/name: prober" +
            "\\n      app.kubernetes.io/instance: \\S+\\n      app.kubernetes.io/component: prober\\n  \\S",
            "kind: DaemonSet\\nmetadata:\\n  name: \\S+\\n  namespace: \\S+\\n  labels:\\n    helm.sh/chart: prober-\\S+" +
            "\\n    app.kubernetes.io/name: prober\\n    app.kubernetes.io/instance: \\S+\\n    app.kubernetes.io/component: prober\\n",
        ],
        "prober/templates/serviceaccount.yaml": [
            "\\n    app.kubernetes.io/component: prober\\n",
        ],
    },
)

# #1372/#1373 guard: the two canary Deployments select on `app` alone, and their
# pod templates carry `app` and the mesh-injection label and nothing else. A
# Deployment's selector is immutable, and no label change may reach these pods.
helm_template_match_test(
    name = "prober_authz_canary_selectors_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    patterns = [
        "\\n  selector:\\n    matchLabels: \\{app: " + app + "\\}\\n  template:\\n    metadata:\\n      labels:" +
        "\\n        app: " + app + "\\n        aether.io/managed: \"true\"\\n      annotations:"
        for app in [
            "authz-echo",
            "authz-canary",
        ]
    ],
)

# #1373: the five authz-canary objects carry their own component on their
# metadata. They used prober.labels, so `-l app.kubernetes.io/component=prober`
# (the prober DaemonSet's selector labels) counted them as the prober. Each
# pattern names one object by kind and name; `name` and `instance` stay the
# release's.
helm_template_match_test(
    name = "prober_authz_canary_labels_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    patterns = [
        "kind: " + kind + "\\nmetadata:\\n  name: " + name + "\\n  namespace: \\S+\\n  labels:" +
        "\\n    helm.sh/chart: prober-\\S+" +
        "\\n    app.kubernetes.io/name: prober" +
        "\\n    app.kubernetes.io/instance: \\S+" +
        "\\n    app.kubernetes.io/component: authz-canary" +
        "\\n    app.kubernetes.io/part-of: aether" +
        "\\n    app.kubernetes.io/managed-by: Helm\\n"
        for kind, name in [
            ("ServiceAccount", "authz-canary"),
            ("ServiceAccount", "authz-echo"),
            ("Deployment", "authz-echo"),
            ("HTTPFilter", "authz-canary"),
            ("Deployment", "authz-canary"),
        ]
    ],
)

# Guard: with the canary off (the default) none of its objects render.
helm_template_absent_test(
    name = "prober_authz_canary_off_test",
    absent = [
        "authz-canary",
        "authz-echo",
        "curlimages",
    ],
    chart = ":prober",
    control = "kind: DaemonSet",
)

# #1374: the canary's client image is pinned by digest, like its echo image (a
# tag can be re-pushed). Anchored on the container name before it and the
# `command:` line after it.
helm_template_match_test(
    name = "prober_authz_canary_image_digest_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    patterns = [
        "\\n        - name: curl\\n          image: \"curlimages/curl@sha256:[0-9a-f]{64}\"\\n          command:",
    ],
)

# Guard: an image the operator sets renders as given.
helm_template_match_test(
    name = "prober_authz_canary_image_override_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS + [
        "--set",
        "authzCanary.image=registry.example/curl:1",
    ],
    patterns = [
        "\\n        - name: curl\\n          image: \"registry.example/curl:1\"\\n          command:",
    ],
)

# #1589: the mesh label and the mesh annotations on this chart's own pods are
# literals in the templates. This compares them with the Go constants the CNI,
# the agent and the webhook read, over every workload the chart can render
# (the rule's documentation lists the symbols).
helm_mesh_names_test(
    name = "prober_mesh_names_test",
    chart = ":prober",
    opts = AUTHZ_CANARY_OPTS,
    workloads = {
        # The default targets give the DaemonSet its upstreams.
        "DaemonSet/release-name-prober": ["upstreams"],
        "Deployment/authz-canary": ["upstreams=authz-echo"],
        "Deployment/authz-echo": ["endpoint_port=8080"],
    },
)
