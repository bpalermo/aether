load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/helm:defs.bzl", "chart_push")
load("//bazel/img:registry.bzl", "chart_registry_url")

# crds Helm chart (published to chart_registry_url("crds"); see //bazel/img:registry.bzl).
#
# Standalone CRD chart so the CRDs can be installed/upgraded ahead of the
# controllers. See docs/proposals/015_mesh-config.md.
#
# Publish target (OCI; registry from //bazel/img:registry.bzl):
#   bazel run --stamp //charts/crds:crds.chart_push
# Credentials: `docker login <registry>` (oras reads the Docker config).
helm_chart(
    name = "crds",
    chart = "Chart.yaml",
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

# `helm push` cannot name the flat `chart-crds` repository (proposal 040), so
# the chart is pushed by chart_push, under its packaged `X.Y.Z-<full sha>`.
chart_push(
    name = "crds.chart_push",
    chart_name = "crds",
    package = ":crds",
    repository = chart_registry_url("crds"),
)

helm_lint_test(
    name = "crds_lint_test",
    chart = ":crds",
)

helm_template_test(
    name = "crds_template_test",
    chart = ":crds",
)
