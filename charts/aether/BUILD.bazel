# --- The SPIRE-served webhook's identity registration (#1457) ------------------
#
# With controller.webhook.spire=true the controller serves the webhooks with
# its SVID, which the apiserver accepts only when it carries the webhook
# Service's DNS names. The chart registers that (a ClusterSPIFFEID) when it is
# given the spire-controller-manager class to register it with. With
# clusterSpiffeID.create=true (the default) and no className it rendered
# nothing and said nothing.

#
# One helper decides all of it: `aether.controller.webhookIdentity` is "",
# "chart", "operator" or "unregistered", and the ClusterSPIFFEID template, the
# render failure and the WEBHOOK IDENTITY NOTE of NOTES.txt read that result
# and nothing else. The tests below render each of the four through the
# template and the failure.
#
# THE NOTE ITSELF IS IN NO TEST. The rules of //bazel/helm run `helm template`,
# and the pinned Helm (4.2.0) has no flag that makes `helm template` print
# NOTES.txt; only `helm install --dry-run` prints it. A test of the note needs
# the runners to drive another subcommand, with a kubeconfig that cannot reach
# a cluster and the fail-closed mask applied to that command's different
# output: a new mode of those rules, not an option passed through. So what is
# held is the decision the note reads, not that the note is still printed or
# what it says.

SPIRE_CRD_API = "spire.spiffe.io/v1alpha1/ClusterSPIFFEID"

# Class given: the registration, with both DNS names of the webhook Service.
helm_template_match_test(
    name = "aether_controller_clusterspiffeid_test",
    chart = ":aether",
    document_patterns = {
        "ClusterSPIFFEID/release-name-aether-controller-webhook": [
            "\\nspec:\\n  className: \"spire-mgmt-spire\"\\n",
            "\\n  dnsNameTemplates:\\n    - \"release-name-aether-controller-webhook\\.default\\.svc\"\\n    - \"release-name-aether-controller-webhook\\.default\\.svc\\.cluster\\.local\"\\n",
        ],
    },
    opts = [
        "--set",
        "controller.webhook.spire=true",
        "--set",
        "controller.webhook.clusterSpiffeID.className=spire-mgmt-spire",
        "--api-versions",
        SPIRE_CRD_API,
    ],
)

# No class, on a cluster that serves the ClusterSPIFFEID API: the chart was
# asked to create the registration, could, and has nothing to create it with.
helm_template_fail_test(
    name = "aether_controller_clusterspiffeid_no_class_fail_test",
    chart = ":aether",
    expected_message = "controller.webhook.clusterSpiffeID.className is empty",
    opts = [
        "--set",
        "controller.webhook.spire=true",
        "--api-versions",
        SPIRE_CRD_API,
    ],
)

# "I register the controller's identity myself": create=false renders, with no
# ClusterSPIFFEID, on the same cluster.
helm_template_absent_test(
    name = "aether_controller_clusterspiffeid_self_managed_test",
    absent = ["kind: ClusterSPIFFEID"],
    chart = ":aether",
    control = "kind: ValidatingWebhookConfiguration",
    opts = [
        "--set",
        "controller.webhook.spire=true",
        "--set",
        "controller.webhook.clusterSpiffeID.create=false",
