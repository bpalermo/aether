# udsCsi.goMaxProcs=0 hands GOMAXPROCS back to the Go runtime: no env var.
helm_template_absent_test(
    name = "aether_uds_csi_gomaxprocs_off_test",
    absent = [
        "name: GOMAXPROCS",
    ],
    chart = ":aether",
    control = "name: NODE_NAME",
    opts = [
        "--show-only",
        "templates/uds-csi-daemonset.yaml",
        "--set",
        "udsCsi.goMaxProcs=0",
    ],
)

# #1335: cni-install (the agent pod's init container, on every agent pod start)
# keeps its 100m CPU request and has NO CPU limit. Its work is at most 50-80 ms
# of CPU (byte-comparing the plugin already on the host with the one in the
# image); under a 100m quota -- 10 ms per 100 ms period -- that took 500-800 ms
# on all 40 agent starts measured, always a multiple of ~100 ms. Positional on the init container:
# its resources block is followed directly by the pod's `containers:` (the
# agent container's is followed by `volumes:`), and `limits:` carrying only
# memory proves there is no limits.cpu.
CNI_INSTALL_NO_CPU_LIMIT = "resources:\\n\\s+limits:\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\n\\s+containers:\\n"

helm_template_test(
    name = "aether_cni_install_cpu_resources_test",
    chart = ":aether",
    opts = [
        "--set",
        "controller.webhook.spire=true",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            CNI_INSTALL_NO_CPU_LIMIT,
        ],
    },
)

# An EMPTY limits.cpu is "no CPU limit" too: it is dropped (aether.resources),
# never rendered as `cpu: ""` (which the apiserver rejects as a quantity).
helm_template_test(
    name = "aether_cni_install_empty_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set",
