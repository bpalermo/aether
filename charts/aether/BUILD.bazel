# #1584: the agent's per-pod listener stat prefixes are inbound_<namespace>_<pod>
# and out_http_<namespace>_<pod>, and the proxy bootstrap lifts BOTH parts out
# of the stat name: aether.namespace takes the text up to the first underscore
# after the prefix, aether.pod the rest. Without the first tag the namespace
# stays in aether.pod; without either, every pod is a metric family of its own.
# The namespace part is optional in the aether.pod extractor, so the prefixes an
# agent older than #1584 writes (inbound_<pod>) still collapse during an upgrade.
#
# REMOVE IN CHART 2.6.0: that optional group, "(?:_[^_.]+)?", is the skew
# tolerance of chart 2.5.0 (#1634) and lasts one chart minor (charts/README.md,
# "Compatibility window"). In 2.6.0 the aether.pod pattern below loses the
# group, the template comment that explains it goes, and so does the old-agent
# case of TestChartStatsConfigOnNamespacedPodNames. Not earlier, and not as a
# comment-only edit of the template in a 2.5.x chart: every byte of the
# rendered bootstrap that changes hot-restarts every Envoy on upgrade, which is
# why this note is here and not beside the regex.
# //agent/test/envoy_validate (TestChartStatsConfigOnNamespacedPodNames) runs
# the pinned proxy with this block and reads the labels it exports; this pins
# the two extractors in the packaged chart. The same block's exclusions must
# never match the membership gauges of the health_ and inboundready_ clusters
# (the health gateway reads them), which that test checks on the proxy too.
helm_template_test(
    name = "aether_proxy_bootstrap_pod_stats_tags_test",
    chart = ":aether",
    opts = [
        "--set",
        "controller.webhook.spire=true",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-configmap.yaml": [
            "- tag_name: aether\\.namespace\\n\\s+regex: \"\\^listener.{1,4}\\(\\?:inbound\\|out_http\\)\\(_\\(\\[\\^_\\.\\]\\+\\)\\)_\\[\\^\\.\\]\\+.{1,4}\"\\n",
            "- tag_name: aether\\.pod\\n\\s+regex: \"\\^listener.{1,4}\\(\\?:inbound\\|out_http\\)\\(\\?:_\\[\\^_\\.\\]\\+\\)\\?\\(_\\(\\[\\^\\.\\]\\+\\)\\).{1,4}\"\\n",
        ],
    },
)

# #1636: a guard for what the agent now relies on. The exclusions of the probe
# clusters' dead subtrees read a stat name up to its FIRST dot as the cluster
# ("health_[^.]*", "inboundready_[^.]*"), and the agent keeps the dots of a pod
# name out of those clusters' stat names (alt_stat_name with '~' for each dot),
# so that part is the whole cluster and the alternation is matched against the
# stat alone. The health gateway reads the clusters' membership gauges: an
# exclusion that matches them answers 503 for the pod (the 2026-06-11 outage).
# //agent/test/envoy_validate (TestChartStatsConfigOnDottedPodNames,
# TestHealthGatewayAnswersForADottedPod) runs the pinned proxy with the block;
# this pins both patterns in the packaged chart, alternatives included, so a
# change of either is made on purpose and with that test in view.
#
# Do not make the bootstrap accept the dots instead: where a dotted pod name
# ends and the stat begins can only be told with a list of every stat and
# subtree name Envoy has ("ssl", "http2", "external" and "default" are all
# legal labels of a pod name). The template itself is left as it was by #1636,
# comments included: the supervisor watches the bootstrap, so any change of
# that ConfigMap hot-restarts the proxy on every node.
helm_template_test(
    name = "aether_proxy_bootstrap_probe_cluster_exclusions_test",
    chart = ":aether",
    opts = [
        "--set",
        "controller.webhook.spire=true",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-configmap.yaml": [
            "- safe_regex:\\n\\s+regex: \"\\^cluster.{1,4}health_\\[\\^\\.\\]\\*.{1,4}\\(upstream_\\|lb_\\|retry\\|external\\|circuit_breakers\\|http1\\|http2\\|max_host_weight\\|assignment\\|bind_\\|original_dst\\|default.{1,4}total_match\\)\\.\\*\"\\n",
            "- safe_regex:\\n\\s+regex: \"\\^cluster.{1,4}inboundready_\\[\\^\\.\\]\\*.{1,4}\\(upstream_\\|lb_\\|retry\\|external\\|circuit_breakers\\|http1\\|http2\\|max_host_weight\\|assignment\\|bind_\\|original_dst\\|default.{1,4}total_match\\)\\.\\*\"\\n",
        ],
    },
)

