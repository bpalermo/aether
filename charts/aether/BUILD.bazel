# 2026-10-04 soak: agents OOMKilled at a 64Mi limit. GOMEMLIMIT came from
# `resourceFieldRef: limits.memory` (divisor 1) -- the WHOLE cgroup limit -- so
# the Go heap could fill the cgroup before the GC tightened, and the /agent-ready
# exec probe processes (proposal 041) charged to the same cgroup tipped it over.
# GOMEMLIMIT is now a literal integer byte count at 90% of limits.memory
# (aether.goMemLimit), pinned EXACTLY below, which is what makes it numeric and
# strictly below the limit:
#   agent      128Mi = 134217728 -> 120795955 (115.2Mi)
#   agent      256Mi = 268435456 -> 241591910 (override)
#   registrar   64Mi =  67108864 ->  60397977
#   controller  64Mi =  67108864 ->  60397977
#   edge       256Mi = 268435456 -> 241591910
helm_template_test(
    name = "aether_agent_gomemlimit_test",
    chart = ":aether",
    opts = [
        "--set",
        "controller.webhook.spire=true",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "requests:\\n\\s+cpu: 200m\\n\\s+memory: 96Mi\\n",
            "limits:\\n\\s+memory: 128Mi\\n",
            "- name: GOMEMLIMIT\\n\\s+value: \"120795955\"\\n",
        ],
    },
)

# An operator override moves GOMEMLIMIT with the limit, still at 90%.
helm_template_test(
    name = "aether_agent_gomemlimit_override_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.resources.limits.memory=256Mi",
        "--set",
