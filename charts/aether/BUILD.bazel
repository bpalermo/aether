# The same trap one namespace over: a release stored in the edge namespace
# cannot create it either.
helm_template_fail_test(
    name = "aether_edge_namespace_release_namespace_fails_test",
    chart = ":aether",
    expected_message = "edge.namespaceCreate=true cannot create \"aether-ingress\": it " + NAMESPACE_CONFLICT,
    opts = [
        "--namespace",
        "aether-ingress",
        "--set",
        "edge.enabled=true",
    ],
)

# --- #1471: the seeded MeshConfig is a hook, not a release object -------------
#
# The chart seeds a `default` MeshConfig once (a `lookup` skips it when one is
# live) and never renders it again, so operators own it. As a release object it
# was in the manifest of the ONE revision that seeded it and of no other, while
# staying live (`helm.sh/resource-policy: keep`). `helm rollback` to that
# revision (normally the first one of a release; a later one when the object
# was absent on an upgrade) then failed with `no MeshConfig
# with the name "default" found`: Helm updates an object that is live and in
# the target manifest from the current manifest's copy, and there is none. A
# hook is in no revision's manifest, so no rollback ever meets it.
#
# The annotations block is matched whole, up to `spec:`, because every line of
# it is a decision:
#   - `pre-`: the agent pod stays in ContainerCreating until the controller has
#     projected the MeshConfig into a ConfigMap, so a `post-install` hook would
#     never run under `--wait`;
#   - `pre-upgrade` too: a MeshConfig that is absent on an upgrade (a first
#     install that failed, `meshConfig.createDefault` or `edge.enabled` turned
#     on later, a deleted object) is seeded then, as before;
#   - NO rollback event: Helm runs the TARGET revision's stored hooks on a
#     rollback. A seed stored with a rollback event would be created, or
#     applied, over the operator's MeshConfig;
#   - `helm.sh/hook-delete-policy: never`. `never` is NOT a policy Helm knows,
#     and that is the point: a hook with no policy gets `before-hook-creation`,
#     so Helm deletes whatever MeshConfig is live just before it creates the
#     seed. The `lookup` and the hook are not atomic: an object created in
#     between (measured on kind, Helm 3.18.4 and 4.2.0) was deleted and
#     replaced by the seed, and the upgrade reported success. Naming any policy
#     turns that default off. The two Helm does know are wrong here:
#     `hook-succeeded` deletes the seed it has just created, and `hook-failed`
#     deletes the object when the wait after the creation fails, which with
#     Helm 4's server-side apply can be the operator's object (measured). With
#     a value Helm does not act on, nothing is ever deleted: the upgrade fails
#     on "already exists" and running it again succeeds. Under Helm 4's
#     server-side apply the object is not deleted either, but the seed is
#     applied to it (labels, hook annotations, and any `meshConfig.proxy`
#     field the object does not set): not deleting is all this value
#     guarantees. `aether.meshConfig.seedMode`
#     has the table; `e2e/first-install.sh` (leg v-a2) fails if a Helm ever
#     deletes on this value;
#   - no weight.
MESHCONFIG_SEED_HOOK_ANNOTATIONS = "    helm\\.sh/hook: pre-install,pre-upgrade\\n    helm\\.sh/hook-delete-policy: never\\n    helm\\.sh/resource-policy: keep\\n"

MESHCONFIG_SEED_HOOK = "\\n  annotations:\\n" + MESHCONFIG_SEED_HOOK_ANNOTATIONS + "spec:"

# The same object where a hook cannot be used (see the two "created namespace"
# tests below): what every chart before 2.4.24 rendered.
MESHCONFIG_SEED_RELEASE_OBJECT = "\\n  annotations:\\n    helm\\.sh/resource-policy: keep\\nspec:"

# Default values: one MeshConfig, in the release namespace, as a hook.
helm_template_match_test(
    name = "aether_meshconfig_seed_is_a_hook_test",
    chart = ":aether",
    document_patterns = {
        "MeshConfig/default": [
            "\\nkind: MeshConfig\\nmetadata:\\n  name: default\\n  namespace: aether-system\\n  labels:\\n",
            MESHCONFIG_SEED_HOOK + "\\n  proxy:\\n    \\{\\}",
        ],
    },
    opts = [
        "--namespace",
        "aether-system",
    ],
)

# An operator's seed (`meshConfig.proxy`) is what the hook creates.
helm_template_match_test(
    name = "aether_meshconfig_seed_hook_carries_the_seed_values_test",
    chart = ":aether",
    document_patterns = {
        "MeshConfig/default": [
            MESHCONFIG_SEED_HOOK + "\\n  proxy:\\n    accessLogsEnabled: true",
        ],
    },
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "meshConfig.proxy.accessLogsEnabled=true",
    ],
)

# The off switch renders no MeshConfig and no hook of any kind, with the edge
# on as well (the edge's own MeshConfig hangs off the same switch).
[
    helm_template_absent_test(
        name = "aether_meshconfig_seed_off_%s_test" % name,
        absent = [
            "kind: MeshConfig",
            "helm.sh/hook",
        ],
        chart = ":aether",
        control = "kind: DaemonSet",
        opts = [
            "--namespace",
            "aether-system",
            "--set",
            "meshConfig.createDefault=false",
        ] + extra,
    )
    for name, extra in [
        ("default", []),
        (
            "edge",
            [
                "--set",
                "edge.enabled=true",
            ],
        ),
    ]
]

# Guard: nothing else in the chart is a hook. A hook is outside the release
# (not upgraded, not rolled back, not uninstalled), which is right for an
# object the operator owns and wrong for everything else here. Rendered with
# every optional component, and with both namespaces created by the chart, so
# that the two seeds are release objects (the two "created namespace" tests
# below) and the render must hold no hook at all.
helm_template_absent_test(
    name = "aether_meshconfig_seed_is_the_only_hook_test",
    absent = ["helm.sh/hook"],
    chart = ":aether",
    control = "kind: MeshConfig",
    opts = [
        "--namespace",
        "releases",
        "--set",
        "namespace.create=true",
        "--set",
        "namespace.name=aether-system",
        "--set",
        "edge.enabled=true",
        "--set",
        "proxy.authzSidecar.enabled=true",
        "--set",
        "otel.enabled=true",
        "--set",
        "otel.endpoint=otel-collector.observability.svc:4317",
    ],
)

# Guard: a `pre-install` hook runs BEFORE the release's objects exist. Where the
# chart itself creates the namespace the MeshConfig goes into, and that
# namespace is not there yet, the hook would fail ("namespaces ... not found")
# and with it the install. That revision seeds the MeshConfig as a release
# object, as every chart before 2.4.24 did; `helm template` has no cluster to
# look the namespace up in, so it renders that case. (On a later revision the
# namespace is live and an absent MeshConfig is seeded by the hook.)
helm_template_match_test(
    name = "aether_meshconfig_seed_created_namespace_test",
    chart = ":aether",
    document_patterns = {
        "MeshConfig/default": [
            "\\nkind: MeshConfig\\nmetadata:\\n  name: default\\n  namespace: aether-system\\n  labels:\\n",
            MESHCONFIG_SEED_RELEASE_OBJECT + "\\n  proxy:\\n",
        ],
    },
    opts = [
        "--namespace",
        "releases",
        "--set",
        "namespace.create=true",
        "--set",
        "namespace.name=aether-system",
    ],
)

# The edge has a MeshConfig of its own, in the edge namespace. Two documents
# named MeshConfig/default, so these match the whole render and name the
# namespace; a label line is four spaces and no line break, so a pattern cannot
# run from one document into the next.
EDGE_MESHCONFIG = "\\nkind: MeshConfig\\nmetadata:\\n  name: default\\n  namespace: aether-ingress\\n  labels:\\n(    [^\\n]+\\n)+  annotations:\\n"

CONTROL_PLANE_MESHCONFIG = "\\nkind: MeshConfig\\nmetadata:\\n  name: default\\n  namespace: aether-system\\n  labels:\\n(    [^\\n]+\\n)+  annotations:\\n"

# With the edge namespace made by the operator (edge.namespaceCreate=false),
# both seeds are hooks.
helm_template_match_test(
    name = "aether_edge_meshconfig_seed_is_a_hook_test",
    chart = ":aether",
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "edge.enabled=true",
        "--set",
        "edge.namespaceCreate=false",
    ],
    patterns = [
        EDGE_MESHCONFIG + MESHCONFIG_SEED_HOOK_ANNOTATIONS + "spec: \\{\\}",
        CONTROL_PLANE_MESHCONFIG + MESHCONFIG_SEED_HOOK_ANNOTATIONS + "spec:\\n",
    ],
)

# With the edge namespace created by the chart (the default once the edge is
# on), a `pre-install` hook cannot seed the edge's MeshConfig (the guard above,
# one namespace over), so it is a release object. Seeded once, it was in that
# one revision's manifest only, and `helm rollback` to it failed under Helm 3
# as in #1471 (#1514). It is now an ORDINARY release object, rendered on every
# revision of a release whose edge namespace says so:
# `aether.io/edge-meshconfig-in-manifest` on the Namespace, stamped when the
# chart creates the namespace and read back with `lookup` afterwards
# (aether.edge.meshConfigInManifest). `helm template` has no cluster, so it
# renders the first revision: the marker on the Namespace, the MeshConfig as a
# release object with no hook annotation. The control plane's is still a hook.
# What the later revisions render needs a cluster: e2e/first-install.sh, leg
# viii.
helm_template_match_test(
    name = "aether_edge_namespace_marks_meshconfig_in_manifest_test",
    chart = ":aether",
    document_patterns = {
        "Namespace/aether-ingress": [
            "\\nmetadata:\\n  name: aether-ingress\\n  annotations:\\n    aether\\.io/edge-meshconfig-in-manifest: \"true\"\\n  labels:\\n",
        ],
    },
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "edge.enabled=true",
    ],
)

# Guard: no marker without a seed. With meshConfig.createDefault=false the
# namespace is created unmarked, so a seed turned on later is a hook (the
# namespace exists by then) and is in no manifest either.
helm_template_absent_test(
    name = "aether_edge_namespace_unmarked_without_seed_test",
    absent = [
        "aether.io/edge-meshconfig-in-manifest",
        "kind: MeshConfig",
    ],
    chart = ":aether",
    control = "pod-security.kubernetes.io/enforce: baseline",
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "edge.enabled=true",
        "--set",
        "meshConfig.createDefault=false",
    ],
)

# The MeshConfig carries the same marker as the Namespace, and either one is
# enough afterwards. Chart 2.4.24 renders the edge Namespace without the
# annotation, so an upgrade or a rollback through it takes the Namespace's
# marker off (measured, Helm 3.18.4); it does not render the live MeshConfig,
# so the MeshConfig's stays, and the next upgrade to this chart renders the
# MeshConfig again and marks the Namespace again (e2e/first-install.sh, leg
# viii-b).
helm_template_match_test(
    name = "aether_edge_meshconfig_seed_created_namespace_test",
    chart = ":aether",
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "edge.enabled=true",
    ],
    patterns = [
        EDGE_MESHCONFIG + "    aether\\.io/edge-meshconfig-in-manifest: \"true\"\\n    helm\\.sh/resource-policy: keep\\nspec: \\{\\}",
        CONTROL_PLANE_MESHCONFIG + MESHCONFIG_SEED_HOOK_ANNOTATIONS + "spec:\\n",
    ],
)

# --- What the telemetry resource says about the node proxy (#1561) ------------
#
# docs/observability/metric-labels.md is the operator's page for all of this.

OTEL_ON = [
    "--set",
    "otel.enabled=true",
    "--set",
    "otel.endpoint=otel-collector.observability.svc:4317",
]

# One `- name: OTEL_RESOURCE_ATTRIBUTES` entry and its whole value (%s, a
# regular expression). `$(VAR)` is the kubelet's expansion, not helm's: it is
# rendered as written.
RESOURCE_ATTRIBUTES = "\\n +- name: OTEL_RESOURCE_ATTRIBUTES\\n +value: \"%s\"\\n"

# Every workload's OTEL_RESOURCE_ATTRIBUTES, whole. A change here changes what
# a metrics backend stores, so it is made on purpose and with the rules.
#
# The proxy container's environment is the supervisor's too (one container, two
# exporters), so the node proxy's service.name is not set there (see
# :aether_proxy_stats_service_name_test).
#
# service.instance.id is the pod name on the Deployments whose replicas
# nothing else tells apart (#1560): the registrar and the controller (no node
# in their resource), and both containers of the edge (two replicas may share
# a node). Prometheus stores the attribute as `instance` by itself, so those
# replicas are separate series with no pipeline configuration; without it they
# wrote ONE series, and AetherRegistrarSnapshotDiverged, which compares hashes
# across replica series, could never fire.
#
# It comes with a cost the shipped rules pay: with the pod name in a label
# every roll starts a new set of series, and a pushed series has no staleness
# marker, so the terminated pod's last sample stays in the 5-minute lookback
# beside the new pod's. The rules that aggregate over these series
# (docs/observability/agent-pin-alerts.yml, registrar-alerts.yml) therefore
# read only a sample of the last 150 s, and their promtool tests hold the roll
# cases. Do not add the attribute to another workload without doing the same
# for the rules that read it.
#
# NOT on the per-node DaemonSets (agent, mesh-dns, node proxy): their series
# are told apart by the node, which is stable across a roll, and a pod-name
# label would start a new set of series per node on every roll. mesh-dns also
# has a datapoint attribute of its own called `instance`, on its exit counter,
# which a resource-made label would collide with.
helm_template_match_test(
    name = "aether_resource_attributes_test",
    chart = ":aether",
    document_patterns = {
        "DaemonSet/release-name-aether-agent": [
            RESOURCE_ATTRIBUTES % "k8s\\.node\\.name=\\$\\(NODE_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
        "DaemonSet/release-name-aether-mesh-dns": [
            RESOURCE_ATTRIBUTES % "k8s\\.node\\.name=\\$\\(NODE_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
        "DaemonSet/aether-proxy": [
            RESOURCE_ATTRIBUTES % "k8s\\.node\\.name=\\$\\(NODE_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.pod\\.uid=\\$\\(POD_UID\\)",
        ],
        "Deployment/release-name-aether-registrar": [
            RESOURCE_ATTRIBUTES % "service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
        "Deployment/release-name-aether-controller": [
            RESOURCE_ATTRIBUTES % "service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
        # Its two containers: the edge control plane, then the edge proxy.
        "Deployment/release-name-aether-edge": [
            RESOURCE_ATTRIBUTES % "service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.node\\.name=\\$\\(NODE_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.pod\\.uid=\\$\\(POD_UID\\),k8s\\.deployment\\.name=release-name-aether-edge",
            RESOURCE_ATTRIBUTES % "service\\.name=aether-edge-proxy,service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.node\\.name=\\$\\(NODE_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.pod\\.uid=\\$\\(POD_UID\\),k8s\\.deployment\\.name=release-name-aether-edge",
        ],
    },
    opts = OTEL_ON + [
        "--set",
        "edge.enabled=true",
    ],
)

# ...and with default values too: the attribute does not depend on otel.* (the
# variable is rendered whether or not anything is exported), so there is no
# off switch, and the registrar and the controller roll once on the upgrade
# that crosses 2.5.3 on every install. The edge is off by default.
helm_template_match_test(
    name = "aether_replica_instance_id_default_values_test",
    chart = ":aether",
    document_patterns = {
        "Deployment/release-name-aether-registrar": [
            RESOURCE_ATTRIBUTES % "service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
        "Deployment/release-name-aether-controller": [
            RESOURCE_ATTRIBUTES % "service\\.instance\\.id=\\$\\(POD_NAME\\),k8s\\.pod\\.name=\\$\\(POD_NAME\\),k8s\\.namespace\\.name=\\$\\(POD_NAMESPACE\\)",
        ],
    },
)

# #1561: the node proxy's Envoy stats name their service in the BOOTSTRAP: a
# static resource detector after the environment one, so its service.name is
# the one that is exported (Envoy merges detectors in order, the later one
# winning). Not through the container's environment, which the supervisor in
# the same container reads as well: OTEL_SERVICE_NAME there would rename the
# supervisor's metrics to the proxy's.
helm_template_match_test(
    name = "aether_proxy_stats_service_name_test",
    chart = ":aether",
    document_patterns = {
        "ConfigMap/aether-proxy-config": [
            "\\n          resource_detectors:\\n" +
            "            - name: envoy\\.tracers\\.opentelemetry\\.resource_detectors\\.environment\\n" +
            "              typed_config:\\n" +
            "                \"@type\": type\\.googleapis\\.com/envoy\\.extensions\\.tracers\\.opentelemetry\\.resource_detectors\\.v3\\.EnvironmentResourceDetectorConfig\\n" +
            "(            #[^\\n]*\\n)*" +
            "            - name: envoy\\.tracers\\.opentelemetry\\.resource_detectors\\.static_config\\n" +
            "              typed_config:\\n" +
            "                \"@type\": type\\.googleapis\\.com/envoy\\.extensions\\.tracers\\.opentelemetry\\.resource_detectors\\.v3\\.StaticConfigResourceDetectorConfig\\n" +
            "                attributes:\\n" +
            "                  service\\.name: aether-proxy\\n" +
            "          prefix: envoy\\n",
        ],
    },
    opts = OTEL_ON,
)

# ...and nothing in the chart names a service through the environment, for any
# container, with every optional workload rendered.
helm_template_absent_test(
    name = "aether_no_otel_service_name_env_test",
    # The env entry, not the bare word: the bootstrap's comment says why it is
    # absent.
    absent = ["name: OTEL_SERVICE_NAME"],
    chart = ":aether",
    control = "name: OTEL_RESOURCE_ATTRIBUTES",
    opts = OTEL_ON + [
        "--set",
        "edge.enabled=true",
        "--set",
        "proxy.authzSidecar.enabled=true",
    ],
)

# The off switch: without otel.endpoint the bootstrap has no stats sink, so no
# detector either. Upgrading a mesh that exports nothing changes no bootstrap
# and restarts no Envoy.
helm_template_absent_test(
    name = "aether_proxy_stats_sink_off_test",
    absent = [
        "stats_sinks:",
        "resource_detectors:",
        "envoy.stat_sinks.open_telemetry",
    ],
    chart = ":aether",
    control = "name: aether-proxy-config",
)

# Commit-pinned second packaging of the SAME chart (#692).
#
# chart_push tags with the packaged chart's `version:`, so the chart above
# publishes under the bare `<X.Y.Z>` tag — a tag that does not change per
# commit. Two publish runs therefore used to write it in
# whatever order they finished, and on 2026-09-05 the older commit's chart won.
# `publish.yaml` is now serialised, which makes the bare tag last-writer-correct;
# this target additionally makes every commit's chart addressable by a tag that
# can never be reused: `<X.Y.Z>-<full git sha>`, the same scheme the
# crds/prober/udsecho charts already carry in their own `Chart.yaml`.
#
# The version suffix is *derived* from Chart.yaml rather than duplicated, so the
# bare tag and the commit tag can never disagree about X.Y.Z.
#
# Only `:aether_commit.chart_push` (chart, no images) is published — the images
# are byte-identical to the ones `:aether.push_images` already pushed by digest.
genrule(
    name = "chart_commit_yaml",
    srcs = ["Chart.yaml"],
    outs = ["Chart.commit.yaml"],
    # `{GIT_COMMIT}` is a workspace-status placeholder that rules_helm substitutes
    # at package time on --stamp builds (bazel/workspace_status.sh: full 40-char
    # sha). Emitting it literally here is the point.
    # The trailing `grep` fails the build if Chart.yaml's version line ever stops
    # matching the pattern, rather than silently republishing the bare version
    # under a second name.
    cmd = "sed -E 's/^(version:[[:space:]]*\"[0-9]+\\.[0-9]+\\.[0-9]+)\"$$/\\1-{GIT_COMMIT}\"/'" +
          " $(execpath Chart.yaml) > $@ && grep -q -- '-{GIT_COMMIT}\"$$' $@",
)

helm_chart(
    name = "aether_commit",
    chart = ":Chart.commit.yaml",
    files = AETHER_FILES,
    images = AETHER_IMAGES,
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

chart_push(
    name = "aether_commit.chart_push",
    chart_name = "aether",
    package = ":aether_commit",
    repository = chart_registry_url("aether"),
)

helm_lint_test(
    name = "aether_commit_lint_test",
    chart = ":aether_commit",
)
