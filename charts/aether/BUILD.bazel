helm_template_test(
    name = "aether_proxy_no_limits_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.resources.limits.memory=",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "failureThreshold: 3\\n\\s+successThreshold: 1\\n\\s+resources:\\n\\s+requests:\\n\\s+cpu: 500m\\n\\s+memory: 512Mi\\n\\s+securityContext:\\n\\s+privileged: true\\n",
        ],
    },
)

# An emptied REQUEST is dropped the same way.
helm_template_test(
