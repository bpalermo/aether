# Guards: what must keep rendering. A render that is not told the cluster
# serves the API (`helm template` with no --api-versions: every other test in
# this file, and the "render both sides with controller.webhook.spire=true"
# diff of docs/runbook.md) is not refused; neither is the self-signed webhook
# on a cluster that has SPIRE's CRDs.
[
    helm_template_absent_test(
        name = "aether_controller_clusterspiffeid_%s_test" % case,
        absent = ["kind: ClusterSPIFFEID"],
        chart = ":aether",
        control = "kind: ValidatingWebhookConfiguration",
        opts = opts,
    )
    for case, opts in [
        (
            "no_class_no_api",
            [
                "--set",
                "controller.webhook.spire=true",
            ],
        ),
        (
            "self_signed_with_api",
            [
                "--api-versions",
                SPIRE_CRD_API,
            ],
        ),
    ]
]

