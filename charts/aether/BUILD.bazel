# Proposal 036: the agent brokers per-pod SVIDs over the SPIRE agent's SPIFFE
# Broker Endpoint, not the Delegated Identity API's admin socket. Three things
# have to agree — the flag, the hostPath the SPIRE chart puts the socket
# directory at, and the mount path the flag is built from — and a mismatch is
# invisible until a rollout leaves every pod without an SDS certificate. The
# admin socket's absence is pinned separately, by
# //agent/internal/cmd:TestChartFlagsExistOnTheAgentCommand, which reads this same
# template and asserts every flag it passes exists on the agent command.
helm_template_test(
    name = "aether_spire_broker_socket_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "--spire-broker-socket=/run/spire/broker-sockets/broker.sock",
            "/run/spire/agent/sockets/csi.spiffe.io/broker",
        ],
    },
)

# #1053: the egress identity gate is default ON. The controller must be told to
# inject it, from the AGENT image (the one carrying /identity-ready as an extra
# layer, already on every node), against the same Workload API socket path every
# aether component mounts from csi.spiffe.io. The flags' existence is pinned by
# //controller/internal/cmd:TestIdentityGate_FlagsRegistered.
helm_template_test(
    name = "aether_identity_gate_default_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/controller-deployment.yaml": [
            "--identity-gate=true",
            "--identity-gate-image=" + image_reference("agent") + "@sha256:",
            "--identity-gate-image-pull-policy=IfNotPresent",
            "--identity-gate-workload-socket=/run/secrets/workload-spiffe-uds/socket",
            "--identity-gate-memory-request=16Mi",
            "--identity-gate-memory-limit=64Mi",
        ],
    },
)

