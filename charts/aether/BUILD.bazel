# Comment lines, which the templates put between and inside the entries.
COMMENTS = "(\\s+#[^\\n]*\\n)*"

# A webhook entry: its name, then `failurePolicy: Ignore` (a pod webhook that
# fails closed is a cluster-wide outage, and a config webhook that does wedges
# every write while the controller rolls), a 5s timeout, and whatever selector
# scopes it, up to the clientConfig that reaches the controller's Service on
# the path given, with a non-empty caBundle (the self-signed default).
WEBHOOK = "  - name: %s\\n    admissionReviewVersions: \\[\"v1\"\\]\\n    sideEffects: None\\n" + COMMENTS + "    failurePolicy: Ignore\\n    timeoutSeconds: 5\\n%s    clientConfig:\\n      service:\\n        name: release-name-aether-controller-webhook\\n        namespace: default\\n        path: %s\\n        port: 443\\n      caBundle: [A-Za-z0-9+/=]+\\n    rules:\\n"

# `reinvocationPolicy: Never`, then the selector that scopes a pod webhook.
POD_SELECTOR = "    reinvocationPolicy: Never\\n" + COMMENTS + "    %s:\\n      matchLabels:\\n        aether\\.io/managed: \"true\"\\n"

# The one rule of a pod webhook: pod CREATE, nothing else.
POD_RULE = "      - apiGroups: \\[\"\"\\]\\n        apiVersions: \\[\"v1\"\\]\\n        operations: \\[\"CREATE\"\\]\\n        resources: \\[\"pods\"\\]\\n        scope: \"Namespaced\""

# Every pod of a managed NAMESPACE...
NAMESPACE_INJECT_SELECTOR = POD_SELECTOR % "namespaceSelector"

NAMESPACE_INJECT_WEBHOOK = WEBHOOK % ("namespace-inject\\.pods\\.aether\\.io", NAMESPACE_INJECT_SELECTOR, "/mutate") + POD_RULE

# ...and pods already labeled, by OBJECT selector.
NDOTS_SELECTOR = POD_SELECTOR % "objectSelector"

NDOTS_WEBHOOK = WEBHOOK % ("ndots\\.pods\\.aether\\.io", NDOTS_SELECTOR, "/mutate") + POD_RULE

VALIDATE_WEBHOOK = WEBHOOK % ("validate\\.config\\.aether\\.io", "", "/validate")

# The start of a configuration's `webhooks:` list: what follows is its FIRST entry.
WEBHOOKS = "\\nwebhooks:\\n" + COMMENTS

# The three documents of controller-webhook.yaml at default values. The Secret
# is matched on its shape, never on its content, and nothing here can print it
# (//bazel/helm:template_rules_test).
helm_template_match_test(
    name = "aether_webhook_documents_test",
    chart = ":aether",
    document_patterns = {
        "Secret/release-name-aether-controller-webhook-cert": [
            "\\nmetadata:\\n  name: release-name-aether-controller-webhook-cert\\n  namespace: default\\n",
            "\\ntype: kubernetes\\.io/tls\\ndata:\\n  ca\\.crt: [A-Za-z0-9+/=]+\\n  tls\\.crt: [A-Za-z0-9+/=]+\\n  tls\\.key: [A-Za-z0-9+/=]+$",
        ],
        # Exactly two entries: namespace injection, then ndots.
        "MutatingWebhookConfiguration/release-name-aether-controller-default-pod-ndots": [
            WEBHOOKS + NAMESPACE_INJECT_WEBHOOK + "\\n" + COMMENTS + NDOTS_WEBHOOK + "$",
        ],
        "ValidatingWebhookConfiguration/release-name-aether-controller-default": [
            WEBHOOKS + VALIDATE_WEBHOOK,
            "resources: \\[\"meshconfigs\"\\]\\n        scope: \"Cluster\"\\n",
            "resources: \\[\"httpfilters\"\\]\\n        scope: \"Namespaced\"\\n",
            "resources: \\[\"edgeconfigs\"\\]\\n        scope: \"Namespaced\"\\n",
            "resources: \\[\"endpointpolicies\"\\]\\n        scope: \"Namespaced\"\\n",
            "apiGroups: \\[\"gateway\\.networking\\.k8s\\.io\"\\]\\n        apiVersions: \\[\"v1\"\\]\\n        operations: \\[\"CREATE\", \"UPDATE\"\\]\\n        resources: \\[\"httproutes\"\\]\\n        scope: \"Namespaced\"$",
        ],
    },
)

