# Enabled: the DaemonSet runs the uds-csi image privileged, with Bidirectional
# propagation on BOTH the kubelet pods dir (so the bind onto target_path reaches
# the kubelet) and the per-pod tmpfs root (so the tmpfs mounts exist on the host,
# where the proxy will see them); every kubelet path derives from kubeletRoot,
# and hostPath == mountPath (the kubelet hands the plugin host paths).
helm_template_test(
    name = "aether_uds_csi_enabled_test",
    chart = ":aether",
    opts = [
        "--set",
        "udsCsi.enabled=true",
    ],
    template_patterns = {
        "aether/templates/uds-csi-daemonset.yaml": [
            "kind: DaemonSet",
            "name: aether-uds-csi",
            image_reference("uds-csi") + "@sha256:",
            "command: \\[\"/uds-csi\"\\]",
            "- \"--kubelet-root=/var/lib/kubelet\"",
            "- \"--root=/run/aether/uds\"",
            "- \"--size=1Mi\"",
            # The per-pod tmpfs inode cap (#1107), default 64.
            "- \"--inodes=64\"\\n",
            "privileged: true",
            "runAsUser: 0",
            "- name: kubelet-pods\\n\\s+mountPath: /var/lib/kubelet/pods\\n\\s+mountPropagation: Bidirectional\\n",
            "- name: uds-root\\n\\s+mountPath: /run/aether/uds\\n\\s+mountPropagation: Bidirectional\\n",
            "- name: plugin-dir\\n\\s+mountPath: /var/lib/kubelet/plugins/csi.aether.io\\n",
            "- name: registration-dir\\n\\s+mountPath: /var/lib/kubelet/plugins_registry\\n",
            "- name: kubelet-pods\\n\\s+hostPath:\\n\\s+path: /var/lib/kubelet/pods\\n",
            "- name: uds-root\\n\\s+hostPath:\\n\\s+path: /run/aether/uds\\n",
            "- \"/uds-csi\"\\n\\s+- \"--probe\"",
            "key: aether.io/agent-not-ready",
            "maxSurge: 0",
            "priorityClassName: system-node-critical",
            "automountServiceAccountToken: false",
        ],
        "aether/templates/uds-csi-csidriver.yaml": [
            "kind: CSIDriver",
            "name: csi.aether.io",
            "attachRequired: false",
            "podInfoOnMount: true",
            "volumeLifecycleModes:\\n\\s+- Ephemeral\\n",
            "fsGroupPolicy: File",
            "requiresRepublish: false",
            "seLinuxMount: false",
        ],
    },
)

