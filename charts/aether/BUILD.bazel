# Renaming them would delete and recreate every node's proxy pod.
#
# `aether.release.assertOnlyOne`, which refuses a second release, reads live
# objects with `lookup`, and `helm template` has no cluster: NO RULE IN THIS
# FILE CAN EXERCISE ITS FAILURE. It was run by hand against a stub API server
# (the pull request of #1540 has the transcript). What is tested here is that a
# render without a cluster is not refused, which is every other test.
helm_template_match_test(
    name = "aether_proxy_names_ignore_fullname_override_test",
