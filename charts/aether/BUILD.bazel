# --- The templates that render several documents (#1371) ----------------------
#
# rules_helm's helm_template_test keeps one document per template file, the one
# helm prints last, and helm prints a release's objects sorted by kind. For
# these seven templates that left every document but one out of reach:
#
#   agent-rbac.yaml            ClusterRole, [ClusterRoleBinding]
#   agent-serviceaccount.yaml  ServiceAccount (agent), [ServiceAccount (proxy)]
#   controller-rbac.yaml       2 ClusterRoles, 2 ClusterRoleBindings, Role, [RoleBinding]
#   controller-webhook.yaml    Secret, MutatingWebhookConfiguration, [ValidatingWebhookConfiguration]
#   registrar-rbac.yaml        ClusterRole, ClusterRoleBinding, Role, [RoleBinding]
#   edge-rbac.yaml             ClusterRole, [ClusterRoleBinding]
#   edge-httproute.yaml        one HTTPRoute per edge.gateway.httpRoutes entry, [the last by name]
#
# ([..] is the one a template_patterns entry would have searched; none of the
# seven had one.) The tests below name the DOCUMENT they are about.
#
# A pattern for a rule allows comment lines between its keys: the templates
# explain each grant in place and helm keeps the comments.

# What a binding must say: the role it grants and the one ServiceAccount, in
# the release namespace, it grants it to.
BINDING = "\\nroleRef:\\n  apiGroup: rbac\\.authorization\\.k8s\\.io\\n  kind: %s\\n  name: %s\\nsubjects:\\n  - kind: ServiceAccount\\n    name: %s\\n    namespace: %s$"

# One RBAC rule, as rendered: apiGroups, resources, verbs, with comments allowed
# between them.
RULE = "\\n  - apiGroups: \\[%s\\]\\n(\\s+#[^\\n]*\\n)*    resources: \\[%s\\]\\n(\\s+#[^\\n]*\\n)*    verbs: \\[%s\\]"

# The verb lists, in the two orders the templates write them.
READ = "\"list\", \"get\", \"watch\""

READ_PATCH = READ + ", \"patch\""

READ_WRITE_DELETE = READ + ", \"create\", \"update\", \"patch\", \"delete\""

GET_LIST_WATCH = "\"get\", \"list\", \"watch\""

GET_LIST_WATCH_PATCH = GET_LIST_WATCH + ", \"patch\""

GET_LIST_WATCH_UPDATE = GET_LIST_WATCH + ", \"update\", \"patch\""

GET_LIST_WATCH_WRITE = GET_LIST_WATCH + ", \"create\", \"update\", \"patch\""

# The node agent. The eviction grant is in the CORE group on purpose (a
# "policy" grant 403s every eviction, found by a node-reboot test); the node
# patch is what removes the startup taint; gamma and UDS delivery are on by
# default and each brings its own reads.
helm_template_match_test(
    name = "aether_agent_rbac_test",
    chart = ":aether",
    document_patterns = {
        "ClusterRole/release-name-aether-agent-default": [
            RULE % ("\"\"", "\"pods\"", READ),
            RULE % ("\"\"", "\"pods/eviction\"", "\"create\""),
            RULE % ("\"\"", "\"events\"", "\"create\""),
            RULE % ("\"\"", "\"nodes\"", READ_PATCH),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"httproutes\", \"grpcroutes\"", READ),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"httproutes/status\", \"grpcroutes/status\"", "\"get\", \"update\", \"patch\""),
            RULE % ("\"config\\.aether\\.io\"", "\"httpfilters\"", READ),
            RULE % ("\"config\\.aether\\.io\"", "\"endpointpolicies\"", READ),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"tcproutes\", \"tlsroutes\", \"udproutes\"", READ),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"tcproutes/status\", \"tlsroutes/status\", \"udproutes/status\"", "\"get\", \"update\", \"patch\""),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"referencegrants\"", READ),
            RULE % ("\"\"", "\"services\"", READ) + "$",
        ],
        "ClusterRoleBinding/release-name-aether-agent-default": [
            BINDING % ("ClusterRole", "release-name-aether-agent-default", "release-name-aether-agent", "default"),
        ],
    },
)

