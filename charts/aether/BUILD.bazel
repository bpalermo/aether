# ...and it is the only Namespace in that render: nothing privileged.
helm_template_absent_test(
    name = "aether_edge_namespace_is_the_only_namespace_test",
    absent = ["pod-security.kubernetes.io/enforce: privileged"],
    chart = ":aether",
    control = "kind: Namespace",
    opts = [
        "--namespace",
        "aether-system",
        "--set",
        "edge.enabled=true",
    ],
