load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/helm:defs.bzl", "chart_push", "helm_template_fail_test")
load("//bazel/img:registry.bzl", "chart_registry_url", "image_reference")

# The deployed proxy.hotRestart tunables are pinned by a Go test: the supervisor
# derives its admin re-verify budget from parentShutdownTime, so the values that
# ship here are an input to //agent/internal/proxy/hotrestart (#666).
# agent-proxy-daemonset.yaml is exported for the same reason: it is the literal
# argv the supervisor is handed, and //agent/internal/supervisorcmd asserts every
# flag in it exists on the command (#772). A rename there would otherwise only
# surface as every proxy pod failing to start at rollout time.
# agent-proxy-configmap.yaml is exported so //test/envoy_validate can run its
# aether.cluster stats-tag regex over the per-kind L4 stat keys (#1023): a
# regex edit that cut "tcp:<ns>/<svc>:<port>" short would silently merge L4
# series again.
exports_files([
    "values.yaml",
    "templates/agent-daemonset.yaml",
    "templates/agent-proxy-daemonset.yaml",
    "templates/agent-proxy-configmap.yaml",
])

# Shared by both packagings below (see :aether_commit). `images` is what makes the
# `{@//...:image_push.digest}` placeholders in values.yaml resolve at package time,
# so both packages must declare it even though only `:aether.push` publishes the
# images.
AETHER_IMAGES = [
    "//agent/cmd/agent:image_push",
    "//agent/cmd/mesh-dns:image_push",
    "//agent/cmd/proxy-supervisor:image_push",
    "//cni/cmd/cni-install:image_push",
    "//registrar/cmd/registrar:image_push",
    "//controller/cmd/controller:image_push",
]

# aether Helm chart (published to chart_registry_url("aether"); see //bazel/img:registry.bzl).
#
# The whole system in one chart: agent + cni-install + per-node proxy, registrar,
# and the mesh-config controller. The MeshConfig CRD ships in //charts/crds
# (install ahead of time). See docs/proposals/015_mesh-config.md.
#
# `images` wires the in-repo image_push targets so the `{@//...:image_push}`
# placeholders in values.yaml are digest-pinned at package time and published with
# the chart.
#
# Publish targets (OCI; registry from //bazel/img:registry.bzl). No
# `registry_url`, so rules_helm defines no `.push`/`.push_registry`: `helm push`
# appends the chart's name to its base and cannot reach the flat
# `chart-aether` repository (proposal 040). The images and the chart go
# separately, images first:
#   bazel run --stamp //charts/aether:aether.push_images   # the images, by digest
#   bazel run --stamp //charts/aether:aether.chart_push    # the chart, <X.Y.Z>
# Credentials: `docker login <registry>` (image_push and oras both read the
# Docker config).
helm_chart(
    name = "aether",
    chart = "Chart.yaml",
    images = AETHER_IMAGES,
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

chart_push(
    name = "aether.chart_push",
    chart_name = "aether",
    package = ":aether",
    repository = chart_registry_url("aether"),
)

helm_lint_test(
    name = "aether_lint_test",
    chart = ":aether",
)

helm_template_test(
    name = "aether_template_test",
    chart = ":aether",
)

# Proposal 038: the capture listeners bind with IP_TRANSPARENT, which the kernel
# checks as CAP_NET_ADMIN in the user namespace owning the pod netns -- the init
# userns here -- and Envoy's supportsIpTransparent() probe runs once in the HOST
# netns with the same requirement. Both fail SILENTLY without the capability: a
# missing grant means tproxy never assigns a packet to the socket and the probe
# quietly disables the original_dst fallback. So pin the grant against the
# packaged chart rather than trust the securityContext by eye.
helm_template_test(
    name = "aether_proxy_net_admin_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- NET_ADMIN",
        ],
    },
)

# #772 phase B2: the aether-proxy pod must run the carved-out supervisor image,
# not the 65MiB agent binary. Both halves are individually easy to half-change —
# the initContainer's image and the proxy container's command — and neither
# failure is visible until a rollout, so pin them against the packaged chart
# (where the `{@//...:image_push.repository}` placeholder is already resolved).
helm_template_test(
    name = "aether_proxy_supervisor_image_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            image_reference("proxy-supervisor") + "@sha256:",
            "--install-path=/opt/aether/supervisor",
            "--install-readiness-path=/opt/aether/proxy-ready",
        ],
    },
)

# #1050: the hot-restart child must not block on the draining parent's main
# thread for stats. Envoy's periodic getParentStats is a timeout-less blocking
# recvmsg, and the parent's UDP forward to the child is a timeout-less blocking
# sendmsg; together they deadlock both epochs' main threads. The chart passes
# --skip-hot-restart-parent-stats by default (proxy.hotRestart.skipParentStats).
helm_template_test(
    name = "aether_proxy_skip_parent_stats_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- \"--envoy-arg=--skip-hot-restart-parent-stats\"",
        ],
    },
)

# ...and the knob really turns it off. rules_helm can only assert presence, so
# this pins absence positionally: with the knob false the last Envoy arg
# (--service-zone's value) is followed directly by the container's `env:`.
helm_template_test(
    name = "aether_proxy_skip_parent_stats_off_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.hotRestart.skipParentStats=false",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- \"--envoy-arg=\\$\\(ZONE\\)\"\\n\\s+env:\\n",
        ],
    },
)

# Proposal 036: the agent brokers per-pod SVIDs over the SPIRE agent's SPIFFE
# Broker Endpoint, not the Delegated Identity API's admin socket. Three things
# have to agree — the flag, the hostPath the SPIRE chart puts the socket
# directory at, and the mount path the flag is built from — and a mismatch is
# invisible until a rollout leaves every pod without an SDS certificate. The
# admin socket's absence is pinned separately, by
# //agent/internal/cmd:TestChartFlagsExistOnTheAgentCommand, which reads this same
# template and asserts every flag it passes exists on the agent command.
helm_template_test(
    name = "aether_spire_broker_socket_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "--spire-broker-socket=/run/spire/broker-sockets/broker.sock",
            "/run/spire/agent/sockets/csi.spiffe.io/broker",
        ],
    },
)

# #770: proxy.authzSidecar.failureMode is an authorization control, and the
# template used to compare it raw against "ALLOW". Every spelling that is not
# exactly "ALLOW" — including `allow` — therefore selected fail-CLOSED with no
# diagnostic anywhere. These two targets pin both halves of the fix: the
# normalisation, and the guard that rejects what normalisation cannot rescue.
#
# The chart's output here is the agent flag; `--authz-sidecar-failure-mode-allow`
# is what makes the agent render `failure_mode_allow: true` into the ext_authz
# filter (agent/internal/xds/proxy).
helm_template_test(
    name = "aether_authz_failure_mode_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.authzSidecar.enabled=true",
        # Lower case on purpose: the pre-#770 template rendered fail-closed here.
        "--set",
        "proxy.authzSidecar.failureMode=allow",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "--authz-sidecar-failure-mode-allow",
        ],
    },
)

# #950: the CNI plugin binary resolves its OTLP endpoint with the HOST's
# resolver, which cannot resolve a cluster Service name, so cni-install pins the
# name to its ClusterIP before writing the netconf. The chart must hand
# cni-install the pin flag, and cniInstall.otlpEndpoint must override the
# fleet-wide otel.endpoint for the CNI alone. The flag's existence and default
# are pinned in //cni/internal/cmd:TestOTLPPinDefaultsOn.
helm_template_test(
    name = "aether_cni_otlp_pin_test",
    chart = ":aether",
    opts = [
        "--set",
        "otel.endpoint=otel-collector.o11y.svc.cluster.local:4317",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "--otlp-endpoint=otel-collector.o11y.svc.cluster.local:4317",
            "--otlp-pin-endpoint=true",
        ],
    },
)

helm_template_test(
    name = "aether_cni_otlp_override_test",
    chart = ":aether",
    opts = [
        "--set",
        "otel.endpoint=otel-collector.o11y.svc.cluster.local:4317",
        "--set",
        "cniInstall.otlpEndpoint=10.96.0.42:4317",
        "--set",
        "cniInstall.pinOTLPEndpoint=false",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "--otlp-endpoint=10.96.0.42:4317",
            "--otlp-pin-endpoint=false",
        ],
    },
)

helm_template_fail_test(
    name = "aether_authz_failure_mode_invalid_test",
    chart = ":aether",
    expected_message = "proxy.authzSidecar.failureMode must be ALLOW or DENY",
    opts = [
        "--set",
        "proxy.authzSidecar.failureMode=maybe",
    ],
)

# Commit-pinned second packaging of the SAME chart (#692).
#
# chart_push tags with the packaged chart's `version:`, so the chart above
# publishes under the bare `<X.Y.Z>` tag — a tag that does not change per
# commit. Two publish runs therefore used to write it in
# whatever order they finished, and on 2026-09-05 the older commit's chart won.
# `publish.yaml` is now serialised, which makes the bare tag last-writer-correct;
# this target additionally makes every commit's chart addressable by a tag that
# can never be reused: `<X.Y.Z>-<full git sha>`, the same scheme the
# crds/prober/udsecho charts already carry in their own `Chart.yaml`.
#
# The version suffix is *derived* from Chart.yaml rather than duplicated, so the
# bare tag and the commit tag can never disagree about X.Y.Z.
#
# Only `:aether_commit.chart_push` (chart, no images) is published — the images
# are byte-identical to the ones `:aether.push_images` already pushed by digest.
genrule(
    name = "chart_commit_yaml",
    srcs = ["Chart.yaml"],
    outs = ["Chart.commit.yaml"],
    # `{GIT_COMMIT}` is a workspace-status placeholder that rules_helm substitutes
    # at package time on --stamp builds (bazel/workspace_status.sh: full 40-char
    # sha). Emitting it literally here is the point.
    # The trailing `grep` fails the build if Chart.yaml's version line ever stops
    # matching the pattern, rather than silently republishing the bare version
    # under a second name.
    cmd = "sed -E 's/^(version:[[:space:]]*\"[0-9]+\\.[0-9]+\\.[0-9]+)\"$$/\\1-{GIT_COMMIT}\"/'" +
          " $(location Chart.yaml) > $@ && grep -q -- '-{GIT_COMMIT}\"$$' $@",
)

helm_chart(
    name = "aether_commit",
    chart = ":Chart.commit.yaml",
    images = AETHER_IMAGES,
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

chart_push(
    name = "aether_commit.chart_push",
    chart_name = "aether",
    package = ":aether_commit",
    repository = chart_registry_url("aether"),
)

helm_lint_test(
    name = "aether_commit_lint_test",
    chart = ":aether_commit",
)
