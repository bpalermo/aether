load("@aether_registry//:registry.bzl", "chart_registry_url", "image_reference")
load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/helm:defs.bzl", "chart_push", "helm_pod_template_version_test", "helm_template_absent_test", "helm_template_fail_test", "helm_template_value_changes_test")

# The deployed proxy.hotRestart tunables are pinned by a Go test: the supervisor
# derives its admin re-verify budget from parentShutdownTime, so the values that
# ship here are an input to //agent/internal/proxy/hotrestart (#666).
# agent-proxy-daemonset.yaml is exported for the same reason: it is the literal
# argv the supervisor is handed, and //agent/internal/supervisorcmd asserts every
# flag in it exists on the command (#772). A rename there would otherwise only
# surface as every proxy pod failing to start at rollout time.
# agent-proxy-configmap.yaml is exported so //agent/test/envoy_validate can run its
# aether.cluster stats-tag regex over the per-kind L4 stat keys (#1023): a
# regex edit that cut "tcp:<ns>/<svc>:<port>" short would silently merge L4
# series again.
# uds-csi-daemonset.yaml is exported so //agent/cmd/uds-csi asserts every flag
# it passes (args and the liveness probe's command) exists on the binary.
exports_files([
    "values.yaml",
    "templates/agent-daemonset.yaml",
    "templates/agent-proxy-daemonset.yaml",
    "templates/agent-proxy-configmap.yaml",
    "templates/uds-csi-daemonset.yaml",
])

# Shared by both packagings below (see :aether_commit). `images` is what makes the
# `{@//...:image_push.digest}` placeholders in values.yaml resolve at package time,
# so both packages must declare it even though only `:aether.push` publishes the
# images.
AETHER_IMAGES = [
    "//agent/cmd/agent:image_push",
    "//agent/cmd/mesh-dns:image_push",
    "//agent/cmd/proxy-supervisor:image_push",
    "//cni/cmd/cni-install:image_push",
    "//registrar/cmd/registrar:image_push",
    "//controller/cmd/controller:image_push",
    # The csi.aether.io node plugin (proposal 039), the only UDS socket carrier
    # since Phase 2 (udsCsi.enabled defaults to true).
    "//agent/cmd/uds-csi:image_push",
]

# aether Helm chart (published to chart_registry_url("aether"); see @aether_registry//:registry.bzl).
#
# The whole system in one chart: agent + cni-install + per-node proxy, registrar,
# and the mesh-config controller. The MeshConfig CRD ships in //charts/crds
# (install ahead of time). See docs/proposals/015_mesh-config.md.
#
# `images` wires the in-repo image_push targets so the `{@//...:image_push}`
# placeholders in values.yaml are digest-pinned at package time and published with
# the chart.
#
# Publish targets (OCI; registry from @aether_registry//:registry.bzl). No
# `registry_url`, so rules_helm defines no `.push`/`.push_registry`: `helm push`
# appends the chart's name to its base and cannot reach the flat
# `chart-aether` repository (proposal 040). The images and the chart go
# separately, images first:
#   bazel run --stamp //charts/aether:aether.push_images   # the images, by digest
#   bazel run --stamp //charts/aether:aether.chart_push    # the chart, <X.Y.Z>
# Credentials: `docker login <registry>` (image_push and oras both read the
# Docker config).
helm_chart(
    name = "aether",
    chart = "Chart.yaml",
    images = AETHER_IMAGES,
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

chart_push(
    name = "aether.chart_push",
    chart_name = "aether",
    package = ":aether",
    repository = chart_registry_url("aether"),
)

helm_lint_test(
    name = "aether_lint_test",
    chart = ":aether",
)

helm_template_test(
    name = "aether_template_test",
    chart = ":aether",
)

# #1363: a chart release must not roll pods whose spec did not change. Each
# workload's pod template is rendered at two chart versions (and two
# appVersions) and must be byte-identical: until 2.4.15 every pod template
# carried `helm.sh/chart: aether-<version>` and `app.kubernetes.io/version`, so
# a version bump alone rolled the agent, the proxy (a hot restart on every
# node), mesh-dns, uds-csi, the registrar and the controller. On a `--stamp`
# build the appVersion is `git describe` and the published commit chart is
# `X.Y.Z-<sha>`, so both labels changed with every commit.
# The same test asserts every workload OBJECT still carries
# `helm.sh/chart: aether-<version>` on its own metadata.
helm_pod_template_version_test(
    name = "aether_pod_template_version_test",
    chart = ":aether",
    workloads = 6,
)

# ...with every optional workload and container rendered too (the edge
# Deployment, the proxy's authz sidecar, telemetry).
helm_pod_template_version_test(
    name = "aether_pod_template_version_all_enabled_test",
    chart = ":aether",
    opts = [
        "--set",
        "edge.enabled=true",
        "--set",
        "proxy.authzSidecar.enabled=true",
        "--set",
        "otel.enabled=true",
        "--set",
        "otel.endpoint=otel-collector.observability.svc:4317",
    ],
    workloads = 7,
)

# ...and for the per-commit packaging (`X.Y.Z-<sha>`, see :aether_commit below).
helm_pod_template_version_test(
    name = "aether_commit_pod_template_version_test",
    chart = ":aether_commit",
    workloads = 6,
)

# #1363 guard: a selector is immutable on upgrade, so each stays exactly the
# three labels it was (name, instance, component) and never gains a
# version-carrying one. Positional: `matchLabels:` is followed by the three
# labels and then by a key one level up.
helm_template_test(
    name = "aether_selector_labels_test",
    chart = ":aether",
    opts = [
        "--set",
        "edge.enabled=true",
    ],
    template_patterns = {
        "aether/templates/" + template + ".yaml": [
            "\\n  selector:\\n    matchLabels:\\n      app.kubernetes.io/name: aether-" + component +
            "\\n      app.kubernetes.io/instance: \\S+\\n      app.kubernetes.io/component: " + component + "\\n  \\S",
        ]
        for template, component in [
            ("agent-daemonset", "agent"),
            ("agent-proxy-daemonset", "proxy"),
            ("mesh-dns-daemonset", "mesh-dns"),
            ("uds-csi-daemonset", "uds-csi"),
            ("registrar-deployment", "registrar"),
            ("controller-deployment", "controller"),
            ("edge-deployment", "edge"),
        ]
    },
)

# #1363: what the version label did by accident. A pod that reads a
# chart-rendered ConfigMap only at start was restarted by every release, so a
# changed ConfigMap always reached it. With the label gone, the two ConfigMaps
# read that way roll their pods through a checksum of their DATA (never of the
# whole object: its labels carry the chart version):
#   - the edge's Envoy bootstrap (plain `envoy -c`, no watcher);
#   - the OPA sidecar's Rego policy (`opa run` without --watch): an
#     authorization policy that silently stayed the old one.
# The proxy's own bootstrap needs none: its supervisor watches the file
# (--watch-config) and hot-restarts in place.
helm_template_test(
    name = "aether_edge_config_checksum_test",
    chart = ":aether",
    opts = [
        "--set",
        "edge.enabled=true",
    ],
    template_patterns = {
        "aether/templates/edge-deployment.yaml": [
            "\\n  template:\\n    metadata:\\n      annotations:\\n(.*\\n)*?        checksum/edge-config: [0-9a-f]{64}\\n",
        ],
    },
)

# ...and the checksum follows the bootstrap: a constant would satisfy the shape
# test above. Turning the admin listener on changes the ConfigMap's data and
# nothing else the edge pod reads.
helm_template_value_changes_test(
    name = "aether_edge_config_checksum_changes_test",
    changed_opts = [
        "--set",
        "edge.admin.enabled=true",
    ],
    chart = ":aether",
    key = "checksum/edge-config:",
    opts = [
        "--show-only",
        "templates/edge-deployment.yaml",
        "--set",
        "edge.enabled=true",
    ],
)

OPA_ON = [
    "--set",
    "proxy.authzSidecar.enabled=true",
    "--set",
    "proxy.authzSidecar.opa.enabled=true",
]

# The checksum is the sha256 of the policy text, so two policies are two pod
# templates (`printf 'package x' | sha256sum`).
helm_template_test(
    name = "aether_opa_policy_checksum_test",
    chart = ":aether",
    opts = OPA_ON + [
        "--set-string",
        "proxy.authzSidecar.opa.policy=package x",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "\\n  template:\\n    metadata:\\n      annotations:\\n(\\s+#.*\\n)*        checksum/opa-policy: f29a61410674e7e3184fb918a75bd5db888db98e3646d8852cc47162be9146a8\\n",
        ],
    },
)

helm_template_test(
    name = "aether_opa_policy_checksum_changes_test",
    chart = ":aether",
    opts = OPA_ON + [
        "--set-string",
        "proxy.authzSidecar.opa.policy=package y",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "        checksum/opa-policy: accad67074bb4111a47acfb8abae0f531c745376006e750ec99fc2836832ee32\\n",
        ],
    },
)

# Off (the default): no annotation at all on the proxy pod template, so the
# default render is unchanged.
helm_template_absent_test(
    name = "aether_opa_policy_checksum_off_test",
    absent = [
        "checksum/",
        "annotations:",
    ],
    chart = ":aether",
    control = "name: aether-proxy",
    opts = [
        "--show-only",
        "templates/agent-proxy-daemonset.yaml",
    ],
)

# #1116: the node agent keeps its 200m CPU request but has NO CPU limit -- a
# 200m CFS quota turned 5-25 ms snapshot builds into 100 ms steps and could
# throttle a goroutine holding the snapshot-cache mutex (#1105/#1114) -- and,
# with the limit gone, GOMAXPROCS is pinned explicitly rather than derived from
# limits.cpu (which would fall back to the node's cores). Positional on the agent
# container: its resources block is followed directly by the pod's `volumes:`
# (the cni-install initContainer's is followed by `containers:`), and `limits:`
# carrying only memory proves there is no limits.cpu.
helm_template_test(
    name = "aether_agent_cpu_resources_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "resources:\\n\\s+limits:\\n\\s+memory: \\S+\\n\\s+requests:\\n\\s+cpu: 200m\\n\\s+memory: \\S+\\n\\s+volumes:\\n",
            "- name: GOMAXPROCS\\n\\s+value: \"2\"\\n",
        ],
    },
)

# #1253: mesh-dns (every managed pod's resolver) has a 50m CPU request and NO
# CPU limit -- at 25m/100m it was CFS-throttled in 8.7 % of periods at steady
# state -- and GOMAXPROCS is pinned to 2 (what the Go runtime derived from the
# old 100m limit) rather than scaling to the node's cores. Positional on the
# container's resources block, which is followed directly by the pod's
# `volumes:`; `limits:` carrying only memory proves there is no limits.cpu.
MESH_DNS_NO_CPU_LIMIT = "resources:\\n\\s+limits:\\n\\s+memory: 64Mi\\n\\s+requests:\\n\\s+cpu: 50m\\n\\s+memory: 32Mi\\n\\s+volumes:\\n"

helm_template_test(
    name = "aether_mesh_dns_cpu_resources_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/mesh-dns-daemonset.yaml": [
            MESH_DNS_NO_CPU_LIMIT,
            "- name: GOMAXPROCS\\n\\s+value: \"2\"\\n",
        ],
    },
)

# An EMPTY limits.cpu is "no CPU limit" too: it is dropped, never rendered as
# `cpu: ""` (which the apiserver rejects as a quantity).
helm_template_test(
    name = "aether_mesh_dns_empty_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.meshDnsDaemon.resources.limits.cpu=",
    ],
    template_patterns = {
        "aether/templates/mesh-dns-daemonset.yaml": [
            MESH_DNS_NO_CPU_LIMIT,
        ],
    },
)

# ...and an operator can still put a cap back.
helm_template_test(
    name = "aether_mesh_dns_cpu_limit_override_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.meshDnsDaemon.resources.limits.cpu=200m",
    ],
    template_patterns = {
        "aether/templates/mesh-dns-daemonset.yaml": [
            "resources:\\n\\s+limits:\\n\\s+cpu: 200m\\n\\s+memory: 64Mi\\n",
        ],
    },
)

