load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/helm:defs.bzl", "chart_push", "helm_template_absent_test", "helm_template_fail_test")
load("//bazel/img:registry.bzl", "chart_registry_url", "image_reference")

# The deployed proxy.hotRestart tunables are pinned by a Go test: the supervisor
# derives its admin re-verify budget from parentShutdownTime, so the values that
# ship here are an input to //agent/internal/proxy/hotrestart (#666).
# agent-proxy-daemonset.yaml is exported for the same reason: it is the literal
# argv the supervisor is handed, and //agent/internal/supervisorcmd asserts every
# flag in it exists on the command (#772). A rename there would otherwise only
# surface as every proxy pod failing to start at rollout time.
# agent-proxy-configmap.yaml is exported so //test/envoy_validate can run its
# aether.cluster stats-tag regex over the per-kind L4 stat keys (#1023): a
# regex edit that cut "tcp:<ns>/<svc>:<port>" short would silently merge L4
# series again.
# uds-csi-daemonset.yaml is exported so //agent/cmd/uds-csi asserts every flag
# it passes (args and the liveness probe's command) exists on the binary.
exports_files([
    "values.yaml",
    "templates/agent-daemonset.yaml",
    "templates/agent-proxy-daemonset.yaml",
    "templates/agent-proxy-configmap.yaml",
    "templates/uds-csi-daemonset.yaml",
])

# Shared by both packagings below (see :aether_commit). `images` is what makes the
# `{@//...:image_push.digest}` placeholders in values.yaml resolve at package time,
# so both packages must declare it even though only `:aether.push` publishes the
# images.
AETHER_IMAGES = [
    "//agent/cmd/agent:image_push",
    "//agent/cmd/mesh-dns:image_push",
    "//agent/cmd/proxy-supervisor:image_push",
    "//cni/cmd/cni-install:image_push",
    "//registrar/cmd/registrar:image_push",
    "//controller/cmd/controller:image_push",
    # The csi.aether.io node plugin (proposal 039), the only UDS socket carrier
    # since Phase 2 (udsCsi.enabled defaults to true).
    "//agent/cmd/uds-csi:image_push",
]

# aether Helm chart (published to chart_registry_url("aether"); see //bazel/img:registry.bzl).
#
# The whole system in one chart: agent + cni-install + per-node proxy, registrar,
# and the mesh-config controller. The MeshConfig CRD ships in //charts/crds
# (install ahead of time). See docs/proposals/015_mesh-config.md.
#
# `images` wires the in-repo image_push targets so the `{@//...:image_push}`
# placeholders in values.yaml are digest-pinned at package time and published with
# the chart.
#
# Publish targets (OCI; registry from //bazel/img:registry.bzl). No
# `registry_url`, so rules_helm defines no `.push`/`.push_registry`: `helm push`
# appends the chart's name to its base and cannot reach the flat
# `chart-aether` repository (proposal 040). The images and the chart go
# separately, images first:
#   bazel run --stamp //charts/aether:aether.push_images   # the images, by digest
#   bazel run --stamp //charts/aether:aether.chart_push    # the chart, <X.Y.Z>
# Credentials: `docker login <registry>` (image_push and oras both read the
# Docker config).
helm_chart(
    name = "aether",
    chart = "Chart.yaml",
    images = AETHER_IMAGES,
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

chart_push(
    name = "aether.chart_push",
    chart_name = "aether",
    package = ":aether",
    repository = chart_registry_url("aether"),
)

helm_lint_test(
    name = "aether_lint_test",
    chart = ":aether",
)

helm_template_test(
    name = "aether_template_test",
    chart = ":aether",
)

# #1116: the node agent keeps its 200m CPU request but has NO CPU limit -- a
# 200m CFS quota turned 5-25 ms snapshot builds into 100 ms steps and could
# throttle a goroutine holding the snapshot-cache mutex (#1105/#1114) -- and,
# with the limit gone, GOMAXPROCS is pinned explicitly rather than derived from
# limits.cpu (which would fall back to the node's cores). Positional on the agent
# container: its resources block is followed directly by the pod's `volumes:`
# (the cni-install initContainer's is followed by `containers:`), and `limits:`
# carrying only memory proves there is no limits.cpu.
helm_template_test(
    name = "aether_agent_cpu_resources_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "resources:\\n\\s+limits:\\n\\s+memory: \\S+\\n\\s+requests:\\n\\s+cpu: 200m\\n\\s+memory: \\S+\\n\\s+volumes:\\n",
            "- name: GOMAXPROCS\\n\\s+value: \"2\"\\n",
        ],
    },
)

# #1123: an agent pod start is time the node's proxy spends on no ADS stream.
# Both of its images are digest-pinned, so they are pulled IfNotPresent (Always
# only adds a registry round trip per container), and readiness is probed every
# 2 s from the start while keeping 30 s to NotReady (15 x 2 s).
helm_template_test(
    name = "aether_agent_restart_fast_path_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "- name: cni-install\\n\\s+image: \\S+\\n\\s+imagePullPolicy: IfNotPresent\\n",
            "- name: agent\\n\\s+image: \\S+\\n\\s+imagePullPolicy: IfNotPresent\\n",
            "readinessProbe:\\n\\s+exec:\\n\\s+command: \\[\"/agent-ready\", \"--path=/readyz\"\\]\\n\\s+periodSeconds: 2\\n\\s+failureThreshold: 15\\n",
        ],
    },
)

# Proposal 041: agent.updateStrategy.surge. Off (the default) keeps the
# delete-then-create roll; on rolls with maxSurge 1 / maxUnavailable 0 so the
# new agent runs as a standby beside the old one.
helm_template_test(
    name = "aether_agent_update_strategy_default_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "updateStrategy:\\n\\s+type: RollingUpdate\\n\\s+rollingUpdate:\\n(\\s+#.*\\n)*\\s+maxSurge: 0\\n\\s+maxUnavailable: 1\\n",
        ],
    },
)

helm_template_test(
    name = "aether_agent_update_strategy_surge_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.updateStrategy.surge=true",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "updateStrategy:\\n\\s+type: RollingUpdate\\n\\s+rollingUpdate:\\n(\\s+#.*\\n)*\\s+maxSurge: 1\\n\\s+maxUnavailable: 0\\n",
            # Everything that makes the overlap safe, in BOTH strategies (the
            # default test below pins the same): probes over the pod-local
            # socket, no TCP health port, the lock's hostPath mounted.
            "- \"--health-socket=/tmp/aether-agent-health.sock\"",
            "- \"--health-probe-bind-address=0\"",
            "livenessProbe:\\n\\s+exec:\\n\\s+command: \\[\"/agent-ready\", \"--path=/healthz\"\\]\\n",
            "- name: run-dir\\n\\s+mountPath: /run/aether\\n",
            "priorityClassName: system-node-critical\\n",
        ],
    },
)

# A hostNetwork pod's containerPort defaults to a hostPort: the scheduler's
# NodePorts filter would keep a surge agent Pending beside the old one forever.
# The agent declares no ports, in either strategy; the control proves the
# render reached the agent container.
helm_template_absent_test(
    name = "aether_agent_no_host_ports_test",
    absent = [
        "containerPort: 8080",
        "containerPort: 8082",
        "port: health",
    ],
    chart = ":aether",
    control = "- \"--health-socket=/tmp/aether-agent-health.sock\"",
    opts = [
        "--show-only",
        "templates/agent-daemonset.yaml",
        "--set",
        "agent.updateStrategy.surge=true",
    ],
)

# ...and agent.goMaxProcs=0 hands GOMAXPROCS back to the Go runtime: no env var.
helm_template_absent_test(
    name = "aether_agent_gomaxprocs_off_test",
    absent = [
        "name: GOMAXPROCS",
    ],
    chart = ":aether",
    control = "name: GOMEMLIMIT",
    opts = [
        "--show-only",
        "templates/agent-daemonset.yaml",
        "--set",
        "agent.goMaxProcs=0",
    ],
)

# 2026-10-04 soak: agents OOMKilled at a 64Mi limit. GOMEMLIMIT came from
# `resourceFieldRef: limits.memory` (divisor 1) -- the WHOLE cgroup limit -- so
# the Go heap could fill the cgroup before the GC tightened, and the /agent-ready
# exec probe processes (proposal 041) charged to the same cgroup tipped it over.
# GOMEMLIMIT is now a literal integer byte count at 90% of limits.memory
# (aether.goMemLimit), pinned EXACTLY below, which is what makes it numeric and
# strictly below the limit:
#   agent      128Mi = 134217728 -> 120795955 (115.2Mi)
#   agent      256Mi = 268435456 -> 241591910 (override)
#   registrar   64Mi =  67108864 ->  60397977
#   controller  64Mi =  67108864 ->  60397977
#   edge       256Mi = 268435456 -> 241591910
helm_template_test(
    name = "aether_agent_gomemlimit_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "requests:\\n\\s+cpu: 200m\\n\\s+memory: 96Mi\\n",
            "limits:\\n\\s+memory: 128Mi\\n",
            "- name: GOMEMLIMIT\\n\\s+value: \"120795955\"\\n",
        ],
    },
)

# An operator override moves GOMEMLIMIT with the limit, still at 90%.
helm_template_test(
    name = "aether_agent_gomemlimit_override_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.resources.limits.memory=256Mi",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "limits:\\n\\s+memory: 256Mi\\n",
            "- name: GOMEMLIMIT\\n\\s+value: \"241591910\"\\n",
        ],
    },
)

# Decimal quantities are real Kubernetes quantities too: 1.5Gi -> 1449551462.
helm_template_test(
    name = "aether_agent_gomemlimit_decimal_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.resources.limits.memory=1.5Gi",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "- name: GOMEMLIMIT\\n\\s+value: \"1449551462\"\\n",
        ],
    },
)

# No memory limit: no GOMEMLIMIT (the Go runtime's default, no soft limit).
helm_template_absent_test(
    name = "aether_agent_gomemlimit_no_limit_test",
    absent = [
        "name: GOMEMLIMIT",
    ],
    chart = ":aether",
    control = "name: GOMAXPROCS",
    opts = [
        "--show-only",
        "templates/agent-daemonset.yaml",
        "--set",
        "agent.resources.limits.memory=null",
    ],
)

# A quantity the helper cannot read fails the render instead of silently
# shipping a container with no Go memory limit.
helm_template_fail_test(
    name = "aether_agent_gomemlimit_invalid_test",
    chart = ":aether",
    expected_message = "cannot derive GOMEMLIMIT from resources.limits.memory \"1e9\"",
    opts = [
        "--set",
        "agent.resources.limits.memory=1e9",
    ],
)

# The other Go workloads that set GOMEMLIMIT get the same 90%.
helm_template_test(
    name = "aether_gomemlimit_workloads_test",
    chart = ":aether",
    opts = [
        "--set",
        "edge.enabled=true",
    ],
    template_patterns = {
        "aether/templates/registrar-deployment.yaml": [
            "- name: GOMEMLIMIT\\n\\s+value: \"60397977\"\\n",
            "limits:\\n(\\s+cpu: \\S+\\n)?\\s+memory: 64Mi\\n",
        ],
        "aether/templates/controller-deployment.yaml": [
            "- name: GOMEMLIMIT\\n\\s+value: \"60397977\"\\n",
            "limits:\\n(\\s+cpu: \\S+\\n)?\\s+memory: 64Mi\\n",
        ],
        "aether/templates/edge-deployment.yaml": [
            "- name: GOMEMLIMIT\\n\\s+value: \"241591910\"\\n",
            "limits:\\n\\s+memory: 256Mi\\n",
        ],
    },
)

# ...and none of them hands the Go runtime the whole limit any more: the only
# `resource: limits.memory` reference was GOMEMLIMIT's resourceFieldRef.
helm_template_absent_test(
    name = "aether_gomemlimit_no_resource_field_ref_test",
    absent = [
        "resource: limits.memory",
    ],
    chart = ":aether",
    control = "name: GOMEMLIMIT",
    opts = [
        "--set",
        "edge.enabled=true",
    ],
)

# Proposal 038: the capture listeners bind with IP_TRANSPARENT, which the kernel
# checks as CAP_NET_ADMIN in the user namespace owning the pod netns -- the init
# userns here -- and Envoy's supportsIpTransparent() probe runs once in the HOST
# netns with the same requirement. Both fail SILENTLY without the capability: a
# missing grant means tproxy never assigns a packet to the socket and the probe
# quietly disables the original_dst fallback. So pin the grant against the
# packaged chart rather than trust the securityContext by eye.
helm_template_test(
    name = "aether_proxy_net_admin_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- NET_ADMIN",
        ],
    },
)

# #772 phase B2: the aether-proxy pod must run the carved-out supervisor image,
# not the 65MiB agent binary. Both halves are individually easy to half-change —
# the initContainer's image and the proxy container's command — and neither
# failure is visible until a rollout, so pin them against the packaged chart
# (where the `{@//...:image_push.repository}` placeholder is already resolved).
helm_template_test(
    name = "aether_proxy_supervisor_image_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            image_reference("proxy-supervisor") + "@sha256:",
            "--install-path=/opt/aether/supervisor",
            "--install-readiness-path=/opt/aether/proxy-ready",
        ],
    },
)

# #1050: --skip-hot-restart-parent-stats was the workaround for the hot-restart
# main-thread deadlock. The carried Envoy patch (#1060) fixes the deadlock, so
# the chart default is OFF again. rules_helm can only assert presence, so the
# default pins absence positionally: the last Envoy arg (--drain-strategy's
# value) is followed directly by the container's `env:`.
helm_template_test(
    name = "aether_proxy_skip_parent_stats_off_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- \"--envoy-arg=gradual\"\\n\\s+env:\\n",
        ],
    },
)

# ...and the emergency switch still renders it.
helm_template_test(
    name = "aether_proxy_skip_parent_stats_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.hotRestart.skipParentStats=true",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- \"--envoy-arg=--skip-hot-restart-parent-stats\"",
        ],
    },
)

# #1136: the opt-out that forces a hot restart across a worker-count change
# reaches the supervisor (default off: the flag is absent and the supervisor
# drains the predecessor and starts fresh instead).
helm_template_test(
    name = "aether_proxy_hot_restart_on_concurrency_change_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.hotRestart.hotRestartOnConcurrencyChange=true",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            "- \"--hot-restart-on-concurrency-change\"",
        ],
    },
)

# #1085: a hot-restart successor must never finish init without having received
# CDS and LDS. Envoy drains the parent only when the successor's init completes,
# and a timed-out initial fetch completes it with nothing loaded: a successor
# forked while the node agent was restarting went LIVE with zero listeners and
# took 18081 down with the parent. initial_fetch_timeout: 0s (no timer) on the
# bootstrap CDS/LDS config sources is the Envoy half of the fix; pin it against
# the packaged chart so a bootstrap edit cannot quietly drop it.
helm_template_test(
    name = "aether_proxy_bootstrap_cds_lds_wait_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-configmap.yaml": [
            "cds_config:\\n\\s+ads: \\{\\}\\n\\s+initial_fetch_timeout: 0s\\n",
            "lds_config:\\n\\s+ads: \\{\\}\\n\\s+initial_fetch_timeout: 0s\\n",
        ],
    },
)

# #1103: the proxy's ADS reconnect backoff is capped at 1 s. While the stream to
# the node agent is down the proxy routes on stale endpoints (DRAINING hosts
# included), and Envoy's 500 ms / 30 s default kept a proxy blind 8.4 s after
# its restarted agent was serving again. //test/envoy_validate checks the values
# and that Envoy accepts them; this pins them in the packaged chart.
helm_template_test(
    name = "aether_proxy_bootstrap_ads_reconnect_backoff_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-proxy-configmap.yaml": [
            "ads_config:\\n\\s+api_type: DELTA_GRPC\\n\\s+grpc_services:\\n\\s+- envoy_grpc:\\n\\s+cluster_name: agent_xds\\n\\s+retry_policy:\\n\\s+retry_back_off:\\n\\s+base_interval: 0.1s\\n\\s+max_interval: 1s\\n",
        ],
    },
)

# #1054: the proxy drains with --drain-strategy gradual by default (immediate
# made the stateless resets worse on talos-main); immediate stays an opt-in.
helm_template_test(
