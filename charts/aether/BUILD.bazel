            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"gatewayclasses\"", GET_LIST_WATCH),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"gatewayclasses/status\"", "\"get\", \"update\", \"patch\""),
            RULE % ("\"gateway\\.networking\\.k8s\\.io\"", "\"referencegrants\"", GET_LIST_WATCH),
            RULE % ("\"config\\.aether\\.io\"", "\"edgeconfigs\"", GET_LIST_WATCH),
            # Two grants on Services: the read that resolves backendRefs, and
            # (last, without downstream TLS) the write for the per-Gateway ones.
            RULE % ("\"\"", "\"services\"", GET_LIST_WATCH),
            RULE % ("\"\"", "\"namespaces\"", GET_LIST_WATCH),
            RULE % ("\"\"", "\"services\"", "\"create\", \"update\", \"patch\", \"delete\"") + "$",
        ],
