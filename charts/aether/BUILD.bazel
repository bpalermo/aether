# #1335: cni-install (the agent pod's init container, on every agent pod start)
# keeps its 100m CPU request and has NO CPU limit. Its work is at most 50-80 ms
# of CPU (byte-comparing the plugin already on the host with the one in the
# image); under a 100m quota -- 10 ms per 100 ms period -- that took 500-800 ms
# on all 40 agent starts measured, always a multiple of ~100 ms. Positional on the init container:
# its resources block is followed directly by the pod's `containers:` (the
# agent container's is followed by `volumes:`), and `limits:` carrying only
# memory proves there is no limits.cpu.
CNI_INSTALL_NO_CPU_LIMIT = "resources:\\n\\s+limits:\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\n\\s+containers:\\n"

helm_template_test(
    name = "aether_cni_install_cpu_resources_test",
    chart = ":aether",
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            CNI_INSTALL_NO_CPU_LIMIT,
        ],
    },
)

# An EMPTY limits.cpu is "no CPU limit" too: it is dropped (aether.resources),
# never rendered as `cpu: ""` (which the apiserver rejects as a quantity).
helm_template_test(
    name = "aether_cni_install_empty_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set",
        "cniInstall.resources.limits.cpu=",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            CNI_INSTALL_NO_CPU_LIMIT,
        ],
    },
)

# ...and an operator can still put a cap back.
helm_template_test(
    name = "aether_cni_install_cpu_limit_override_test",
    chart = ":aether",
    opts = [
        "--set",
        "cniInstall.resources.limits.cpu=500m",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "resources:\\n\\s+limits:\\n\\s+cpu: 500m\\n\\s+memory: 32Mi\\n\\s+requests:\\n\\s+cpu: 100m\\n\\s+memory: 32Mi\\n\\s+containers:\\n",
        ],
    },
)

# #1355: EVERY container's resources go through aether.resources, not only the
# four above (and install-supervisor, below). The seven that still used plain
# `toYaml` rendered `cpu: ""` for `--set <x>.resources.limits.cpu=`, which the
# apiserver rejects as a quantity. One test per container: with the CPU limit
# emptied, `limits:` carries memory only. Each pattern is positional (it ends on
# the line that follows that container's block), so it cannot be satisfied by
# another container of the same pod.

# The node agent: followed by the pod's `volumes:` (cni-install's block is
# followed by `containers:`).
helm_template_test(
    name = "aether_agent_empty_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set",
        "agent.resources.limits.cpu=",
    ],
    template_patterns = {
        "aether/templates/agent-daemonset.yaml": [
            "resources:\\n\\s+limits:\\n\\s+memory: 128Mi\\n\\s+requests:\\n\\s+cpu: 200m\\n\\s+memory: 96Mi\\n\\s+volumes:\\n",
        ],
    },
)

# The proxy: followed by its privileged securityContext (install-supervisor's
# block is followed by `containers:` or by the authz sidecar).
PROXY_NO_CPU_LIMIT = "resources:\\n\\s+limits:\\n\\s+memory: 512Mi\\n\\s+requests:\\n\\s+cpu: 500m\\n\\s+memory: 512Mi\\n\\s+securityContext:\\n\\s+privileged: true\\n"

helm_template_test(
    name = "aether_proxy_empty_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.resources.limits.cpu=",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            PROXY_NO_CPU_LIMIT,
        ],
    },
)

# The same block from a values file that nulls the quantity renders the same.
helm_template_test(
    name = "aether_proxy_null_cpu_limit_test",
    chart = ":aether",
    opts = [
        "--set-json",
        "proxy.resources.limits={\"cpu\":null}",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            PROXY_NO_CPU_LIMIT,
        ],
    },
)

# Every limit emptied: no `limits:` key at all (an empty map is dropped), the
