# #1275: the ext_authz sidecar is a Kubernetes NATIVE sidecar -- an init
# container with `restartPolicy: Always` -- ordered after install-supervisor
# (which stages the probe binary it execs) and before the proxy container, with
# a startupProbe that connects to the authz gRPC socket. The kubelet starts the
# proxy container only once that probe has passed, and stops the sidecar only
# after the proxy container has exited. As a regular container it was started
# AFTER the proxy, so a sidecar image pull left the new Envoy serving with no
# authz behind it (403s under failureMode DENY), and on deletion both got
# SIGTERM at once while the old Envoy was still draining.
AUTHZ_NATIVE_SIDECAR_ORDER = "(?s)initContainers:\\n.*\\n        - name: install-supervisor\\n.*\\n        - name: authz\\n          restartPolicy: Always\\n.*\\n      containers:\\n        - name: proxy\\n"

AUTHZ_DEFAULT_STARTUP_PROBE = "startupProbe:\\n\\s+exec:\\n\\s+command:\\n\\s+- \"/opt/aether/proxy-ready\"\\n\\s+- \"--unix-socket=/run/aether/authz/authz.sock\"\\n\\s+periodSeconds: 1\\n\\s+timeoutSeconds: 1\\n\\s+failureThreshold: 120\\n"

# ...and the proxy is the ONLY regular container: every line between
# `containers:` and `volumes:` belongs to the proxy (indented deeper than a list
# item) or is a comment/blank -- a second `- name:` item fails the match.
PROXY_ONLY_REGULAR_CONTAINER = "\\n      containers:\\n        - name: proxy\\n(?:(?:          [^\\n]*|        [^-\\n][^\\n]*|[ ]*)\\n)*      volumes:\\n"

helm_template_test(
    name = "aether_authz_native_sidecar_test",
    chart = ":aether",
    opts = [
        "--set",
        "proxy.authzSidecar.enabled=true",
        "--set",
        "proxy.authzSidecar.opa.enabled=true",
        "--set",
        "proxy.authzSidecar.opa.policy=package envoy.authz",
    ],
    template_patterns = {
        "aether/templates/agent-proxy-daemonset.yaml": [
            AUTHZ_NATIVE_SIDECAR_ORDER,
            AUTHZ_DEFAULT_STARTUP_PROBE,
            PROXY_ONLY_REGULAR_CONTAINER,
            # The probe binary is exec'd INSIDE the sidecar's container, so the
            # staged volume must be mounted there.
            "- name: authz\\n(?s:.*)- name: supervisor-bin\\n\\s+mountPath: /opt/aether\\n\\s+readOnly: true\\n(?s:.*)\\n      containers:\\n",
        ],
    },
)

# A bring-your-own sidecar gets the same ordering and the same probe: the
# contract it must already meet (serve on unix:///run/aether/authz/authz.sock)
