load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("//bazel/img:registry.bzl", "IMAGE_REGISTRY", "chart_registry_url")

# udsecho validation chart (published as chart_repository("udsecho") under IMAGE_REGISTRY; see //bazel/img:registry.bzl).
#
# Publish targets (OCI; registry from //bazel/img:registry.bzl):
#   bazel run //charts/udsecho:udsecho.push           # chart + image
#   bazel run //charts/udsecho:udsecho.push_registry  # chart only
# Authenticate first via HELM_REGISTRY_USERNAME / HELM_REGISTRY_PASSWORD.
helm_chart(
    name = "udsecho",
    chart = "Chart.yaml",
    images = [
        "//e2e/udsecho:image_push",
    ],
    login_url = IMAGE_REGISTRY,
    registry_url = chart_registry_url(),
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

helm_lint_test(
    name = "udsecho_lint_test",
    chart = ":udsecho",
)

helm_template_test(
    name = "udsecho_template_test",
    chart = ":udsecho",
)
