+
+void ConnectionManagerImpl::armIdleHttp3DrainTimer(
+    const Network::ConnectionDrainEvent& drain_event) {
+  if (!drain_idle_http3_connections_ ||
+      (codec_ != nullptr && codec_->protocol() != Protocol::Http3)) {
+    return;
+  }
+  // The drain-close decision is otherwise only taken when a response is encoded, so a connection
+  // with no request in the drain window never learns of the drain: the client keeps it, and keeps
+  // sending on it, until the server goes away without a word. For HTTP/3 that ends in a stateless
+  // reset for whatever the client sends next, so schedule a drain sequence of our own inside the
+  // window. Only the event may be recorded here (this can run from the connection's constructor
+  // via addConnectionCallbacks()); the codec is looked at when the timer fires.
+  //
+  // This is separate from the proactive drain onDrain() arms first: that one only covers the last
+  // third of the drain time and arms nothing when the drain time leaves no room for it after the
+  // drain timeout (a 10s drain time with the default 5s drain timeout), so on its own it leaves
+  // such an idle HTTP/3 connection to the stateless reset. Whichever timer fires first starts the
+  // drain sequence; the other then finds the connection draining.
+  //
+  // Immediate: now. Gradual: uniformly within the drain window, leaving room for the drain
+  // timeout so the GOAWAY and the close both land before the window ends; the window is measured
+  // from the drain's start, which may predate this connection.
+  std::chrono::milliseconds delay{0};
+  if (drain_event.strategy == Server::DrainStrategy::Gradual) {
+    const auto drain_time =
+        std::chrono::duration_cast<std::chrono::milliseconds>(server_context_.options().drainTime());
+    const auto window =
+        drain_time > config_->drainTimeout() ? drain_time - config_->drainTimeout() : delay;
+    const MonotonicTime now = server_context_.timeSource().monotonicTime();
+    const auto elapsed =
+        now <= drain_event.start_time
+            ? std::chrono::milliseconds{0}
+            : std::chrono::duration_cast<std::chrono::milliseconds>(now - drain_event.start_time);
+    const auto remaining = window > elapsed ? window - elapsed : delay;
+    if (remaining.count() > 0) {
+      delay = std::chrono::milliseconds{
+          static_cast<int64_t>(server_context_.api().randomGenerator().random() %
+                               static_cast<uint64_t>(remaining.count() + 1))};
+    }
+  }
+  idle_drain_timer_ = dispatcher_->createTimer([this]() -> void { onIdleDrainTimeout(); });
+  idle_drain_timer_->enableTimer(delay);
+}
+
+void ConnectionManagerImpl::onIdleDrainTimeout() {
+  // A codec exists once the first bytes arrived; a connection with none yet has nothing to send
+  // a GOAWAY on, and its first response takes the regular drain-close decision. Only HTTP/3 is
+  // pushed here: it is the protocol whose lingering connections end in a stateless reset.
+  if (drain_state_ != DrainState::NotDraining || codec_ == nullptr ||
+      codec_->protocol() != Protocol::Http3) {
     return;
   }
-  proactive_drain_timer_ =
-      dispatcher_->createTimer([this]() -> void { onProactiveDrainTimeout(); });
-  proactive_drain_timer_->enableTimer(delay);
+  ENVOY_CONN_LOG(debug, "drain closing idle connection", read_callbacks_->connection());
+  startDrainSequence();
+  stats_.named_.downstream_cx_drain_close_.inc();
 }
 
