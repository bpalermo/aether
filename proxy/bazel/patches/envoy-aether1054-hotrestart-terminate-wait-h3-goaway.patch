+  EXPECT_CALL(*idle_drain_timer, enableTimer(std::chrono::milliseconds(0), _));
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{start, Server::DrainStrategy::Gradual});
+}
+
+// A connection that is already draining when the timer fires does not start a second sequence.
+TEST_F(HttpConnectionManagerImplTest, Http3IdleConnectionDrainDoesNotStartTwice) {
+  setup(SetupOpts().setSsl(true));
+  codec_->protocol_ = Protocol::Http3;
+
+  MockStreamDecoderFilter* filter = new NiceMock<MockStreamDecoderFilter>();
+  EXPECT_CALL(filter_factory_, createFilterChain(_))
+      .WillOnce(Invoke([&](FilterChainFactoryCallbacks& callbacks) -> bool {
+        auto factory = createDecoderFilterFactoryCb(StreamDecoderFilterSharedPtr{filter});
+        callbacks.setFilterConfigName("");
+        factory(callbacks);
+        return true;
+      }));
+  EXPECT_CALL(*filter, decodeHeaders(_, true)).WillOnce(Return(FilterHeadersStatus::StopIteration));
+  EXPECT_CALL(*codec_, dispatch(_)).WillOnce(Invoke([&](Buffer::Instance&) -> Http::Status {
+    decoder_ = &conn_manager_->newStream(response_encoder_);
+    RequestHeaderMapPtr headers{
+        new TestRequestHeaderMapImpl{{":authority", "host"}, {":path", "/"}, {":method", "GET"}}};
+    decoder_->decodeHeaders(std::move(headers), true);
+    return Http::okStatus();
+  }));
+  Buffer::OwnedImpl fake_input;
+  conn_manager_->onData(fake_input, false);
+
+  Event::MockTimer* idle_drain_timer = setUpTimer();
+  EXPECT_CALL(*idle_drain_timer, enableTimer(std::chrono::milliseconds(0), _));
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{{}, Server::DrainStrategy::Immediate});
+
+  // The response's drain-close decision starts the drain first.
+  Event::MockTimer* drain_timer = setUpTimer();
+  EXPECT_CALL(*drain_timer, enableTimer(_, _));
+  EXPECT_CALL(*codec_, shutdownNotice());
+  ResponseHeaderMapPtr response_headers{new TestResponseHeaderMapImpl{{":status", "200"}}};
+  filter->callbacks_->streamInfo().setResponseCodeDetails("");
+  filter->callbacks_->encodeHeaders(std::move(response_headers), true, "details");
+  response_encoder_.stream_.codec_callbacks_->onCodecEncodeComplete();
+  EXPECT_EQ(1U, stats_.named_.downstream_cx_drain_close_.value());
+
+  // The idle drain timer then finds the connection draining and does nothing more.
+  idle_drain_timer->invokeCallback();
+  EXPECT_EQ(1U, stats_.named_.downstream_cx_drain_close_.value());
+
+  EXPECT_CALL(*codec_, goAway());
+  EXPECT_CALL(filter_callbacks_.connection_,
+              close(Network::ConnectionCloseType::FlushWriteAndDelay, _));
+  EXPECT_CALL(*drain_timer, disableTimer());
+  drain_timer->invokeCallback();
+}
+
+// Only HTTP/3 is pushed: an HTTP/2 connection keeps the regular response-time decision.
+TEST_F(HttpConnectionManagerImplTest, Http2IdleConnectionIsNotDrainedByTimer) {
+  setup();
+  codec_->protocol_ = Protocol::Http2;
+  EXPECT_CALL(*codec_, dispatch(_)).WillOnce(Return(Http::okStatus()));
+  Buffer::OwnedImpl fake_input;
+  conn_manager_->onData(fake_input, false);
+
+  EXPECT_CALL(filter_callbacks_.connection_.dispatcher_, createTimer_(_)).Times(0);
+  EXPECT_CALL(*codec_, shutdownNotice()).Times(0);
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{{}, Server::DrainStrategy::Immediate});
+}
+
+// A connection notified before its codec exists (the drain predates the connection) is checked
+// when the timer fires: without a codec there is nothing to send a GOAWAY on.
+TEST_F(HttpConnectionManagerImplTest, Http3IdleConnectionDrainWaitsForCodec) {
+  setup();
+  Event::MockTimer* idle_drain_timer = setUpTimer();
+  EXPECT_CALL(*idle_drain_timer, enableTimer(std::chrono::milliseconds(0), _));
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{{}, Server::DrainStrategy::Immediate});
+  EXPECT_CALL(*codec_, shutdownNotice()).Times(0);
+  idle_drain_timer->invokeCallback();
+  EXPECT_EQ(0U, stats_.named_.downstream_cx_drain_close_.value());
+
+  // The codec arrives afterwards; its first response takes the regular drain-close decision.
+  EXPECT_CALL(*codec_, dispatch(_)).WillOnce(Return(Http::okStatus()));
+  Buffer::OwnedImpl fake_input;
+  conn_manager_->onData(fake_input, false);
+}
+
+// The behavior is behind a runtime guard.
+TEST_F(HttpConnectionManagerImplTest, Http3IdleConnectionDrainDisabledByRuntime) {
+  TestScopedRuntime scoped_runtime;
+  scoped_runtime.mergeValues({{"envoy.reloadable_features.http3_drain_idle_connections", "false"}});
+  setup();
+  codec_->protocol_ = Protocol::Http3;
+  EXPECT_CALL(*codec_, dispatch(_)).WillOnce(Return(Http::okStatus()));
+  Buffer::OwnedImpl fake_input;
+  conn_manager_->onData(fake_input, false);
+
+  EXPECT_CALL(filter_callbacks_.connection_.dispatcher_, createTimer_(_)).Times(0);
+  EXPECT_CALL(*codec_, shutdownNotice()).Times(0);
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{{}, Server::DrainStrategy::Immediate});
+}
