+// An HTTP/3 connection that is idle when a graceful drain starts still gets a GOAWAY: it does
+// not have to send a request for the drain-close decision to be taken on its response.
+TEST_P(QuicHttpIntegrationTest, IdleConnectionGetsGoAwayOnGracefulDrain) {
+  initialize();
+  codec_client_ = makeHttpConnection(lookupPort("http"));
+  // One request, so the server side has a codec to send the GOAWAY on; then the connection idles.
+  auto response = codec_client_->makeHeaderOnlyRequest(default_request_headers_);
+  waitForNextUpstreamRequest();
+  upstream_request_->encodeHeaders(default_response_headers_, true);
+  ASSERT_TRUE(response->waitForEndStream());
+
+  BufferingStreamDecoderPtr admin_response = IntegrationUtil::makeSingleRequest(
+      lookupPort("admin"), "POST", "/drain_listeners?graceful", "", Http::CodecType::HTTP1,
+      version_);
+  EXPECT_EQ("200", admin_response->headers().getStatusValue());
+
+  // The server drains the idle connection on its own: GOAWAY, then close after the drain timeout.
+  test_server_->waitForCounter("http.config_test.downstream_cx_drain_close", 1);
+  ASSERT_TRUE(codec_client_->waitForDisconnect());
+  EXPECT_TRUE(codec_client_->sawGoAway());
+}
