+// With the gradual strategy the drain sequence is scheduled at a random point inside the drain
+// window, leaving the drain timeout so that the GOAWAY and the close both land before the window
+// ends, and measured from the drain's start rather than from the notification. A drain time this
+// long also arms the proactive drain timer, for the last third of the window: the idle HTTP/3
+// timer is armed beside it, fires first, and the proactive one then finds the connection draining.
+TEST_F(HttpConnectionManagerImplTest, Http3IdleConnectionDrainsInsideGradualDrainWindow) {
+  setup();
+  codec_->protocol_ = Protocol::Http3;
+  EXPECT_CALL(*codec_, dispatch(_)).WillOnce(Return(Http::okStatus()));
+  Buffer::OwnedImpl fake_input;
+  conn_manager_->onData(fake_input, false);
+
+  auto& server_context = factory_context_.server_factory_context_;
+  EXPECT_CALL(server_context.options_, drainTime())
+      .WillRepeatedly(Return(std::chrono::seconds(600)));
+  // Window: 600s drain time - 100ms drain timeout (the fixture's) - 100s already elapsed =
+  // 499900ms.
+  const MonotonicTime start = server_context.timeSource().monotonicTime();
+  test_time_.advanceTimeWait(std::chrono::seconds(100));
+  // The proactive timer is armed first and draws first: its window is [400s, 599.9s] from the
+  // drain's start, so 12345 % 199900 lands it at 400s + 12345ms - 100s elapsed. The idle HTTP/3
+  // timer draws second: 1000000 % (499900 + 1) == 198.
+  EXPECT_CALL(server_context.api_.random_, random())
+      .WillOnce(Return(12345))
+      .WillOnce(Return(1000000));
+  // The mock dispatcher hands out the most recently set up timer first.
+  Event::MockTimer* idle_drain_timer = setUpTimer();
+  Event::MockTimer* proactive_drain_timer = setUpTimer();
+  EXPECT_CALL(*proactive_drain_timer, enableTimer(std::chrono::milliseconds(312345), _));
+  EXPECT_CALL(*idle_drain_timer, enableTimer(std::chrono::milliseconds(198), _));
+  filter_callbacks_.connection_.raiseConnectionDrain(
+      Network::ConnectionDrainEvent{start, Server::DrainStrategy::Gradual});
+
+  Event::MockTimer* drain_timer = setUpTimer();
+  EXPECT_CALL(*drain_timer, enableTimer(_, _));
+  EXPECT_CALL(*codec_, shutdownNotice());
+  idle_drain_timer->invokeCallback();
+  EXPECT_EQ(1U, stats_.named_.downstream_cx_drain_close_.value());
+
+  // The proactive timer finds the drain sequence running and starts nothing of its own.
+  proactive_drain_timer->invokeCallback();
+  EXPECT_EQ(1U, stats_.named_.downstream_cx_drain_close_.value());
