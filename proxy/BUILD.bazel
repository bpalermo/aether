load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@envoy//bazel:envoy_build_system.bzl", "envoy_cc_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Custom aether Envoy: upstream core extensions (//bazel/build_config) plus
# our compiled-in C++ extensions.
AETHER_EXTENSIONS = [
    # aether_stats: source->destination request metrics (proposals 007/012).
    "//source/extensions/filters/http/aether_stats:config",
]

envoy_cc_binary(
    name = "envoy",
    # NOTE: deliberately NOT `stamped = True`, and deliberately no `linkopts`
    # here. See the `--build-id=sha1` --linkopt in .bazelrc.
    #
    # `stamped = True` is Envoy's own mechanism (`--build-id=0x<BUILD_SCM_REVISION>`
    # via a generated ldscript). It works for upstream because they ship one
    # binary per commit; aether ships seven, and a commit-derived id makes all
    # seven share one GNU build-ID — which is the only key the Pyroscope
    # symbolizer joins samples to symbols by, so one debuginfo upload would
    # silently resolve all of them (aether #653).
    #
    # `linkopts = [...]` is not the way to add the flag either: envoy_cc_binary
    # does `if not linkopts: linkopts = _envoy_linkopts()`, so passing any
    # linkopts *replaces* Envoy's defaults (-pthread, -lrt, -ldl, -z relro/now,
    # --hash-style=gnu, -pie, -Wl,-E). The flag therefore goes on the command
    # line via --linkopt, exactly as .bazelrc itself passes -fuse-ld=lld.
    # //integration:build_id_test reads the linked ELF directly.
    visibility = ["//integration:__pkg__"],
    deps = AETHER_EXTENSIONS + [
        "@envoy//source/exe:envoy_main_entry_lib",
    ],
)

# The custom Envoy binary at /usr/local/bin/envoy.
pkg_tar(
    name = "envoy_tar",
    srcs = [":envoy"],
    extension = "tar.gz",
    mode = "0755",
    owner = "0.0",
    package_dir = "/usr/local/bin/",
    tags = ["manual"],
)

# OCI provenance for the image below (aether #837): the aether commit, this
# repository as `org.opencontainers.image.source` (which OVERRIDES the value
# inherited from distroless/cc, that used to be the image's only annotation and
# pointed at GoogleContainerTools/distroless), and the Envoy pin — module
# version, upstream commit and bazel-registry commit — which is the one fact
# about a running proxy that is recoverable no other way.
#
# Used for BOTH `labels` (image config) and `annotations` (manifest), so the
# Envoy pin is readable from `crane manifest` without pulling the config blob.
#
# This adds no timestamp: `created` stays unset and the history entries stay
# `bazel bu…`. The image is still bit-for-bit reproducible at a given commit.
genrule(
    name = "image_metadata",
    srcs = [
        ".bazelrc",
        "MODULE.bazel",
    ],
    outs = ["image_metadata.txt"],
    cmd = "$(location //bazel:image_metadata.sh) $(location MODULE.bazel) $(location .bazelrc) >$@",
    # Undocumented genrule attr that makes the workspace status files inputs
    # (bazelbuild/bazel#4942). Envoy's own
    # //source/common/version:generate_version_linkstamp uses it for the same
    # reason.
    stamp = 1,
    # BUILD_SCM_REVISION is a VOLATILE status key, and Bazel deliberately treats
    # volatile-status.txt as constant metadata so it invalidates nothing. Left
    # cacheable, this action would happily reuse an earlier commit's sha and
    # stamp the image with it — a confidently wrong provenance answer, which is
    # the failure mode #837 exists to remove. Re-running two `sed`s on every
    # build is free, and the output is byte-identical at a given commit, so
    # :image and :push below still get action-cache hits.
    tags = ["no-cache"],
    tools = ["//bazel:image_metadata.sh"],
)

# Custom aether-proxy image: distroless/cc base + the custom Envoy binary.
# Single-arch, built for the build host's native arch. Multi-arch is assembled in
# CI from two native per-arch builds (amd64 on ubuntu-latest, arm64 on
# ubuntu-24.04-arm) rather than cross-compiled — Envoy's arm64 cross-compile is
# unreliable (LuaJIT host-tool linker); native per-arch is how upstream Envoy
# builds it too (separate RBE pools).
oci_image(
    name = "image",
    annotations = ":image_metadata",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/envoy"],
    labels = ":image_metadata",
    tars = [
        ":envoy_tar",
    ],
    visibility = ["//visibility:public"],
    workdir = "/",
)

# Pushes the single-arch image. The release workflow passes per-arch tags at push
# time (`bazel run //:push -- --tag dev-<arch> --tag <sha>-<arch>`); a combine job
# then assembles the multi-arch manifest.
oci_push(
    name = "push",
    image = ":image",
    remote_tags = [],
    repository = "ghcr.io/bpalermo/aether/aether-proxy",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["ghcr.io/bpalermo/aether/aether-proxy:latest"],
)

# Materialize the loadable image tarball for the structure test. rules_oci only
# produces the tar via the `tarball` output group (it's expensive), so extract it
# with a filegroup rather than referencing a (non-existent) :load.tar target.
filegroup(
    name = "image_tarball",
    srcs = [":load"],
    output_group = "tarball",
)

# PR gate (`bazel test //...`): builds the custom Envoy + image on RBE and
# validates the image's structure. The `tar` driver runs against the image
# tarball directly — no docker daemon, RBE-friendly. (The aether_stats filter
# ships its own envoy_cc_test under source/extensions/filters/http/aether_stats.)
container_structure_test(
    name = "image_test",
    configs = ["//integration:image.yaml"],
    driver = "tar",
    # The tar driver needs a .tar, not the oci_image — the oci_load tarball.
    image = ":image_tarball",
)
