# aether-proxy build configuration.
#
# Sections marked UPSTREAM are tracked against envoyproxy/examples/filter-cc's
# .bazelrc (the downstream-build template) plus the parts of Envoy's own .bazelrc
# that a downstream build still needs. Re-diff both on an Envoy bump:
#   curl -sSL https://raw.githubusercontent.com/envoyproxy/examples/main/filter-cc/.bazelrc
#   gh api "repos/envoyproxy/envoy/contents/.bazelrc?ref=<pinned sha>" --jq .content | base64 -d
# Sections marked AETHER are ours; keep them when re-syncing.
#
# There is no envoy.bazelrc any more: before #697 this file `import`ed a 21 KB
# vendored copy of Envoy v1.39.0's own .bazelrc, ~300 lines of which (asan/tsan/
# msan/fuzz/coverage/docker/gcc/macos) a downstream build never uses.

#############################################################################
# UPSTREAM: bzlmod + registries
#############################################################################

common --enable_bzlmod
common --noenable_workspace

# The registry commit and the envoy/envoy_api versions in MODULE.bazel are ONE
# pin. The envoy bazel-registry keeps a single rolling dev snapshot per module and
# DELETES the previous version directory on every bump, so an unpinned registry
# breaks the build the next time upstream publishes. 5db29c09 is the commit at
# which envoy@1.40.0-dev.20261009.189f198.envoy, envoy_api at the same snapshot,
# and the full transitive .envoy-suffixed closure all resolve (registry #269/#270,
# 2026-10-09). See README.md "Envoy version bumps" for the recipe.
#
# Why this bump (2026-10-10, aether#980): 189f198 is the first snapshot cut after
# the 2026-09-30 upstream merges of envoyproxy/envoy#47743 (UDP hot-restart
# forwarding keyed by listener address + network namespace) and #47776
# (execInNetworkNamespace restores the calling thread's namespace), so the two
# patches carried for them are dropped; it also brings #47492 (a hot-restart
# successor inherits its listen sockets before entering the network namespace).
# The previous pin moved for envoyproxy/envoy#47623 (QUIC downstream mTLS from
# SDS), which every later snapshot contains.
common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/5db29c09de17218d24f58c665be38208284754d8

#############################################################################
# UPSTREAM: global
#############################################################################

startup --host_jvm_args=-Xmx3g
startup --host_jvm_args="-DBAZEL_TRACK_SOURCE_DIRECTORIES=1"

common --color=yes
common --noincompatible_disallow_empty_glob
common --noincompatible_disallow_ctx_resolve_tools
common --legacy_external_runfiles
common --incompatible_allow_tags_propagation
common --repo_env=ANDROID_HOME=

build --incompatible_strict_action_env
build --java_runtime_version=remotejdk_11
build --tool_java_runtime_version=remotejdk_11
build --java_language_version=11
build --tool_java_language_version=11
build --extra_toolchains=@envoy//bazel:envoy_java_toolchain_definition
# silence absl logspam.
build --copt=-DABSL_MIN_LOG_LEVEL=4
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build --copt=-Wno-deprecated-declarations
build --copt=-Wno-nullability-completeness
build --per_file_copt=external/cel-cpp.*,.*/filters/common/expr/.*,.*/matching/.*cel.*@-Wno-nullability-completeness
build --define envoy_mobile_listener=enabled
build --experimental_repository_downloader_retries=2
build --experimental_cc_static_library
build --enable_platform_specific_config
build --incompatible_merge_fixed_and_default_shell_env
build --incompatible_config_setting_private_default_visibility
build --incompatible_enforce_config_setting_visibility
# We already have absl in the build; tell googletest to use it for backtrace.
build --define absl=1
# A workaround for slow ICU download (kept from Envoy's .bazelrc).
build --http_timeout_scaling=6.0
build --test_summary=terse

test --test_verbose_timeout_warnings
test --experimental_ui_max_stdouterr_bytes=11712829 #default 1048576

#############################################################################
# UPSTREAM: module wiring (Envoy's own .bazelrc at the pinned snapshot)
#
# Envoy removed WORKSPACE (envoyproxy/envoy#47217) and with it the
# `--@quiche//:*_impl_lib`, `--@grpc//third_party:*`, `--@googleurl//...` and
# `--@protobuf//:zlib` flag lines that WORKSPACE macros used to need: the
# registry modules now carry those wirings themselves. What is left below is the
# set upstream's root .bazelrc sets at the pinned snapshot, plus
# `prefer_prebuilt_protoc` (upstream's root file dropped it in envoyproxy/envoy#47806;
# the filter-cc template and upstream's own downstream test, bazel/tests/external,
# still set it) and the one aether-specific line (the wasm engine).
#############################################################################

# Refuse deprecated `repo = ...` args in Envoy's own macros (upstream default).
common --@envoy//bazel:deprecated_repo_arg_allowed=false

# Protobuf: use the prebuilt protoc, and make compiling one a LOUD failure --
# upstream's guard against a toolchain that silently falls back to a
# from-source protoc build.
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --per_file_copt=bazel-out/.*/bin/external/protobuf.*/protoc@--THIS_CC_TOOLCHAIN_IS_BROKEN

# No wasm engine — see bazel/build_config/extensions_build_config.bzl, which drops
# every wasm extension. The two MUST agree.
common --@proxy-wasm-cpp-host//bazel:engine=disabled

common --@rules_python//python/config_settings:bootstrap_impl=script

common --@rules_rust//rust/settings:skip_fission_for_rust=true
build --@rules_rust//rust/settings:rustfmt.toml=@envoy//:rustfmt.toml

#############################################################################
# UPSTREAM: linux codegen (from Envoy's own .bazelrc `build:linux` block — NOT in
# the filter-cc template, but load-bearing here)
#############################################################################

# --fission=dbg,opt is what parks DWARF in .dwo files that never enter the image;
# the `--strip=always` / .symtab story below depends on it (aether #651).
build:linux --copt=-fdebug-types-section
build:linux --copt=-fPIC
build:linux --cxxopt=-fsized-deallocation --host_cxxopt=-fsized-deallocation
build:linux --conlyopt=-fexceptions
build:linux --fission=dbg,opt
build:linux --features=per_object_debug_info

#############################################################################
# UPSTREAM: hermetic clang toolchain (toolchains_llvm 1.9.1.envoy, LLVM 22.1.8)
#
# envoyproxy/envoy#47806 (in the pinned snapshot) removed `--config=clang` from
# Envoy's own .bazelrc: clang with libc++ is its default toolchain and the standard
# library is derived from the compiler, so the `--@envoy//bazel:libc++` flag and
# the `force_libcpp` define no longer exist and are gone from the `libc++` config
# below. The rest of these configs is kept as it was: the flags are still valid,
# and they are what this workspace's two RBE legs have been built with.
#############################################################################

common:clang-common --linkopt=-fuse-ld=lld
common:clang-common --@toolchains_llvm//toolchain/config:compiler-rt=false
common:clang-common --@toolchains_llvm//toolchain/config:libunwind=false

common:libc++ --action_env=CXXFLAGS=-stdlib=libc++
common:libc++ --action_env=LDFLAGS="-stdlib=libc++ -fuse-ld=lld"
common:libc++ --action_env=BAZEL_CXXOPTS=-stdlib=libc++
common:libc++ --action_env=BAZEL_LINKLIBS=-l%:libc++.a:-l%:libc++abi.a
common:libc++ --action_env=BAZEL_LINKOPTS=-lm:-pthread

common:clang --config=clang-common
common:clang --config=libc++
common:clang --host_platform=@clang_platform
common:clang --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# @clang_platform is an arch_alias resolved from the DRIVER host's arch, so this
# line is also what makes a native-arm64 driver produce an aarch64-EXEC toolchain.
# That is why the arm64 CI leg runs on ubuntu-24.04-arm — see .github/workflows/.
common --config=clang

#############################################################################
# AETHER: build-ID (#651/#653)
#############################################################################

# Give the linked Envoy a GNU build-ID derived from its own content. This is the
# only key the Pyroscope symbolizer joins samples to uploaded debuginfo by, so it
# has to identify *this* ELF and nothing else: `sha1` makes lld hash the linked
# output, so the id is unique by construction, reproducible for identical inputs,
# and can never collide with the six Go binaries (//bazel/buildid).
#
# The hermetic toolchain passes `-Wl,--build-id=md5` earlier on the link command
# line; lld honours the LAST --build-id, so this line wins and widens the note from
# a 16-byte md5 to the 20-byte sha1 debuginfod/Pyroscope tooling uses.
# proxy-release.yml asserts the ordering with `bazel aquery` before publishing.
#
# It is a --linkopt rather than `linkopts` on //:envoy because envoy_cc_binary does
# `if not linkopts: linkopts = _envoy_linkopts()` — passing linkopts to the target
# would silently drop Envoy's own default link flags (bazel/envoy_binary.bzl).
build --linkopt=-Wl,--build-id=sha1

#############################################################################
# AETHER: stamping + jobs
#############################################################################

build --jobs=HOST_CPUS-1
build --workspace_status_command="bash bazel/get_workspace_status"

#############################################################################
# AETHER: release / ci
#############################################################################

# Optimized release build — the binary baked into the proxy image. Plain
# `bazel build //:image` is fastbuild (dev); image build paths (CI, the Makefile
# load/push targets, the README) pass --config=release.
#
# `--strip=always` is NOT a full strip, despite the name: Bazel maps it to the
# linker's `--strip-debug`, so it removes DWARF and KEEPS `.symtab` (~22 MB,
# ~944k symbols here). DWARF is redundant anyway — `--fission=dbg,opt` (above)
# parks it in .dwo files that never enter the image.
#
# Keeping the symbol table is deliberate and load-bearing (aether #651): the
# OpenTelemetry eBPF profiler does not symbolize native frames in-agent, so
# Pyroscope needs this build's symbols. Do not "finish the job" with `-Wl,-s` /
# `--strip-all`. //integration:symtab_test fails the build if that happens.
build:release -c opt
build:release --strip=always

build:ci --config=release
# BuildBuddy invocation metadata (https://www.buildbuddy.io/docs/guide-metadata).
# Dynamic metadata (COMMIT_SHA/REPO_URL/BRANCH_NAME) is passed by the CI workflow.
build:ci --build_metadata=ROLE=CI
build:ci --build_metadata=VISIBILITY=PUBLIC
build:ci --color=yes
common:ci --noshow_progress
common:ci --noshow_loading_progress
common:ci --test_output=errors

#############################################################################
# AETHER: BuildBuddy remote cache (no execution)
#############################################################################

# Auth is a secret: user.bazelrc (gitignored) / CI --remote_header, one line:
#   build:bb-cache --remote_header=x-buildbuddy-api-key=YOUR_ORG_API_KEY
build:bb-cache --remote_cache=grpcs://remote.buildbuddy.io
build:bb-cache --bes_backend=grpcs://remote.buildbuddy.io
build:bb-cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:bb-cache --remote_cache_compression
# Don't ZSTD-compress blobs < 100 bytes (compression would inflate them).
build:bb-cache --experimental_remote_cache_compression_threshold=100
# Shrink the uploaded build event stream: drop duplicate file references.
build:bb-cache --nolegacy_important_outputs
build:bb-cache --remote_timeout=3600s
build:bb-cache --grpc_keepalive_time=30s
# Richer timing profile in the BuildBuddy UI (per-target/output detail).
build:bb-cache --noslim_profile
build:bb-cache --experimental_profile_include_target_label
build:bb-cache --experimental_profile_include_primary_output

#############################################################################
# AETHER: BuildBuddy RBE
#############################################################################

# `rbe-buildbuddy` is the shared BASE (no platform). Pick an arch overlay:
#   --config=rbe-buildbuddy-amd64   (x64 pool;   x64 driver)
#   --config=rbe-buildbuddy-arm64   (arm64 pool; MUST run on an arm64 driver)
#
# @clang_platform sets dockerNetwork "standard" (an EngFlow value BuildBuddy
# rejects) — //bazel/platforms overrides it to "off".
#
# Auth goes on the base so both overlays inherit it (gitignored user.bazelrc):
#   build:rbe-buildbuddy --remote_header=x-buildbuddy-api-key=KEY
build:rbe-buildbuddy --config=clang
build:rbe-buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:rbe-buildbuddy --nolegacy_important_outputs
build:rbe-buildbuddy --remote_cache_compression
build:rbe-buildbuddy --experimental_remote_cache_compression_threshold=100
build:rbe-buildbuddy --remote_timeout=3600s
build:rbe-buildbuddy --grpc_keepalive_time=30s
build:rbe-buildbuddy --jobs=200
build:rbe-buildbuddy --remote_download_toplevel
build:rbe-buildbuddy --spawn_strategy=remote,local

# x64 overlay: host/exec = BuildBuddy x64 pool.
build:rbe-buildbuddy-amd64 --config=rbe-buildbuddy
build:rbe-buildbuddy-amd64 --host_platform=//bazel/platforms:rbe_buildbuddy_amd64
build:rbe-buildbuddy-amd64 --extra_execution_platforms=//bazel/platforms:rbe_buildbuddy_amd64

# arm64 overlay: host/exec = BuildBuddy's native arm64 pool.
#
# @clang_platform and Envoy's @llvm_toolchain derive their exec constraints from
# the DRIVER host's arch (envoy_toolshed's arch_alias reads ctx.os.arch, and
# toolchains_llvm reads rctx.os.arch), so this overlay is only valid from an
# aarch64 driver — i.e. a native arm64 runner. Both proxy.yml and
# proxy-release.yml run the arm64 leg on `ubuntu-24.04-arm`.
#
# --modify_execution_info=Genrule=-local strips the "local" execution requirement
# from genrules so they run on the remote arm64 executor rather than on the
# driver. Kept from the WORKSPACE era: it is proven on this pool, and a genrule
# that resolves an arm64 $(PYTHON3) but executes on the driver is a failure mode
# worth not re-litigating on a cold multi-hour build.
build:rbe-buildbuddy-arm64 --config=rbe-buildbuddy
build:rbe-buildbuddy-arm64 --host_platform=//bazel/platforms:rbe_buildbuddy_arm64
build:rbe-buildbuddy-arm64 --extra_execution_platforms=//bazel/platforms:rbe_buildbuddy_arm64
build:rbe-buildbuddy-arm64 --modify_execution_info=Genrule=-local

try-import %workspace%/user.bazelrc
