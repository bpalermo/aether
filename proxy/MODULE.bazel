# aether-proxy: a custom Envoy build, as a bzlmod module.
#
# Still a SEPARATE Bazel workspace from the root aether module (listed in the
# root //.bazelignore). Build it explicitly: `cd proxy && bazel build //:image`.
# Modeled on envoyproxy/examples/filter-cc @ main (the upstream downstream-build
# template) — see docs/proposals/010.
#
# ENVOY PIN: the `envoy`/`envoy_api` versions below and the
# `--registry=…/bazel-registry/<commit>` line in .bazelrc are ONE pin and must
# move together. The envoy bazel-registry keeps exactly one version per module
# and DELETES the old directory on every bump, so an unpinned (or mismatched)
# registry commit makes this module unresolvable. See README.md "Envoy bumps".
module(
    name = "aether_proxy",
    version = "0.0.0",
)

####################################################################################
# Envoy
####################################################################################

bazel_dep(name = "envoy", version = "1.40.0-dev.20261009.189f198.envoy")
bazel_dep(name = "envoy_api", version = "1.40.0-dev.20261009.189f198.envoy")

# Carried fixes, applied to the registry module at fetch time
# (README "Customizing": a patch is the exception, not the mechanism).
# No longer carried, because the pinned snapshot contains them (aether#980):
# envoyproxy/envoy#47743 (UDP hot-restart forwarding keyed by listener address +
# network namespace, aether#967; a644fc670e) and envoyproxy/envoy#47776
# (execInNetworkNamespace restores the calling thread's namespace, aether#1022;
# 7d6ca3273c). The snapshot also brings envoyproxy/envoy#47492 (a hot-restart
# successor inherits its listen sockets before entering the network namespace).
#   envoyproxy/envoy#47740 "quic: defer the upstream hostname check to explicit
#   SAN matchers" (67af4c692c + 01c09223bd; still open upstream): the QUIC client no
#   longer requires the server leaf's DNS SAN to match the SNI when an explicit
#   identity check (match_typed_subject_alt_names, pins, custom validator) is
#   configured and auto_sni_san_validation is off — the aether#957 root cause.
#   Behind envoy.reloadable_features.quic_hostname_check_deferred_to_explicit_san_match
#   (default true; the runtime_features.cc hunk registers it). Source + the
#   SPIFFE validator BUILD visibility line; api/ doc comment (a separate module),
#   tests and changelog dropped.
#   aether#1050 (proposed upstream as envoyproxy/envoy#47834, still open; this is
#   that pull request's diff at 72408727eb, docs and changelog dropped): the hot-restart
#   main-thread deadlock. The parent forwards undispatchable UDP/QUIC packets to
#   the child from its main thread with a BLOCKING sendmsg(); the child's main
#   thread waits for the parent's replies (stats merge every flush, listen socket
#   hand-offs) with a BLOCKING recvmsg() and reads no forwarded packets meanwhile.
#   Once the child's socket fills, both main threads wait on each other for good.
#   The patch makes parent forwarding a bounded non-blocking queue (retried on a
#   2ms timer, dropped when full or when the child is gone), makes the child keep
#   servicing forwarded packets while it waits for a reply, probe the parent for
#   liveness and give up after a bounded deadline, and gives the domain sockets
#   send/receive timeouts so no blocking call can hang. The parent counts what it
#   forwards in server.hot_restart_udp_forwarding_{datagrams,retries,dropped}.
#   Carries its tests (test/server:hot_restarting_{base,child,parent}_test,
#   hot_restart_impl_test), run by //bazel/patches:carried_patch_tests.
#   aether#1054 (not yet proposed upstream; the maintainer's call), applied AFTER
#   aether1050 (it builds on its liveness probe and touches the same child file):
#   (1) the hot-restart child keeps its inherited UDP listeners paused until the
#   parent has actually exited (its domain socket refuses a probe; 50 ms timer,
#   2 s cap) instead of unpausing them while asking the parent to terminate, which
#   had both processes reading the same sockets for the parent's shutdown and the
#   child stateless-resetting parent-owned QUIC packets; (2) an HTTP/3 connection
#   notified of a drain starts its own drain sequence (GOAWAY, then close) inside
#   the drain window even when idle, behind
#   envoy.reloadable_features.http3_drain_idle_connections (default true). Since
#   envoyproxy/envoy#47991 (in the pinned snapshot) the connection manager also
#   drains idle connections of every protocol on its own, but only in the last
#   third of the drain time and not at all when the drain time leaves no room
#   after the drain timeout -- the chart's 10s drain time with the default 5s
#   drain timeout arms nothing -- so (2) is still needed and is armed beside it
#   (ConnectionManagerImpl::armIdleHttp3DrainTimer); whichever fires first starts
#   the drain sequence. Carries its tests (test/server:hot_restarting_child_test,
#   test/common/http:conn_manager_impl_test), run by //bazel/patches:carried_patch_tests;
#   its quic_http_integration_test case only builds in the Envoy workspace.
#   aether#1054, second patch (not yet proposed upstream; the maintainer's call),
#   applied AFTER aether1054: a draining hot-restart parent (QUIC dispatcher not
#   accepting) forwarded EVERY packet without a live session to the child, before
#   quiche's own time-wait check, so packets for connections the parent had just
#   closed reached the child, which never knew them and answered with a stateless
#   reset. EnvoyQuicDispatcher::OnFailedToDispatchPacket now leaves connection IDs
#   in the time-wait list to the time-wait manager (which re-sends the stored
#   CONNECTION_CLOSE) and forwards only genuinely unknown ones. Behind
#   envoy.reloadable_features.quic_hot_restart_time_wait_before_forward (default
#   true). Parent-side, so it takes effect from the second roll on. Its test
#   (test/common/quic:envoy_quic_dispatcher_test) only builds in the Envoy workspace
#   (quiche test tooling), so it is not in //bazel/patches:carried_patch_tests.
#   aether#1054, third patch (an upstream bug; proposed as envoyproxy/envoy#47868,
#   still open), applied AFTER aether1054b: a paused hot-restart child UDP listener
#   (inherited socket,
#   read events disabled until the parent is gone) still READ the shared socket
#   whenever the QUIC listener injected a read activation to process handshakes
#   buffered from forwarded packets (injected activations bypass the enabled-event
#   mask); the packets it dequeued belonged to the parent's connections and the
#   child's dispatcher stateless-reset each one (the drain-start resets left after
#   #1064/#1066). UdpListenerImpl::handleReadCallback now runs onReadReady() and
#   returns without reading while paused. Child-side: effective from the first roll.
#   Carries its test (test/common/network:udp_listener_impl_test), run by
#   //bazel/patches:carried_patch_tests.
#   aether#1074 (an upstream bug; proposed as envoyproxy/envoy#47893, still open),
#   applied AFTER aether1054c: the persistent QUIC info (connection helper + clock,
#   alarm factory, QUIC config) was owned by the thread-local ClusterEntry while
#   HTTP/3 pools held it by reference and their connections by raw pointer; a CDS
#   removal destroys the entry after only DRAINING its pools, so a pool with live
#   streams outlived the info and the next write/alarm read the freed clock (the
#   SIGBUS in QuicConnection::CanWrite). PersistentQuicInfoPtr is now shared and each
#   HTTP/3 pool and connectivity grid holds a reference. Its test
#   (test/common/http/http3:conn_pool_test) needs quiche's test tooling, so it runs in
#   the Envoy workspace only, not in //bazel/patches:carried_patch_tests.
#   aether#1126 (an upstream bug in the #47743 forwarding; to be reported upstream on
#   the maintainer's word), applied AFTER aether1074: the hot-restart parent forwards
#   each undispatched UDP/QUIC datagram tagged with ITS worker index and the child
#   delivered it with UdpListenerWorkerRouterImpl::deliver(), which indexes its
#   per-worker table unchecked (an ASSERT only). A child with fewer workers than its
#   parent (proxy.concurrency lowered, 4 -> 2) read past the end of the table and
#   segfaulted. deliver() now maps an index this instance does not have onto
#   index % workers -- for a parent count that is a multiple of the child's, the
#   worker the child's own connection-ID routing (CID prefix % concurrency) picks.
#   Child-side: effective from the first roll. Carries its tests
#   (udp_listener_impl_test DeliverMapsAWorkerIndexItDoesNotHaveOntoItsOwnWorkers,
#   hot_restarting_child_test ForwardsPacketFromAParentWorkerTheChildDoesNotHave), run by
#   //bazel/patches:carried_patch_tests.
#   Drop each override when the pin moves past its merged PR.
single_version_override(
    module_name = "envoy",
    patch_strip = 1,
    patches = [
        "//bazel/patches:envoy-47740-quic-hostname-check-explicit-san.patch",
        "//bazel/patches:envoy-aether1050-hotrestart-nonblocking-forward.patch",
        "//bazel/patches:envoy-aether1054-hotrestart-terminate-wait-h3-goaway.patch",
        "//bazel/patches:envoy-aether1054b-quic-time-wait-before-forward.patch",
        "//bazel/patches:envoy-aether1054c-paused-udp-listener-no-read.patch",
        "//bazel/patches:envoy-aether1074-quic-persistent-info-lifetime.patch",
        "//bazel/patches:envoy-aether1126-forwarded-udp-worker-index.patch",
    ],
    version = "1.40.0-dev.20261009.189f198.envoy",
)

####################################################################################
# Direct deps of //:BUILD.bazel, //integration and //source/...
####################################################################################

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

# pkg_tar (//:envoy_tar).
bazel_dep(name = "rules_pkg", version = "1.3.0")

# sh_test (//integration:build_id_test, //integration:symtab_test).
bazel_dep(name = "rules_shell", version = "0.8.0")

# NO repo_name aliases. Envoy main renamed its apparent repos to @abseil-cpp /
# @protobuf, and the WORKSPACE-era @com_google_absl / @com_google_protobuf names
# cannot be kept here even though apparent names are per-module: .bazelrc's
# `--@protobuf//bazel/flags:prefer_prebuilt_protoc` resolves in the ROOT module's
# repo mapping, so an alias makes that flag unloadable. The labels in
# //source/extensions/filters/http/aether_stats/BUILD use the upstream names.
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "protobuf", version = "35.1.bcr.envoy")

####################################################################################
# Deps referenced only by build-setting flags in .bazelrc.
#
# A `--@foo//...` flag on the command line is resolved in the ROOT module's repo
# mapping, so every flag target below needs a direct bazel_dep here even though no
# BUILD file of ours mentions it. This is why the filter-cc template carries them.
# (googleurl and quiche left this list with the 726d7ac bump: upstream no longer
# wires them from .bazelrc, so nothing here names them.)
####################################################################################

bazel_dep(name = "proxy-wasm-cpp-host", version = "0.0.0-260704-f2db56a.envoy")
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_rust", version = "0.74.0.envoy")
bazel_dep(name = "toolchains_llvm", version = "1.9.1.envoy")

####################################################################################
# Packaging (replaces //bazel:repositories.bzl and //bazel/oci:images.bzl)
####################################################################################

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "container_structure_test", version = "1.22.1")

# The image-registry setting (proposal 040), for //:push and //:load: the root
# workspace's ONE file, bazel/registry/registry.bzl, a source-only module with
# no dependencies. The path leaves this workspace on purpose — the proxy image is
# published beside every other image, so it reads the same setting, not a copy.
bazel_dep(name = "aether_registry")
local_path_override(
    module_name = "aether_registry",
    path = "../bazel/registry",
)

####################################################################################
# Tests
####################################################################################

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

####################################################################################
# Toolchains
####################################################################################

# @clang_platform — the host platform --config=clang selects. arch_alias resolves
# it from the DRIVER host's arch, so an arm64 build needs an arm64 driver runner
# (see .bazelrc, --config=rbe-buildbuddy-arm64, and .github/workflows/proxy.yml).
envoy_toolchains_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_toolchains_extension")
use_repo(envoy_toolchains_ext, "clang_platform")

# rules_python only honours is_default from the ROOT module, so the default Python
# toolchain has to be declared here even though only @envoy's tooling uses it.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(
    python,
    "python_3_12",
    python = "python_versions",
)

####################################################################################
# Compiled-in Envoy extension set
####################################################################################

# //bazel/build_config is a local module (module(name = "envoy_build_config")) that
# Envoy's own BUILD files load extensions_build_config.bzl from. override_repo
# points Envoy's default @envoy_build_config at ours.
build_config = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

build_config(
    name = "aether_envoy_build_config",
    path = "bazel/build_config",
)

envoy_build_config_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_build_config_ext")

override_repo(
    envoy_build_config_ext,
    envoy_build_config = "aether_envoy_build_config",
)

####################################################################################
# Container base
####################################################################################

# distroless/cc ships libstdc++ + libgcc_s + glibc, which the Envoy binary needs at
# runtime (the upstream Envoy distroless image is built on distroless/base and lacks
# libgcc_s, so the binary's unwinder fails to load there). Pinned independently of
# the root MODULE.bazel, which bases the pure-Go images on distroless/static instead.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f",
    image = "gcr.io/distroless/cc-debian12",
    # The index lists arm64 as arm64/v8 (the variant must be matched exactly).
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "distroless_cc",
    # The per-platform repos the extension reports as direct deps; Bazel warns
    # (and may fail) without them. `bazel mod tidy` adds exactly these.
    "distroless_cc_linux_amd64",
    "distroless_cc_linux_arm64_v8",
)
